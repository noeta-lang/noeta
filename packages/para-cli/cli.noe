// `para.cli` — a CLI framework in pure Noeta where **the function signature is the spec**. A
// consumer annotates ordinary functions with `#[Command]`, and this package does the rest: it
// discovers those functions by whole-program reflection, parses the real `argv`, coerces each token
// to the parameter's declared type, dispatches the call by name, generates `--help`, and turns the
// command's return value into a process exit code.
//
// The whole thing rides three reflection primitives, and nothing else:
//
//   * `attributes_of::<Command>()` — every `#[Command]` in the *consumer's* program, materialized as
//     a real `Command` struct paired with the annotated function's name. Whole-program reflection is
//     closed-world, so this crosses the package boundary: `run()` lives here, the commands live in
//     the consumer, and the query still sees them.
//   * `params_of(name)`            — the selected command's signature: each parameter's name, declared
//     `type`, whether it is `optional` (has a default), and its own `#[Arg(...)]` metadata.
//   * `invoke(name, args)`         — call the command by name with a positional argument list built to
//     the arity the signature reports; a shorter list lets the callee fill trailing defaults.
//
// A consumer keys this package `para` in `[dependencies]` and imports the names it uses, e.g.
// `use para.cli.{Command, Arg, run}`. The attribute struct must be imported by name for `#[Command]`
// to resolve — importing the module alone is not enough. See `examples/para-cli/demo/`.
namespace para.cli

use std.io
use std.args
use std.env

// ---- Public surface -------------------------------------------------------

/// Marks a function (or method) as an invokable command. `about` is its one-line help summary.
/// `name` overrides the command name derived from the function name; it MAY contain spaces to
/// define a nested path (e.g. `#[Command(name: "remote add")]`), and command selection matches the
/// longest command-name token-prefix of `argv`.
@attribute(Function, Method)
pub struct Command {
    about: string = ""
    name: string = ""
}

/// Per-parameter metadata: `help` text for `--help`, optional `short`/`long` spellings that override
/// the defaults (a parameter's long spelling defaults to its name; it has no short by default), and
/// an `env` fallback — when the parameter is not supplied on the command line and `env` names a set
/// environment variable, that variable's value is used. Attach with `#[Arg(...)]` on the parameter.
@attribute(Param)
pub struct Arg {
    help: string = ""
    short: string = ""
    long: string = ""
    env: string = ""
}

/// Discover the program's `#[Command]` functions, parse the real `argv`, dispatch, and return the
/// process exit code. `run()` is `dispatch()` over the real argument vector with the program name
/// (argv[0]) dropped.
pub fn run(): int {
    all = args.all()
    return dispatch(all.slice(1, all.len()))
}

/// The testable core: dispatch a synthetic `argv` (already stripped of the program name) and return
/// the exit code. Exit codes: **0** success (or `--help`), **1** the command returned an error, **2**
/// a usage error (unknown command/option, missing required argument, bad coercion).
pub fn dispatch(argv: List<string>): int {
    cmds = commands()
    if cmds.len() == 0 {
        io.errln("error: no #[Command] functions found")
        return 2
    }
    single = cmds.len() == 1

    // Shell-completion generation is framework-level, spelled `--completions <shell>` so it can never
    // collide with a user command name. It prints a sourceable script to stdout and exits cleanly.
    if argv.len() > 0 && argv[0] == "--completions" {
        return run_completions(cmds, argv.slice(1, argv.len()))
    }

    // Top-level help: `--help`/`-h` as the first token, or (multi-command) an empty argv.
    if argv.len() > 0 && is_help(argv[0]) || !single && argv.len() == 0 {
        io.outln(top_help_text(cmds))
        return 0
    }

    // Select the command and the slice of tokens that belong to it.
    if single {
        // Single-command mode: no subcommand token — every argv token is this command's argument.
        return run_command(cmds[0].target, cmds[0].name, argv)
    }
    // Multi-command mode: the longest command-name token-prefix of `argv` selects the subcommand.
    return match select_command(cmds, argv) {
        Ok(sel) => run_command(sel.cmd.target, sel.cmd.name, sel.tokens),
        Err(msg) => selection_error(cmds, msg),
    }
}

// Report a command-selection failure: the message, then the top-level help, then exit code 2.
fn selection_error(cmds: List<Cmd>, msg: string): int {
    io.errln("error: ${msg}")
    io.errln(top_help_text(cmds))
    return 2
}

// ---- Command dispatch -----------------------------------------------------

/// Parse a single command's tokens against its signature, bind the arguments, and invoke it. `target`
/// is the reflection key (`params_of`/`invoke` take it); `display` is the command name shown in help
/// and usage, which for a nested command differs from `target` (the underlying function name).
fn run_command(target: string, display: string, tokens: List<string>): int {
    params = params_of(target)

    // `--help`/`-h` anywhere before a `--` prints this command's usage and exits cleanly.
    for t in tokens {
        if t == "--" {
            break
        }
        if is_help(t) {
            io.outln(command_help_text(display, params))
            return 0
        }
    }

    return match parse_tokens(tokens, params) {
        Ok(sources) => match bind_args(params, sources) {
            Ok(bound) => do_invoke(target, bound),
            Err(msg) => usage_error(display, params, msg),
        },
        Err(msg) => usage_error(display, params, msg),
    }
}

/// Invoke the command by name and translate its outcome to an exit code: an `int` return becomes the
/// exit code, any other return is success (0), and an `Err` from the command is a runtime failure (1).
fn do_invoke(name: string, bound: List<dyn>): int {
    return match invoke(name, bound) {
        Ok(v) => v.as<int>() ?? 0,
        Err(e) => runtime_error(e),
    }
}

fn runtime_error(e: string): int {
    io.errln("error: ${e}")
    return 1
}

fn usage_error(name: string, params: List<ParamInfo>, msg: string): int {
    io.errln("error: ${msg}")
    io.errln(command_usage_text(name, params))
    return 2
}

// ---- Token parsing --------------------------------------------------------

// Parse a command's tokens into a `param name -> raw string` map, ready for coercion. This is where
// every surface form is normalized: `--long value`, `--long=value`, `-s value`, `-s=value`, a bool
// `--flag` (presence) / `--flag=false` / `--no-flag`, a `--` option terminator, and bare positionals
// that fill the non-bool parameters in declaration order. An unknown option or a stray positional is
// a usage error.
fn parse_tokens(tokens: List<string>, params: List<ParamInfo>): Result<Map<string, string>, string> {
    // Resolution tables derived from the signature.
    mut long_to_name: Map<string, string> = {} // long spelling (no dashes) -> param name
    mut short_to_name: Map<string, string> = {} // short letter            -> param name
    mut bool_of: Map<string, bool> = {} // param name              -> is it a bool flag?
    mut positional_names: List<string> = [] // non-bool params, declaration order

    for p in params {
        // A struct-typed parameter (F5) is bound not as one positional but by expanding its FIELDS
        // into flags: `fn serve(opts: ServerOpts)` with `ServerOpts { port: int, host: string }` takes
        // `--port`/`--host`. Each field becomes a long flag (a bool field is a presence-flag); struct
        // fields are never positional. The field schema comes from the runtime `field_specs_of(name)`
        // — the type name is a runtime string off `Type.Struct(name, _)`, so the static turbofish form
        // could not be used here.
        match struct_type_name(p.type) {
            some(sname) => {
                for fs in field_specs_of(sname) {
                    long_to_name[fs.name] = fs.name
                    bool_of[fs.name] = is_bool_type(fs.type)
                }
            },
            none => {
                a = arg_of(p)
                long_key = match a {
                    some(x) => if x.long == "" then p.name else x.long,
                    none => p.name,
                }
                long_to_name[long_key] = p.name
                match a {
                    some(x) => {
                        if x.short != "" {
                            short_to_name[x.short] = p.name
                        }
                    },
                    none => {},
                }
                is_bool = is_bool_type(p.type)
                bool_of[p.name] = is_bool
                if !is_bool {
                    positional_names = positional_names ~ [p.name]
                }
            },
        }
    }

    mut sources: Map<string, string> = {}
    mut pos_index = 0
    mut opts_done = false
    mut i = 0
    while i < tokens.len() {
        t = tokens[i]
        if opts_done {
            match take_positional(positional_names, pos_index, t) {
                Ok(np) => {
                    sources[positional_names[pos_index]] = t
                    pos_index = np
                },
                Err(e) => {
                    return Err(e)
                },
            }
        } else if t == "--" {
            opts_done = true
        } else if t.starts_with("--") {
            match parse_long(t.slice(2, t.len()), tokens, i, long_to_name, bool_of) {
                Ok(step) => {
                    sources[step.name] = step.value
                    i = i + step.consumed
                },
                Err(e) => {
                    return Err(e)
                },
            }
        } else if t.starts_with("-") && t.len() > 1 {
            match parse_short(t.slice(1, t.len()), tokens, i, short_to_name, bool_of) {
                Ok(step) => {
                    sources[step.name] = step.value
                    i = i + step.consumed
                },
                Err(e) => {
                    return Err(e)
                },
            }
        } else {
            match take_positional(positional_names, pos_index, t) {
                Ok(np) => {
                    sources[positional_names[pos_index]] = t
                    pos_index = np
                },
                Err(e) => {
                    return Err(e)
                },
            }
        }
        i = i + 1
    }
    return Ok(sources)
}

// The result of parsing one option token: which parameter it bound, to what raw value, and how many
// EXTRA tokens it consumed (1 when it pulled a following value token, else 0).
struct Step {
    name: string
    value: string
    consumed: int
}

// `--long`, `--long=value`, `--long value`, and the `--no-flag` bool negation.
fn parse_long(
    raw: string,
    tokens: List<string>,
    i: int,
    long_to_name: Map<string, string>,
    bool_of: Map<string, bool>,
): Result<Step, string> {
    if raw.starts_with("no-") {
        flag = raw.slice(3, raw.len())
        return match long_to_name.get(flag) {
            some(pn) => if bool_of.get(pn) ?? false then Ok(Step { name: pn, value: "false", consumed: 0 }) else Err("'--${flag}' is not a boolean flag"),
            none => Err("unknown option '--${raw}'"),
        }
    }
    // `--key=value`
    match raw.index_of("=") {
        some(pos) => {
            key = raw.slice(0, pos)
            val = raw.slice(pos + 1, raw.len())
            return match long_to_name.get(key) {
                some(pn) => Ok(Step { name: pn, value: val, consumed: 0 }),
                none => Err("unknown option '--${key}'"),
            }
        },
        none => {},
    }
    // Bare `--key`: a bool flag is set by presence; anything else pulls the next token as its value.
    return match long_to_name.get(raw) {
        some(pn) => if bool_of.get(pn) ?? false then Ok(Step { name: pn, value: "true", consumed: 0 }) else if i + 1 < tokens.len() then Ok(Step { name: pn, value: tokens[i + 1], consumed: 1 }) else Err("option '--${raw}' needs a value"),
        none => Err("unknown option '--${raw}'"),
    }
}

// `-s`, `-s=value`, `-s value`.
fn parse_short(
    raw: string,
    tokens: List<string>,
    i: int,
    short_to_name: Map<string, string>,
    bool_of: Map<string, bool>,
): Result<Step, string> {
    match raw.index_of("=") {
        some(pos) => {
            key = raw.slice(0, pos)
            val = raw.slice(pos + 1, raw.len())
            return match short_to_name.get(key) {
                some(pn) => Ok(Step { name: pn, value: val, consumed: 0 }),
                none => Err("unknown option '-${key}'"),
            }
        },
        none => {},
    }
    return match short_to_name.get(raw) {
        some(pn) => if bool_of.get(pn) ?? false then Ok(Step { name: pn, value: "true", consumed: 0 }) else if i + 1 < tokens.len() then Ok(Step { name: pn, value: tokens[i + 1], consumed: 1 }) else Err("option '-${raw}' needs a value"),
        none => Err("unknown option '-${raw}'"),
    }
}

// Accept one bare positional token, returning the next positional slot index — or an error if every
// positional parameter is already filled.
fn take_positional(positional_names: List<string>, pos_index: int, t: string): Result<int, string> {
    if pos_index >= positional_names.len() {
        return Err("unexpected argument '${t}'")
    }
    return Ok(pos_index + 1)
}

// ---- Binding & coercion ---------------------------------------------------

// Walk the signature in order, source each parameter's raw string from the parsed map, and coerce it
// to the declared type. A required parameter with no source is a usage error. A *missing optional*
// parameter stops the build: the argument list is left short, and `invoke` lets the callee fill the
// trailing default (defaults are trailing-only, so once one optional is absent the rest are too).
fn bind_args(params: List<ParamInfo>, sources: Map<string, string>): Result<List<dyn>, string> {
    mut bound: List<dyn> = []
    for p in params {
        // A struct-typed parameter (F5) is built from its own `--field` flags and passed as one
        // argument. It always produces a value (missing optional fields fall to the struct's own
        // defaults via `construct`), so — unlike a missing optional scalar — it never short-circuits
        // the build.
        match struct_type_name(p.type) {
            some(sname) => {
                match build_struct_arg(sname, sources) {
                    Ok(v) => {
                        bound = bound ~ [v]
                    },
                    Err(e) => {
                        return Err(e)
                    },
                }
            },
            none => {
                match resolve_source(p, sources) {
                    some(raw) => {
                        match coerce(p.type, raw) {
                            Ok(v) => {
                                bound = bound ~ [v]
                            },
                            Err(e) => {
                                return Err(e)
                            },
                        }
                    },
                    none => {
                        if !p.optional {
                            return Err("missing required argument '${p.name}'")
                        }
                        return Ok(bound)
                    },
                    // A missing optional stops the build: leave the list short so the callee fills the
                    // trailing default (defaults are trailing-only, so the rest are optional too).
                }
            },
        }
    }
    return Ok(bound)
}

// Build a struct-typed argument (F5) from the parsed `--field` sources: coerce each supplied field to
// its declared type, require every non-defaulted field, and hand the collected `field -> value` map to
// `construct`, which fills the omitted (defaulted) fields — including a middle one, which a positional
// list could not express. The type name is a runtime string, so both `field_specs_of` and `construct`
// are used in their string-keyed (dynamic) form. Returns the built struct value, or a usage message.
fn build_struct_arg(sname: string, sources: Map<string, string>): Result<dyn, string> {
    mut fields: Map<string, dyn> = {}
    for fs in field_specs_of(sname) {
        match sources.get(fs.name) {
            some(raw) => {
                match coerce(fs.type, raw) {
                    Ok(v) => {
                        fields[fs.name] = v
                    },
                    Err(e) => {
                        return Err(e)
                    },
                }
            },
            none => {
                if !fs.optional {
                    return Err("missing required argument '--${fs.name}'")
                }
            },
        }
    }
    return construct(sname, fields)
}

// The struct/class type name a parameter is declared with, if its fields are to be expanded into
// flags (F5) — `some(name)` for a nominal type that has a field schema, `none` for everything else.
//
// `params_of` reports a declared nominal type *kind-agnostically* as `Type.Named(name, _)` — by
// design (its result doubles as the `x is T` narrow reference), so a struct parameter does NOT arrive
// as `Type.Struct`. So the nominal name is taken off `Type.Named` (and the precise-kind `Type.Struct`
// / `Type.Class`, should a future path surface those), then confirmed to be constructible by probing
// `field_specs_of(name)`: a struct or class has a non-empty field schema, while an enum, an unknown
// name, or a fieldless type has none and is left as an ordinary positional.
fn struct_type_name(t: Type): ?string {
    name = match t {
        Type.Named(n, _) => some(n),
        Type.Struct(n, _) => some(n),
        Type.Class(n, _) => some(n),
        _ => none,
    }
    return match name {
        some(n) => if field_specs_of(n).len() > 0 then some(n) else none,
        none => none,
    }
}

// Source a parameter's raw string. Precedence: an explicit argv token (positional/named/short) wins;
// otherwise, if the parameter carries `#[Arg(env: "NAME")]` and that environment variable is set, its
// value is used; otherwise the parameter has no source (a missing optional omits, a missing required
// errors — see `bind_args`).
fn resolve_source(p: ParamInfo, sources: Map<string, string>): ?string {
    match sources.get(p.name) {
        some(raw) => {
            return some(raw)
        },
        none => {},
    }
    match arg_of(p) {
        some(x) => {
            if x.env != "" {
                return env.get(x.env)
            }
        },
        none => {},
    }
    return none
}

// Coerce a raw token to a value of the declared type. Unknown/compound types pass the raw string
// through unchanged — the callee's own typing is the backstop.
fn coerce(t: Type, raw: string): Result<dyn, string> {
    return match t {
        Type.Int => match raw.to_int() {
            some(n) => Ok(n),
            none => Err("'${raw}' is not an integer"),
        },
        Type.Float => match raw.to_float() {
            some(f) => Ok(f),
            none => Err("'${raw}' is not a number"),
        },
        Type.Bool => match parse_bool(raw) {
            some(b) => Ok(b),
            none => Err("'${raw}' is not a boolean"),
        },
        _ => Ok(raw),
    }
}

// No `to_bool` in the stdlib, so the flag convention lives here: `true`/`1` and `false`/`0`. A bare
// flag's presence is normalized to `"true"` upstream, in the parser.
fn parse_bool(raw: string): ?bool {
    if raw == "true" || raw == "1" {
        return some(true)
    }
    if raw == "false" || raw == "0" {
        return some(false)
    }
    return none
}

// ---- Command discovery ----------------------------------------------------

// A discovered command, flattened out of the reflection view so the rest of the module never has to
// name `Attributed<Command>`. `target` is the reflection key (the function name) that `params_of`
// and `invoke` take; `name` is the selectable command name, which defaults to `target` but may be
// overridden by `#[Command(name: ...)]` and may contain spaces to define a nested path.
struct Cmd {
    target: string
    name: string
    about: string
}

fn commands(): List<Cmd> {
    mut out: List<Cmd> = []
    for c in attributes_of::<Command>() {
        selected = if c.value.name == "" then c.target else c.value.name
        out = out ~ [Cmd { target: c.target, name: selected, about: c.value.about }]
    }
    return out
}

// The tokens of a command name, split on spaces (a single-token name yields a one-element list).
fn name_tokens(name: string): List<string> {
    return name.split(" ")
}

// Is `prefix` a whole-token prefix of `argv`? Used for nested-command selection.
fn is_token_prefix(prefix: List<string>, argv: List<string>): bool {
    if prefix.len() > argv.len() {
        return false
    }
    mut i = 0
    while i < prefix.len() {
        if prefix[i] != argv[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// The result of command selection: which command, and the argv slice that is its own arguments.
struct Selected {
    cmd: Cmd
    tokens: List<string>
}

// Select the command whose name is the LONGEST whole-token prefix of `argv` (so `remote add …`
// picks `remote add` over a bare `remote`). Returns the match and the remaining argument tokens, or
// an error listing the valid continuations when no command name is a prefix of `argv`.
fn select_command(cmds: List<Cmd>, argv: List<string>): Result<Selected, string> {
    mut best = -1
    mut best_len = -1
    mut i = 0
    while i < cmds.len() {
        toks = name_tokens(cmds[i].name)
        if is_token_prefix(toks, argv) && toks.len() > best_len {
            best = i
            best_len = toks.len()
        }
        i = i + 1
    }
    if best < 0 {
        return Err(unknown_command_message(cmds, argv))
    }
    chosen = cmds[best]
    rest = argv.slice(best_len, argv.len())
    return Ok(Selected { cmd: chosen, tokens: rest })
}

// A helpful "unknown command" message: if `argv` starts down a valid nested path, list the concrete
// commands that continue it; otherwise fall back to naming the offending token.
fn unknown_command_message(cmds: List<Cmd>, argv: List<string>): string {
    if argv.len() == 0 {
        return "no command given"
    }
    // Commands whose name begins with the token(s) the user did type — the valid continuations.
    mut continuations: List<string> = []
    for c in cmds {
        toks = name_tokens(c.name)
        if toks.len() > argv.len() && is_token_prefix(argv, toks) {
            continuations = continuations ~ [c.name]
        }
    }
    if continuations.len() > 0 {
        typed = argv.join(" ")
        options = continuations.join(", ")
        return "incomplete command '${typed}'; did you mean: ${options}"
    }
    return "unknown command '${argv[0]}'"
}

// ---- Help text ------------------------------------------------------------

// Top-level help, grouped hierarchically: commands that share a first name-token (nested paths like
// `remote add`, `remote remove`) are listed under one group header, and standalone commands appear
// as flat lines. Section headers are bold on a terminal; command summaries are dimmed.
fn top_help_text(cmds: List<Cmd>): string {
    header = bold("Commands:")
    mut lines: List<string> = [header]

    // Distinct first tokens, in first-seen order — one per command group.
    mut groups: List<string> = []
    for c in cmds {
        g = name_tokens(c.name)[0]
        if !list_contains(groups, g) {
            groups = groups ~ [g]
        }
    }

    for g in groups {
        mut members: List<Cmd> = []
        for c in cmds {
            if name_tokens(c.name)[0] == g {
                members = members ~ [c]
            }
        }
        // A group of one standalone (single-token) command is a flat line; anything else prints a
        // group header (bold) and its member subcommands indented one level deeper, each shown by
        // its trailing sub-path. A group root — a command named exactly the group token — rides on
        // the header line with its own summary.
        if members.len() == 1 && name_tokens(members[0].name).len() == 1 {
            lines = lines ~ [command_line("  ", members[0].name, members[0].about)]
        } else {
            mut root_about = ""
            for m in members {
                if m.name == g {
                    root_about = m.about
                }
            }
            lines = lines ~ [command_line("  ", bold(g), root_about)]
            for m in members {
                if m.name != g {
                    lines = lines ~ [command_line("    ", sub_path(m.name), m.about)]
                }
            }
        }
    }
    return lines.join("\n")
}

// The tokens of a nested command name after its leading group token, rejoined (e.g. `remote add` ->
// `add`). A single-token name yields the empty string.
fn sub_path(name: string): string {
    toks = name_tokens(name)
    mut rest: List<string> = []
    mut i = 1
    while i < toks.len() {
        rest = rest ~ [toks[i]]
        i = i + 1
    }
    return rest.join(" ")
}

// One command row: the (indented) command name, and its dimmed `about` summary when present.
fn command_line(indent: string, name: string, about: string): string {
    return if about == "" then indent ~ name else indent ~ name ~ "    " ~ dim(about)
}

// A single brief usage line, e.g. `usage: greet <name> [--loud]`.
fn command_usage_text(name: string, params: List<ParamInfo>): string {
    lead = bold("usage:")
    mut parts: List<string> = ["${lead} ${name}"]
    for p in params {
        if is_bool_type(p.type) {
            parts = parts ~ [if p.optional then "[--${p.name}]" else "--${p.name}"]
        } else {
            parts = parts ~ [if p.optional then "[${p.name}]" else "<${p.name}>"]
        }
    }
    return parts.join(" ")
}

// The full per-command help: the usage line plus one detail line per parameter, showing its type, a
// short spelling if it has one, whether it is optional, its `#[Arg(env)]` fallback, and its
// `#[Arg(help)]` text. Types and annotations are dimmed on a terminal.
fn command_help_text(name: string, params: List<ParamInfo>): string {
    mut lines: List<string> = [command_usage_text(name, params)]
    if params.len() > 0 {
        lines = lines ~ ["", bold("Arguments:")]
        for p in params {
            a = arg_of(p)
            help = match a {
                some(x) => x.help,
                none => "",
            }
            short = match a {
                some(x) => x.short,
                none => "",
            }
            envvar = match a {
                some(x) => x.env,
                none => "",
            }
            mut label = "  ${p.name}: ${dim(type_name(p.type))}"
            if short != "" {
                label = label ~ " " ~ dim("(-${short})")
            }
            if p.optional {
                label = label ~ " " ~ dim("[optional]")
            }
            if envvar != "" {
                label = label ~ " " ~ dim("[env: ${envvar}]")
            }
            if help != "" {
                label = label ~ " - ${help}"
            }
            lines = lines ~ [label]
        }
    }
    return lines.join("\n")
}

// ---- Shell completion -----------------------------------------------------

// `--completions <shell>` prints a sourceable completion script for bash, zsh, or fish to stdout and
// exits 0. It is spelled as a framework flag (not a `completions` subcommand) so it can never shadow
// a user command name. The script completes the program's command-name tokens (nested paths
// included) and every command's flag names (`--long`/`-short`), all derived from the command model
// and `params_of` — pure string generation, no user code is invoked.
fn run_completions(cmds: List<Cmd>, rest: List<string>): int {
    if rest.len() != 1 {
        io.errln("error: usage: --completions <bash|zsh|fish>")
        return 2
    }
    shell = rest[0]
    if shell != "bash" && shell != "zsh" && shell != "fish" {
        io.errln("error: unknown shell '${shell}' (expected bash, zsh, or fish)")
        return 2
    }
    prog = program_name()
    script = match shell {
        "bash" => bash_completions(prog, cmds),
        "zsh" => zsh_completions(prog, cmds),
        _ => fish_completions(prog, cmds),
    }
    io.outln(script)
    return 0
}

// The flat completion vocabulary shared by the bash/zsh scripts: every distinct command-name token
// followed by every distinct flag spelling.
fn completion_words(cmds: List<Cmd>): List<string> {
    mut words: List<string> = []
    for t in command_tokens(cmds) {
        words = push_unique(words, t)
    }
    for f in all_flags(cmds) {
        words = push_unique(words, f)
    }
    return words
}

// Every distinct token across all command names (so a nested path like `remote add` contributes both
// `remote` and `add`).
fn command_tokens(cmds: List<Cmd>): List<string> {
    mut out: List<string> = []
    for c in cmds {
        for t in name_tokens(c.name) {
            out = push_unique(out, t)
        }
    }
    return out
}

// Every distinct flag spelling (`--long` and `-short`) across all commands' parameters.
fn all_flags(cmds: List<Cmd>): List<string> {
    mut out: List<string> = []
    for c in cmds {
        for p in params_of(c.target) {
            out = push_unique(out, long_flag(p))
            match short_flag(p) {
                some(s) => {
                    out = push_unique(out, s)
                },
                none => {},
            }
        }
    }
    return out
}

// A parameter's long flag spelling, `--name` (or `--<override>` when `#[Arg(long: ...)]` is set).
fn long_flag(p: ParamInfo): string {
    long = match arg_of(p) {
        some(x) => if x.long == "" then p.name else x.long,
        none => p.name,
    }
    return "--${long}"
}

// A parameter's short flag spelling `-s`, if it declared one.
fn short_flag(p: ParamInfo): ?string {
    match arg_of(p) {
        some(x) => {
            if x.short != "" {
                return some("-${x.short}")
            }
        },
        none => {},
    }
    return none
}

fn bash_completions(prog: string, cmds: List<Cmd>): string {
    words = completion_words(cmds).join(" ")
    fnname = "_${prog}_complete"
    mut lines: List<string> = []
    lines = lines ~ ["${fnname}() {"]
    lines = lines ~ ["    local cur=\"\${COMP_WORDS[COMP_CWORD]}\""]
    lines = lines ~ ["    local words=\"${words}\""]
    lines = lines ~ ["    COMPREPLY=( $(compgen -W \"\${words}\" -- \"\${cur}\") )"]
    lines = lines ~ ["}"]
    lines = lines ~ ["complete -F ${fnname} ${prog}"]
    return lines.join("\n")
}

fn zsh_completions(prog: string, cmds: List<Cmd>): string {
    words = completion_words(cmds).join(" ")
    fnname = "_${prog}"
    mut lines: List<string> = []
    lines = lines ~ ["#compdef ${prog}"]
    lines = lines ~ ["${fnname}() {"]
    lines = lines ~ ["    compadd -- ${words}"]
    lines = lines ~ ["}"]
    lines = lines ~ ["${fnname} \"$@\""]
    return lines.join("\n")
}

fn fish_completions(prog: string, cmds: List<Cmd>): string {
    tokens = command_tokens(cmds).join(" ")
    mut lines: List<string> = []
    lines = lines ~ ["complete -c ${prog} -f -a \"${tokens}\""]
    for c in cmds {
        for p in params_of(c.target) {
            long = match arg_of(p) {
                some(x) => if x.long == "" then p.name else x.long,
                none => p.name,
            }
            lines = lines ~ ["complete -c ${prog} -l ${long}"]
            match short_flag(p) {
                some(s) => {
                    letter = s.slice(1, s.len())
                    lines = lines ~ ["complete -c ${prog} -s ${letter}"]
                },
                none => {},
            }
        }
    }
    return lines.join("\n")
}

// The program's own name for the generated script: the basename of `argv[0]`, or `prog` when unknown
// (e.g. under `dispatch` in tests, where the name is irrelevant to the exit code).
fn program_name(): string {
    all = args.all()
    if all.len() == 0 {
        return "prog"
    }
    parts = all[0].split("/")
    base = parts[parts.len() - 1]
    return if base == "" then "prog" else base
}

// ---- Small helpers --------------------------------------------------------

fn is_help(t: string): bool {
    return t == "--help" || t == "-h"
}

fn list_contains(xs: List<string>, x: string): bool {
    for e in xs {
        if e == x {
            return true
        }
    }
    return false
}

fn push_unique(xs: List<string>, x: string): List<string> {
    return if list_contains(xs, x) then xs else xs ~ [x]
}

// ---- ANSI styling ---------------------------------------------------------
//
// `--help`/usage output is colorized only when stdout is a terminal (`io.is_tty()`); piped output is
// plain, so a captured help text carries no escape codes and diffs stay readable. Every sequence is
// built from the single escape byte in `esc()`, so color is one toggle.
fn esc(): string {
    return "\u{1b}"
}

fn styled(): bool {
    return io.is_tty()
}

// A bold section header on a terminal; the plain string otherwise.
fn bold(s: string): string {
    return if styled() then "${esc()}[1m${s}${esc()}[0m" else s
}

// Dimmed detail — types, defaults, `[optional]`/`[env: …]` annotations — on a terminal; plain otherwise.
fn dim(s: string): string {
    return if styled() then "${esc()}[2m${s}${esc()}[0m" else s
}

fn is_bool_type(t: Type): bool {
    return match t {
        Type.Bool => true,
        _ => false,
    }
}

fn type_name(t: Type): string {
    return match t {
        Type.Int => "int",
        Type.Float => "float",
        Type.Bool => "bool",
        Type.String => "string",
        _ => "value",
    }
}

// The `#[Arg]` on a parameter, if any — narrowed off the heterogeneous `attrs` list.
fn arg_of(p: ParamInfo): ?Arg {
    for a in p.attrs {
        if a is Arg {
            return some(a)
        }
    }
    return none
}
