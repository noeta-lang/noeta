// para.aether — a first-party web framework for Noeta.
//
// Controllers are classes whose methods are tagged `#[Get("/path")]` / `#[Post("/path")]`. The `App`
// autodiscovers those routes by reflection (`attributes_of`), and for each request it reflects the
// handler's parameters (`params_of`) and INJECTS each one by its declared type — a request body
// materialized into a typed struct (`json.decode_typed`, backed by `@derive(Deserialize<Json>)`) —
// then dispatches by name (`invoke`). Laravel-style method injection, zero per-handler glue.
//
// This module is the routing + dependency-injection core. Middleware, service providers, the config
// registry, and the background-task scope layer on top of it.

namespace para.aether

use std.http.server
use std.http.{Request, Response}
use std.json
use std.session
use std.session.{Session, Keyring}
use std.task.sleep

// --- Route attributes: users tag controller methods with these. -------------------------------

@attribute(Method)
pub struct Get {
    path: string
}

@attribute(Method)
pub struct Post {
    path: string
}

// --- A resolved route in the table. -----------------------------------------------------------

struct Route {
    method: string // "GET" / "POST"
    path: string // "/users"
    controller: string // "UsersController"
    action: string // "create"
}

// The controller + action a `"Controller.action"` target names.
fn split_target(target: string): Route {
    parts = target.split(".")
    controller = if parts.len() > 0 then parts[0] else ""
    action = if parts.len() > 1 then parts[1] else ""
    return Route { method: "", path: "", controller: controller, action: action }
}

// --- Route path matching (with `{param}` capture). ---------------------------------------------

// Match a route pattern (`/users/{id}`) against a concrete request path (`/users/7`): `none` if it
// does not match, else `some(id)` where `id` is the captured `{…}` segment (the empty string for a
// pattern with no parameter). A single positional capture is enough for route-model binding; richer
// capture (named params, multiple) is a later slice.
fn path_match(pattern: string, path: string): ?string {
    pp = pattern.split("/")
    ap = path.split("/")
    if pp.len() != ap.len() {
        return none
    }
    mut id = ""
    mut i = 0
    for seg in pp {
        actual = ap[i]
        if seg.starts_with("{") {
            id = actual
        } else {
            if seg != actual {
                return none
            }
        }
        i = i + 1
    }
    return some(id)
}

// --- Background task scope & scheduler. --------------------------------------------------------
//
// The serve loop drives sibling `spawn`ed tasks (its accept loop calls `advance_tasks` each round),
// so a `concurrent { spawn work(rx); spawn every(...); serve(port, app.route) }` nursery runs the
// server, a background-job worker, and scheduled tasks together on one heap — no async-serve
// primitive needed. A handler "fires and forgets" by enqueuing a thunk onto the job channel and
// returning immediately; the worker runs it off the request path.

fn noop(): void {}

// The background worker: drain the job queue, running each enqueued thunk. Spawn one per app.
pub async fn work(rx: Receiver<() -> void>): void {
    mut going = true
    while going {
        job = rx.recv().await
        if job == none {
            going = false
        } else {
            f = job ?? noop
            f()
        }
    }
}

// Enqueue a fire-and-forget background job — the handler returns without waiting for it to run.
pub async fn background(tx: Sender<() -> void>, job: () -> void): void {
    tx.send(job).await
}

// A scheduled task: run `action` every `ms` milliseconds, forever. Spawn one per schedule.
pub async fn every(ms: int, action: () -> void): void {
    mut running = true
    while running {
        sleep(ms).await
        action()
    }
}

// --- Middleware (the onion). -------------------------------------------------------------------
//
// A middleware is a LAYER of an onion, not a before/after hook pair: `handle` receives the request
// AND `next` — the rest of the pipeline, with the routed handler at the bottom. So a layer may
// rewrite the request before continuing (`next.run(rewritten)`), inspect or replace the response on
// the way out, or answer WITHOUT ever calling `next` — an auth reject, a cache hit, a CORS preflight.
// A before/after pair cannot express "answer without dispatching", which is exactly what a
// short-circuit is; this is the same shape para/api's client-side onion uses, bottoming out in the
// app's `serve_request` rather than a client's `send`. Middlewares are `dyn Middleware` (L1),
// dispatched dynamically on their concrete type.
pub trait Middleware {
    fn handle(req: Request, next: Next): Response
}

// The rest of the pipeline, as a value. `next.run(req)` continues inward; the innermost `run` bottoms
// out in the app's `serve_request`, where the route is dispatched and the unit-of-work flushed.
//
// A cursor (stack + index), not a closure captured per layer: the stack is shared by every `Next` in
// a pipeline and only the index advances, so entering a layer allocates one small struct rather than
// capturing an environment.
pub struct Next {
    stack: List<dyn Middleware>
    index: int
    app: App

    // Continue inward. Calling this is what makes a layer transparent; NOT calling it is what makes a
    // layer answer on its own (an auth reject, a cache hit, a short-circuit reply).
    fn run(req: Request): Response {
        if self.index >= self.stack.len() {
            return self.app.serve_request(req)
        }
        rest = Next { stack: self.stack, index: self.index + 1, app: self.app }
        return self.stack[self.index].handle(req, rest)
    }
}

// Inject the live request for a handler's `Request` parameter. It is absent on the string-testable
// path (`dispatch_request` threads `none`): a handler that reads the request — a header, a cookie —
// is exercised through `serve`, where the real request exists. Panicking rather than fabricating an
// empty request keeps the string path honest about what it can and cannot cover.
fn request_arg(req: ?Request): dyn {
    return match req {
        some(r) => r,
        none => panic("400 a `Request` parameter is only available on the server path, not the string-testable `dispatch_request`"),
    }
}

// The container key for an interface: a trait's SHORT name. A `dyn Trait` parameter reflects
// (`params_of`) with its trait name FULLY QUALIFIED — a `dyn SessionStore` in an app that imported it
// reflects as `DynTrait("para.aether.SessionStore")`, a `dyn Clock` on an app-local trait as
// `DynTrait("Clock")` — so injection and registration meet on the last dotted segment. Keying on the
// short name means a service is `bind`'d and injected by the same spelling the author writes at the
// `dyn` site (`SessionStore`), not a fully-qualified path they would have to know to reproduce.
fn short_iface(name: string): string {
    parts = name.split(".")
    return if parts.len() > 0 then parts[parts.len() - 1] else name
}

// Coerce a handler's return value into a `Response`. A handler may return a `Response` verbatim — its
// status and headers survive to the reply — or a bare `string`, which becomes a `200 text/plain`
// body. The runtime value is inspected (`as<Response>`) rather than the handler's declared return, so
// a method typed `Response`, `string`, or `dyn` all resolve at the one point the value exists.
fn coerce_response(result: dyn): Response {
    return match result.as<Response>() {
        some(resp) => resp,
        none => server.response(200, result.as<string>() ?? "200 OK", {"content-type": "text/plain"}),
    }
}

// --- Configuration registry. ------------------------------------------------------------------
//
// An app-wide key/value store (`std.cell`-style shared state via the class's reference identity):
// service providers write it during setup, handlers read it. Values are strings — the caller parses
// richer shapes (a port to `int`, a JSON blob via `json.decode`).

pub class Config {
    mut values: Map<string, string>

    fn new(): Config {
        return Config { values: {} }
    }

    fn set(key: string, value: string): void {
        self.values = self.values.set(key, value)
    }

    fn get(key: string, fallback: string): string {
        return self.values.get_or(key, fallback)
    }

    fn has(key: string): bool {
        return self.values.has(key)
    }
}

// --- The data store seam (route-model binding + unit-of-work). ---------------------------------
//
// aether is deliberately database-agnostic: it depends on this `Store` interface, NOT on any concrete
// driver. An app backs it with whatever it likes — `para.db` over SQLite, an in-memory fake in tests,
// a remote service — and wires the implementation in with `app.set_store(...)`. This is the seam the
// dependency-injection layer uses for the two Laravel-style features:
//   - **route-model binding**: a handler parameter whose type is a `bind_model`'d model is loaded by
//     the route's `{id}` via `Store.load(model, id)` and injected, instead of decoded from the body.
//   - **unit-of-work**: a handler stages writes with `Store.stage(...)` during the request; aether
//     calls `Store.flush()` once, after the response is produced, so a request's writes commit as one
//     batch (the repository/unit-of-work pattern, kept off the hot path).

pub trait Store {
    // Load a bound model instance of type `model` by its route id (route-model binding).
    fn load(model: string, id: string): dyn
    // Stage a write (`data` is JSON) into the request's unit-of-work; committed on `flush`.
    fn stage(model: string, data: string): void
    // Commit every staged write — called once by aether at end-of-request.
    fn flush(): void
}

// The store an app gets before it configures one: a no-op unit-of-work. `flush`/`stage` do nothing;
// `load` refuses (a route bound a model but no store was wired to load it from). So aether always has
// a `Store` to call — no per-request `none`-checks on the hot path.
class NullStore {
    fn new(): NullStore {
        return NullStore {}
    }
}

impl Store for NullStore {
    fn load(model: string, id: string): dyn {
        return panic("no store configured — call `app.set_store(...)` to load model ${model}")
    }

    fn stage(model: string, data: string): void {}

    fn flush(): void {}
}

// --- The session-store seam. -------------------------------------------------------------------
//
// aether offers sessions behind ONE interface, so a handler reads and writes a session the same way
// regardless of where the state actually lives:
//   - the **stateless** default (`CookieSessions`) carries the whole session in a signed, HMAC'd
//     cookie via `std.session` — no server state, nothing to configure, and correct under
//     `serve --parallel` (every worker reads a cookie none of them had to write, where an in-memory
//     map would silently fragment).
//   - a **stored** upgrade keeps only a small session id in the cookie and the data server-side, for
//     sessions too large for a browser's ~4 KB cookie or that must be revocable. Per the
//     http-sessions design that impl belongs in **para/db** — it owns the connection and the
//     migrations — and aether reaches it through the `para` scope, not a hard dependency.
//
// A handler obtains its session with `store.open(req)` and persists it with `store.attach(resp, s)`.
// `Session` is `std.session`'s own type, so the two backends are interchangeable at the call site: a
// handler written against `CookieSessions` moves to the stored backend without a line changing.
pub trait SessionStore {
    // The session carried by this request — an empty one when the request has no valid session (the
    // caller has the same correct response to "absent", "forged", and "expired").
    fn open(req: Request): Session
    // Persist `session` onto `resp` and return the reply to send: a `Set-Cookie` for the stateless
    // default, a row write plus a small id cookie for a stored backend. An unchanged session costs
    // no header, so calling this unconditionally is safe.
    fn attach(resp: Response, session: Session): Response
}

// The stateless default: the whole session rides in a signed cookie (`std.session`). Wire it once and
// hand it to handlers. `secure` should be true behind https — it makes the cookie https-only; leave
// it false only for a plain-http localhost. `max_age` (seconds) bounds a stolen token's lifetime,
// which matters precisely because a stateless session has nothing to revoke against.
pub class CookieSessions {
    keys: Keyring
    max_age: int
    secure: bool

    fn new(keys: Keyring, max_age: int, secure: bool): CookieSessions {
        return CookieSessions { keys: keys, max_age: max_age, secure: secure }
    }

    impl SessionStore {
        fn open(req: Request): Session {
            return session.open(req, self.keys)
        }

        fn attach(resp: Response, s: Session): Response {
            return session.attach(resp, s, self.keys, self.max_age, self.secure)
        }
    }
}

// --- Service providers. -----------------------------------------------------------------------
//
// A service provider modularizes application setup: its `register(app)` wires controllers, config,
// and middleware into the app. Registering a provider runs its `register` immediately (Laravel's
// deferred `boot` phase awaits trait default methods — UT5). Providers are `dyn ServiceProvider`
// (L1), so an app composes features by registering a list of them.

pub trait ServiceProvider {
    fn register(app: App): void
}

// --- The application. -------------------------------------------------------------------------

pub class App {
    mut routes: List<Route>
    mut controllers: Map<string, dyn>
    mut middleware: List<dyn Middleware>
    mut bound: List<string> // model type names that are route-bound (loaded from the store by id)
    mut store: dyn Store // the data-store seam (a NullStore until an app configures one)
    mut services: Map<string, dyn> // the service container: concrete instances keyed by interface (short trait name)
    config: Config

    fn new(): App {
        store = NullStore.new()
        app = App { routes: [], controllers: {}, middleware: [], bound: [], store: store, services: {}, config: Config.new() }
        // The data `Store` is a service like any other — registered under `Store` so a `dyn Store`
        // parameter resolves through the same container. `set_store` keeps this entry in step with the
        // typed `store` field the flush/route-model path calls through.
        app.bind("Store", store)
        return app
    }

    // Wire in the data store an app's models load/persist through (its `para.db`-backed impl, a test
    // fake, …). Injected handler parameters and the end-of-request flush dispatch through it.
    fn set_store(s: dyn Store): void {
        self.store = s
        // Keep the container's `Store` entry pointing at the live store, so `dyn Store` injection and
        // the `store` field the flush/route-model path uses never diverge.
        self.bind("Store", s)
    }

    // Register a concrete service instance under the interface a `dyn <name>` parameter resolves by.
    // `name` is the interface's SHORT trait name (`"Store"`, `"SessionStore"`, `"Clock"`) — the same
    // last segment `arg_for` normalizes a reflected `dyn Trait` to, so a service registered here is the
    // one injected there. Providers call this during setup; re-binding a name replaces the service.
    fn bind(name: string, service: dyn): void {
        self.services = self.services.set(name, service)
    }

    // Mark a model type as **route-bound**: a handler parameter of this type is loaded from the store
    // by the route's `{id}` (Laravel implicit binding), instead of being decoded from the request body.
    fn bind_model(name: string): void {
        self.bound = self.bound ~ [name]
    }

    // Whether `name` names a route-bound model.
    fn is_bound(name: string): bool {
        for b in self.bound {
            if b == name {
                return true
            }
        }
        return false
    }

    // Run a service provider's setup against this app (register controllers, config, middleware).
    fn provider(p: dyn ServiceProvider): void {
        p.register(self)
    }

    // Set an app configuration value (providers write it during setup).
    fn configure(key: string, value: string): void {
        self.config.set(key, value)
    }

    // Read an app configuration value, or `fallback` if unset.
    fn setting(key: string, fallback: string): string {
        return self.config.get(key, fallback)
    }

    // Add a middleware to the pipeline (run in registration order before every handler).
    fn use_middleware(mw: dyn Middleware): void {
        self.middleware = self.middleware ~ [mw]
    }

    // Register a controller instance under its type name (the leading segment of its route targets).
    fn register(name: string, controller: dyn): void {
        self.controllers = self.controllers.set(name, controller)
    }

    // Build the route table from every `#[Get]` / `#[Post]` in the program.
    fn discover(): void {
        mut table: List<Route> = self.routes
        for a in attributes_of::<Get>() {
            t = split_target(a.target)
            table = table ~ [Route { method: "GET", path: a.value.path, controller: t.controller, action: t.action }]
        }
        for a in attributes_of::<Post>() {
            t = split_target(a.target)
            table = table ~ [Route { method: "POST", path: a.value.path, controller: t.controller, action: t.action }]
        }
        self.routes = table
    }

    // The string-testable entry point: resolve + dispatch, then hand back the response *body* as a
    // plain string. It exists so an app can drive its whole DI + route-model-binding path with no
    // server (`app.handle("POST", "/users", body)`); the reply's status and headers are the server
    // path's concern (`serve_request`), so extracting `.body()` here is exactly the projection that
    // keeps this call byte-for-byte what it always returned — including "404 Not Found" and the
    // "500 …" strings, which are now the bodies of a 404/500 `Response`. No live request to inject,
    // so a handler that declares a `Request` parameter is exercised through `serve`, not this call.
    fn handle(method: string, path: string, body: string): string {
        return self.resolve(method, path, body, none).body()
    }

    // The route-matching core shared by the string path (`handle`, an absent request) and the server
    // path (`serve_request`, the live request). A matched route dispatches with the optional request
    // in scope, so a handler parameter typed `Request` can be injected when one is available. Returns
    // a full `Response` — status and headers included — so the server path carries them verbatim and
    // the string path projects out the body.
    fn resolve(method: string, path: string, body: string, req: ?Request): Response {
        for r in self.routes {
            if r.method == method {
                m = path_match(r.path, path)
                if m != none {
                    id = m ?? ""
                    return self.dispatch(r, id, body, req)
                }
            }
        }
        return server.response(404, "404 Not Found")
    }

    // Dispatch a matched route: look up its controller instance and invoke the action with the
    // captured route id in scope (for route-model binding) and the optional live request (for DI).
    fn dispatch(r: Route, id: string, body: string, req: ?Request): Response {
        if self.controllers.has(r.controller) {
            return self.invoke_action(self.controllers[r.controller], r, id, body, req)
        }
        return server.response(500, "500 no controller ${r.controller}")
    }

    // Invoke a controller action with its injected arguments and coerce the result into a `Response`:
    // a handler may return a `Response` verbatim (status + headers survive) or a bare `string`
    // (a `200 text/plain` reply). An invocation error is a `500` whose body is the error — the same
    // "500 …" string `handle` used to return, now carried as a response body.
    fn invoke_action(ctrl: dyn, r: Route, id: string, body: string, req: ?Request): Response {
        target = "${r.controller}.${r.action}"
        // A parameter that cannot be injected (an unregistered `dyn` service) fails the build into a
        // `500` Response — an actionable error carried the same way an invocation error is, rather than
        // a panic off the request path or the wrong service silently injected.
        return match self.build_args(target, id, body, req) {
            Ok(args) => match invoke(ctrl, r.action, args) {
                Ok(result) => coerce_response(result),
                Err(e) => server.response(500, "500 ${e}"),
            },
            Err(resp) => resp,
        }
    }

    // Build the handler's argument list by reflecting its parameters (`params_of`) and injecting each
    // one by its declared type — a for-loop, not `.map`, because the injection reads `self` and any one
    // parameter may fail the whole build (an unregistered service) into a `500` short-circuit.
    fn build_args(target: string, id: string, body: string, req: ?Request): Result<List<dyn>, Response> {
        mut args: List<dyn> = []
        for p in params_of(target) {
            match self.arg_for(p, id, body, req) {
                Ok(a) => { args = args ~ [a] },
                Err(resp) => { return Err(resp) },
            }
        }
        return Ok(args)
    }

    // Inject one parameter by its reflected type:
    //   - `dyn Trait`  → the service registered for that interface (service injection by interface),
    //   - `Request`    → the live HTTP request (server path only; see `request_arg`),
    //   - a nominal type → route-model binding (if `bind_model`'d) else request-body decode.
    //
    // `Request` reflects as `Named("Request", [])` — the extern type's short name — so it is caught
    // inside the `Named` arm ahead of the body-decode fallback that would otherwise swallow it into a
    // JSON panic. A user body struct must not be named `Request`, which is the extern type's name.
    // Returns a `Result` so an unresolvable `dyn` service becomes a `500` the caller renders, not a
    // panic — the only injection outcome that is a *configuration* error rather than a client error.
    fn arg_for(p: ParamInfo, id: string, body: string, req: ?Request): Result<dyn, Response> {
        return match p.type {
            DynTrait(n) => self.resolve_service(n),
            Struct(n, _) => Ok(self.materialize(n, id, body)),
            Class(n, _) => Ok(self.materialize(n, id, body)),
            Named(n, _) => if n == "Request" then Ok(request_arg(req)) else Ok(self.materialize(n, id, body)),
            _ => Err(server.response(500, "500 cannot inject a parameter of this type")),
        }
    }

    // Resolve a `dyn Trait` parameter to the service registered for its interface. The reflected trait
    // name is fully qualified; the container keys on the short name (`short_iface`), so a `dyn Store` /
    // `dyn SessionStore` / `dyn Clock` finds the instance `bind`'d under `"Store"` / `"SessionStore"` /
    // `"Clock"`. An interface with no registered service is a configuration error, not a client one:
    // a `500` naming the interface and how to provide it — never the wrong service silently injected.
    fn resolve_service(name: string): Result<dyn, Response> {
        key = short_iface(name)
        if self.services.has(key) {
            return Ok(self.services[key])
        }
        return Err(server.response(500, "500 no service registered for `dyn ${key}` — bind one during setup with `app.bind(\"${key}\", <instance>)` (or `app.set_store(...)` for the data `Store`)"))
    }

    // A nominal parameter is either a route-bound model (loaded from the store by the route id) or a
    // request body materialized into a typed struct via `@derive(Deserialize<Json>)`.
    fn materialize(name: string, id: string, body: string): dyn {
        if self.is_bound(name) {
            return self.store.load(name, id)
        }
        return match json.decode_typed(name, body) {
            Ok(v) => v,
            Err(e) => panic("400 ${e}"),
        }
    }

    // The HTTP adapter: enter the middleware onion at its outermost layer. Each layer may rewrite the
    // request, inspect or replace the response, or short-circuit; `Next.run` bottoms out in
    // `serve_request`, which dispatches the route and flushes the unit-of-work. The first middleware
    // registered is the outermost — it sees the request first and the response last.
    fn route(req: Request): Response {
        return Next { stack: self.middleware, index: 0, app: self }.run(req)
    }

    // The string-testable request cycle: dispatch to the routed handler, then commit the request's
    // unit-of-work (a no-op if nothing was staged). The same sequence `serve_request` runs for a live
    // HTTP request, without the `Request`/`Response` wrappers — so an app can test its whole DI +
    // route-model-binding + flush path with plain string calls (no server, no sockets).
    fn dispatch_request(method: string, path: string, body: string): string {
        out = self.handle(method, path, body)
        self.store.flush()
        return out
    }

    // Dispatch one live HTTP request to its handler, then commit the unit-of-work. Unlike the
    // string-testable `dispatch_request`, this threads the live `Request` down to `arg_for` (so a
    // `Request` parameter is injected with the real one) AND returns the handler's `Response`
    // verbatim — its status and headers reach the client, where `dispatch_request` projected only the
    // body to a string. The route → flush sequence is otherwise identical, so the string path stays a
    // faithful rehearsal of the server path. It is the onion's terminal — `Next.run` calls it once
    // the pipeline is exhausted.
    fn serve_request(req: Request): Response {
        resp = self.resolve(req.method(), req.path(), req.body(), some(req))
        self.store.flush()
        return resp
    }

    // Run the app on `port`, dispatching each request through the router.
    fn serve(port: int): void {
        server.serve(port, self.route)
    }
}
