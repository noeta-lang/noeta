// `para.html` — server-side reactive HTML templating, LiveWire/LiveView-style, in pure Noeta. The
// liveview module of the first-party (non-default) `para` namespace. It composes three language
// substrates:
//
//   * expression tiers (expr-tiers arc)      — `@html { … ${expr} … }` is a typed template value;
//   * fine-grained reactivity (std.reactive) — each hole becomes a `computed`, so a signal change
//     recomputes exactly the affected holes;
//   * the reactive-view diff-push transport (std.reactive.view + std.http.server websockets) —
//     which serializes only the holes that changed and pushes a minimal patch to the browser.
//
// A consumer keys this package `para` in `[dependencies]`, imports `render` (which brings the
// `@html` tier declaration into scope) and `handle`, and writes ordinary HTML with `${…}` holes
// over signals. See `examples/liveview-counter/`.
namespace para.html

use std.reactive.{signal, computed, view, Signal, Computed, View}
use std.http.server
use std.http.{Request, Response, Socket}
use std.json

// A compiled `@html` template: the static HTML skeleton (holes rendered as `<span data-live="id">`
// markers, filled with their initial values for a no-flash first paint), the per-hole `computed`s
// the websocket session exposes and diffs, and the marker `id`s (parallel to `holes`) the session
// exposes each computed under. Holes are `dyn` — they *are* `Computed<string>`s, but `view.expose`
// accepts `dyn` and this keeps the field a built-in.
//
// `handlers` is the template's inline event table: an `${on_click(fn() => …)}` hole registers its
// closure here under an auto id (`eN`) and emits a matching `data-live-*` marker, so a client event
// routes straight to the closure at the element — no magic string, no central `on_event` match.
pub struct Html {
    skeleton: string
    holes: List<dyn>
    ids: List<string>
    handlers: Map<string, (string) -> void>
    // Keyed-list regions on this page (one per `${keyed(…)}` hole). The websocket session reconciles
    // each after every event: it diffs the region's key sequence and pushes minimal structural ops
    // (insert / remove / move) so add / prepend / remove / reorder patch in place instead of
    // re-rendering the parent. Empty for a page with no keyed lists.
    regions: List<KeyedRegion>
}

// The typed DOM events a template binds. This enum is the single source of truth for the event path:
// each variant maps to one `data-live-*` wire marker (`wire_attr`) and one client-side listener, so
// no event kind is ever a bare string. `on_click`/`on_input`/`on_submit` construct the `Binding`.
pub enum DomEvent {
    Click
    Input
    Submit
}

// A handler bound inline in a template (`<button ${on_click(fn() => …)}>`). The `@html` handler
// registers `run` in the page's `handlers` table under an auto id and emits `event`'s marker; the
// session loop looks the closure up by id when the client reports the event. `run` receives the
// event payload — empty for a click, the field value for an input, the URL-encoded body for a submit.
pub struct Binding {
    event: DomEvent
    run: (string) -> void
}

// The `data-live-*` wire marker for an event kind. The client shim (`live_js`) listens for the DOM
// event and reports the bound id under this attribute; `render` emits it; `prefix_markers` namespaces
// it when a region is folded. One place decides the attribute name for all three.
fn wire_attr(e: DomEvent): string {
    return match e {
        DomEvent.Click => "data-live-click",
        DomEvent.Input => "data-live-input",
        DomEvent.Submit => "data-live-submit",
    }
}

// Bind a **click**. The overwhelmingly common case, so it takes a bare `() -> void` — the click
// carries no payload.
pub fn on_click(handler: () -> void): Binding {
    return Binding { event: DomEvent.Click, run: fn(_: string) => handler() }
}

// Bind an **input** — the handler receives the field's current value on every keystroke.
pub fn on_input(handler: (string) -> void): Binding {
    return Binding { event: DomEvent.Input, run: handler }
}

// Bind a form **submit** — the handler receives the URL-encoded form body (`a=1&b=2`). The client
// prevents the default navigation so the page stays live.
pub fn on_submit(handler: (string) -> void): Binding {
    return Binding { event: DomEvent.Submit, run: handler }
}

// Minimal HTML-text escaping for a *scalar* hole's rendered value (XSS-safe by default).
fn escape(s: string): string {
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
}

// Escaping for an **attribute value** (inside `"…"`): the text escapes plus the quote.
fn attr_escape(s: string): string {
    return escape(s).replace("\"", "&quot;")
}

// Whether the skeleton so far ends **inside an open tag** — i.e. the hole about to be emitted sits
// in *attribute* position (`<li class="${…}">`) rather than text position. Detected from the
// preceding text: an unclosed `<` (no `>` after the last `<`). Such a hole is inlined (a `<span>`
// wrapper would be illegal inside a tag); a text-position hole gets the reactive `<span>` marker.
fn in_tag(s: string): bool {
    segs = s.split("<")
    if segs.len() <= 1 {
        return false
    }
    return segs[segs.len() - 1].index_of(">") == none
}

// Whether a hole value is itself markup (an `Html` from a nested `@html { … }`, or a `List<Html>`
// from a loop like `${rows.map(...)}`) — such a hole embeds *raw*; every other value is escaped
// text. This is the JSX rule: `{child}` composes, `{text}` is escaped.
fn is_markup(v: dyn): bool {
    return v is Html || v is List<Html>
}

// When a child `Html` is **folded** into a region (a `List<Html>` concatenation, or a keyed row), its
// own `data-live[-html]` markers become inert — the region is patched wholesale via `innerHTML`, so
// the child's markers are never diffed individually. But they still share the DOM `data-live`
// namespace with the *exposed* top-level markers (`hN`), so an unprefixed inner `h1` would be hit by
// a patch to the top-level `h1`. Prefixing folds each region's inner markers into a disjoint,
// deterministic namespace (`<prefix>-hN`) — stable across renders (so unchanged rows stay equal and
// the diff drops them) and never colliding with an exposed id.
fn prefix_markers(s: string, p: string): string {
    return s.replace("data-live=\"h", "data-live=\"${p}-h").replace("data-live-html=\"h", "data-live-html=\"${p}-h").replace("data-live-click=\"e", "data-live-click=\"${p}-e").replace("data-live-input=\"e", "data-live-input=\"${p}-e").replace("data-live-submit=\"e", "data-live-submit=\"${p}-e")
}

// Render one hole value to its HTML string: an `Html`'s skeleton verbatim, a `List<Html>` (a loop)
// concatenated, else the value escaped as text. Folded children get namespaced markers (see above).
fn render_value(v: dyn): string {
    single = v.as<Html>()
    if single != none {
        return prefix_markers((single ?? Html { skeleton: "", holes: [], ids: [], handlers: {}, regions: [] }).skeleton, "s")
    }
    many = v.as<List<Html>>()
    if many != none {
        mut out = ""
        mut idx = 0
        for child in many ?? [] {
            out = out ~ prefix_markers(child.skeleton, "c${idx}")
            idx = idx + 1
        }
        return out
    }
    return escape("${v}")
}

// A **keyed** list of rows (`${keyed(todos, key_of, row)}`) — each row is its *own* persistent
// reactive region, so a change to one row pushes only that row's new markup over the wire (the diff
// drops rows whose rendered value is unchanged), instead of re-`innerHTML`-ing the whole list. On
// top of that, *structural* changes to the key sequence — append, prepend, remove, reorder — patch
// in place: `render` seeds the region's rows, and the websocket `session` reconciles it after every
// event, emitting minimal insert / remove / move ops (see [`reconcile_region`]).
//
// `Keyed` carries the ingredients **deferred** (not pre-expanded): the current key sequence, and per
// key a row `computed`, its wrapper markup, and its inline handlers. All three are captured while the
// element type `T` is still known, then erased — so the value the template hole carries is a plain
// non-generic `Keyed` the checker can recover with `val.as<Keyed>()`.
struct Keyed {
    keys_now: () -> List<string>
    make_row: (string) -> dyn
    row_handlers: (string) -> Map<string, (string) -> void>
}

// A keyed region as the session reconciles it: the stable region id (one per `${keyed(…)}` hole,
// assigned by `render`), the last-rendered key sequence (`prev`, a `signal` so it survives across
// events), and the erased row operations. A row that stays in the set keeps its `computed`; a row
// that leaves is unexposed (its scope torn down); a row that joins gets a fresh `computed`.
pub struct KeyedRegion {
    region: string
    prev: Signal<List<string>>
    keys_now: () -> List<string>
    make_row: (string) -> dyn
    row_handlers: (string) -> Map<string, (string) -> void>
}

// One row's persistent `computed`: it re-derives *its* item from the source signal by key on every
// change (so it subscribes and re-runs), but renders to a value-equal string when the item is
// unchanged — so the diff transport drops it. `key` is a parameter (not a loop local) so each row's
// closure captures its own key. A vanished key renders empty (the row clears).
fn keyed_row<T>(
    source: Signal<List<T>>,
    key: string,
    key_of: (T) -> string,
    render_row: (T) -> Html,
): Computed<string> {
    return computed(fn() {
        cur = source.get().filter(fn(x) => key_of(x) == key)
        if cur.len() == 0 {
            return ""
        }
        // Namespace the row's inner markers by its key: inert (the row is patched wholesale) but kept
        // disjoint from the exposed `hN`/`row-K` ids, and stable so an unchanged row stays equal.
        return prefix_markers(render_row(cur[0]).skeleton, key)
    })
}

// One row's inline handlers, key-namespaced (`<key>-eN`) exactly as `prefix_markers` rewrites the
// row's `data-live-*` attributes when it is folded — so a click on the (stable-id) element routes to
// the registered closure. Re-derives the item from the source by key, so a row appended after first
// render still finds its handlers.
fn row_handlers_of<T>(
    source: Signal<List<T>>,
    key: string,
    key_of: (T) -> string,
    render_row: (T) -> Html,
): Map<string, (string) -> void> {
    cur = source.get().filter(fn(x) => key_of(x) == key)
    if cur.len() == 0 {
        return {}
    }
    rh = render_row(cur[0]).handlers
    mut out: Map<string, (string) -> void> = {}
    for hid in rh.keys() {
        out = out.set("${key}-${hid}", rh.get_or(hid, fn(_: string) {}))
    }
    return out
}

// Build a `Keyed` from a list signal: a stable key per item and, deferred, a persistent per-row
// `computed`. `source` is the signal itself (not a snapshot) so each row can re-read it; `key_of`
// gives a row's stable identity; `render_row` renders one item to an `@html` value. The three erased
// closures capture the typed `source`/`key_of`/`render_row` so `render` and the session can build,
// expand, and reconcile the region without `T`.
pub fn keyed<T>(
    source: Signal<List<T>>,
    key_of: (T) -> string,
    render_row: (T) -> Html,
): Keyed {
    return Keyed {
        keys_now: fn() => source.get().map(key_of),
        make_row: fn(k: string) => keyed_row(source, k, key_of, render_row),
        row_handlers: fn(k: string) => row_handlers_of(source, k, key_of, render_row),
    }
}

// The full marker id for a row: `<region>-row-<key>`. Region-namespaced so two keyed lists on one
// page whose keys collide (both `"1"`) still get disjoint DOM ids.
fn row_id(region: string, key: string): string {
    return "${region}-row-${key}"
}

// Reject a key sequence with a repeat — two rows sharing a key would collide on one DOM id, so the
// per-row diff could never tell them apart. Fail loudly and early rather than silently corrupt.
fn ensure_unique_keys(keys: List<string>): void {
    mut seen: List<string> = []
    for k in keys {
        if seen.contains(k) {
            panic("keyed: duplicate key '${k}' — a keyed list's keys must be unique")
        }
        seen = seen ~ [k]
    }
}

// The structural op kinds a keyed diff emits — the single source of truth for the wire `t` tag.
enum KeyOpKind {
    Remove
    Insert
    Move
}

// One structural op: `kind` on the row `key`, positioned immediately before the row `before` (or at
// the region end when `before` is `""`). `render`/reconcile turn this into the wire op, resolving
// `key`/`before` to region-namespaced marker ids and filling an insert's markup.
struct KeyOp {
    kind: KeyOpKind
    key: string
    before: string
}

// The longest-increasing-subsequence of `seq`, returned as the set (list) of *indices* into `seq`
// that participate — the O(n^2) DP with parent backtracking. Used by [`keyed_plan`] to find the
// largest run of survivors already in relative order: those keep their DOM position while every
// other survivor moves. Standard O(n log n) LIS collapses to this at these list sizes.
fn lis_indices(seq: List<int>): List<int> {
    n = seq.len()
    if n == 0 {
        return []
    }
    mut dp: List<int> = []
    mut par: List<int> = []
    mut i = 0
    while i < n {
        dp = dp ~ [1]
        par = par ~ [-1]
        i = i + 1
    }
    i = 0
    while i < n {
        mut j = 0
        while j < i {
            if seq[j] < seq[i] && dp[j] + 1 > dp[i] {
                dp[i] = dp[j] + 1
                par[i] = j
            }
            j = j + 1
        }
        i = i + 1
    }
    mut best = 0
    i = 1
    while i < n {
        if dp[i] > dp[best] {
            best = i
        }
        i = i + 1
    }
    mut out: List<int> = []
    mut k = best
    while k != -1 {
        out = out ~ [k]
        k = par[k]
    }
    return out.reverse()
}

// The keyed reconciliation: diff the previous key sequence into the next one and emit the **minimal**
// structural ops. This is the standard keyed-children algorithm (Vue 3's `patchKeyedChildren` / Solid
// & Inferno's reconcile): anchor the surviving rows on their longest increasing subsequence — those
// stay put — and insert / move everything else, walking `next` back-to-front so each op positions its
// row before an already-placed successor. Removals come first (so later `before` refs never name a
// gone row); inserts/moves follow in that backward order. `before == ""` means "at the region end".
fn keyed_plan(prev: List<string>, next: List<string>): List<KeyOp> {
    mut ops: List<KeyOp> = []
    for k in prev {
        if !next.contains(k) {
            ops = ops ~ [KeyOp { kind: KeyOpKind.Remove, key: k, before: "" }]
        }
    }
    // Survivors (in both), in `next` order, tagged with their position in `prev`.
    mut pos: Map<string, int> = {}
    mut pi = 0
    for k in prev {
        pos = pos.set(k, pi)
        pi = pi + 1
    }
    mut seq: List<int> = []
    mut seq_keys: List<string> = []
    for k in next {
        if prev.contains(k) {
            seq = seq ~ [pos.get_or(k, 0)]
            seq_keys = seq_keys ~ [k]
        }
    }
    keep_idx = lis_indices(seq)
    mut keep: List<string> = []
    mut si = 0
    for k in seq_keys {
        if keep_idx.contains(si) {
            keep = keep ~ [k]
        }
        si = si + 1
    }
    mut before = ""
    mut j = next.len() - 1
    while j >= 0 {
        k = next[j]
        if !prev.contains(k) {
            ops = ops ~ [KeyOp { kind: KeyOpKind.Insert, key: k, before: before }]
        } else if !keep.contains(k) {
            ops = ops ~ [KeyOp { kind: KeyOpKind.Move, key: k, before: before }]
        }
        before = k
        j = j - 1
    }
    return ops
}

// A compact, deterministic description of the structural ops a key-sequence change patches — the
// same minimal plan `reconcile_region` applies, but without markup or exposure. An introspection and
// testing aid: given the previous and next key order it names exactly the insert / remove / move ops.
// Ops are `; `-joined; `ins`/`mv` name the successor key they land before (`@end` at the tail).
pub fn keyed_op_stream(prev: List<string>, next: List<string>): string {
    plan = keyed_plan(prev, next)
    mut parts: List<string> = []
    for op in plan {
        anchor = if op.before == "" then "@end" else op.before
        tag = match op.kind {
            KeyOpKind.Remove => "rm ${op.key}",
            KeyOpKind.Insert => "ins ${op.key} ${anchor}",
            KeyOpKind.Move => "mv ${op.key} ${anchor}",
        }
        parts = parts ~ [tag]
    }
    return parts.join("; ")
}

// The result of reconciling one region for one event: the wire frame to push (empty when the key
// sequence did not change) and the page's updated handler table (rows in/out change the set of bound
// closures).
pub struct Reconcile {
    frame: string
    handlers: Map<string, (string) -> void>
}

// Reconcile one keyed region against the current key sequence and produce its structural patch.
// Removed rows are **unexposed** (`view.unexpose` disposes the per-row `computed` — its reactive
// scope is reclaimed on the spot, so a churning list leaves residency flat); inserted rows get a
// fresh `computed`, exposed under their marker id, with their initial markup carried inline in the
// op; moved rows keep their `computed` and their DOM element (state and focus survive the reorder).
// The content of surviving rows still rides the ordinary per-row diff — this only moves the boxes.
pub fn reconcile_region(reg: KeyedRegion, v: View, handlers: Map<string, (string) -> void>): Reconcile {
    keys_now = reg.keys_now
    make_row = reg.make_row
    row_handlers = reg.row_handlers
    prev = reg.prev.get()
    next = keys_now()
    if prev == next {
        return Reconcile { frame: "", handlers: handlers }
    }
    ensure_unique_keys(next)
    plan = keyed_plan(prev, next)
    mut h = handlers
    mut parts: List<string> = []
    for op in plan {
        rid = row_id(reg.region, op.key)
        before_ref = if op.before == "" then "@end" else row_id(reg.region, op.before)
        match op.kind {
            KeyOpKind.Remove => {
                v.unexpose(rid)
                // The row is gone from the source, so re-deriving its handlers yields nothing — drop
                // by its `<key>-` id namespace instead (the same one `keyed`/`prefix_markers` use).
                prefix = "${op.key}-"
                for hid in h.keys() {
                    if hid.starts_with(prefix) {
                        h = h.remove(hid)
                    }
                }
                parts = parts ~ ["{\"t\":\"rm\",\"id\":\"${rid}\"}"]
            },
            KeyOpKind.Insert => {
                c = make_row(op.key)
                v.expose(rid, c)
                rh = row_handlers(op.key)
                for hid in rh.keys() {
                    h = h.set(hid, rh.get_or(hid, fn(_: string) {}))
                }
                inner = computed_string(c)
                html = "<span data-live-html=\"${rid}\">${inner}</span>"
                parts = parts ~ ["{\"t\":\"ins\",\"id\":\"${rid}\",\"before\":\"${before_ref}\",\"html\":${json.stringify(html)}}"]
            },
            KeyOpKind.Move => {
                parts = parts ~ ["{\"t\":\"mv\",\"id\":\"${rid}\",\"before\":\"${before_ref}\"}"]
            },
        }
    }
    reg.prev.set(next)
    joined = parts.join(",")
    frame = "{\"type\":\"keyed\",\"region\":\"${reg.region}\",\"ops\":[${joined}]}"
    return Reconcile { frame: frame, handlers: h }
}

// Fold `from`'s inline handlers into `into` under `prefix` — the same prefix `prefix_markers` gives
// the folded region's `data-live-*` attributes, so a registered id (`s-e0`, `c1-e0`, `<key>-e0`)
// matches the attribute the client reports. Used to hoist a nested/keyed child's handlers up to the
// page's single dispatch table.
fn merge_handlers(
    into: Map<string, (string) -> void>,
    from: Map<string, (string) -> void>,
    prefix: string,
): Map<string, (string) -> void> {
    mut out = into
    for hid in from.keys() {
        out = out.set("${prefix}${hid}", from.get_or(hid, fn(_: string) {}))
    }
    return out
}

// The `@html` handler. Holes are `() -> dyn` — a template renders *any* value (like JSX `{x}`) — so
// `${count.get()}` needs no `.to_string()` and `${rows.map(row)}` composes nested templates. Each
// hole is wrapped in a `computed` so it tracks exactly the signals it reads and recomputes only when
// they change; the diff transport then pushes only the holes whose rendered value differs. A markup
// hole gets a `data-live-html` marker (the client applies patches via `innerHTML`); a text hole a
// `data-live` marker (`textContent`, escaped).
//
// A hole in *attribute* position that is an `on_*(…)` `Binding` is not rendered as text: it registers
// its closure in `handlers` under an auto id (`eN`) and emits the event's `data-live-*` marker. A
// nested `Html`/`List<Html>` folded into a text hole contributes *its* handlers too (prefix-namespaced
// to match `prefix_markers`), so the page ends with one flat dispatch table over every bound element.
@tier(html, text: "html", expr: Html)
pub fn render(statics: List<string>, holes: List<() -> dyn>): Html {
    mut skeleton = ""
    mut exposed: List<dyn> = []
    mut ids: List<string> = []
    mut handlers: Map<string, (string) -> void> = {}
    mut regions: List<KeyedRegion> = []
    mut i = 0
    for s in statics {
        skeleton = skeleton ~ s
        if i < holes.len() {
            hole = holes[i]
            val = hole()
            keyed_val = val.as<Keyed>()
            binding = val.as<Binding>()
            if keyed_val != none {
                // A keyed list: expand into one `data-live-html` region *per row* (exposing each row's
                // own persistent `computed`, so a change to one row diffs only that row), then close
                // with a hidden end-anchor the session inserts before when appending. Record a
                // `KeyedRegion` so the session can reconcile structural changes after each event.
                k = keyed_val ?? Keyed { keys_now: fn() => [], make_row: fn(_: string) => computed(fn() => ""), row_handlers: fn(_: string) => {} }
                region = "k${i}"
                keys_now = k.keys_now
                make_row = k.make_row
                row_handlers = k.row_handlers
                keys = keys_now()
                ensure_unique_keys(keys)
                for key in keys {
                    rid = row_id(region, key)
                    rc = make_row(key)
                    ids = ids ~ [rid]
                    exposed = exposed ~ [rc]
                    skeleton = skeleton ~ "<span data-live-html=\"${rid}\">" ~ computed_string(rc) ~ "</span>"
                    handlers = merge_handlers(handlers, row_handlers(key), "")
                }
                skeleton = skeleton ~ "<span data-live-keyed=\"${region}\" hidden></span>"
                regions = regions ~ [KeyedRegion {
                    region: region,
                    prev: signal(keys),
                    keys_now: k.keys_now,
                    make_row: k.make_row,
                    row_handlers: k.row_handlers,
                }]
            } else if in_tag(skeleton) && binding != none {
                // Attribute position, inline event handler: register the closure and emit the event's
                // wire marker (`data-live-click="eN"`) so a client event routes straight to it.
                b = binding ?? Binding { event: DomEvent.Click, run: fn(_: string) {} }
                hid = "e${i}"
                handlers = handlers.set(hid, b.run)
                skeleton = skeleton ~ "${wire_attr(b.event)}=\"${hid}\""
            } else if in_tag(skeleton) {
                // Attribute position: inline the escaped value (no `<span>` — it would be illegal
                // inside a tag). Its value re-renders with the enclosing region (a row), not on its
                // own, so it needs no marker id.
                skeleton = skeleton ~ attr_escape("${val}")
            } else {
                // Text position: wrap the hole in a `computed` (tracks exactly the signals it reads)
                // behind a `data-live`/`data-live-html` marker the session exposes and diffs. A folded
                // child template's handlers are hoisted under the same prefix its markers get.
                c = computed(fn() => render_value(hole()))
                hid = "h${i}"
                ids = ids ~ [hid]
                exposed = exposed ~ [c]
                marker = if is_markup(val) then "data-live-html" else "data-live"
                skeleton = skeleton ~ "<span ${marker}=\"${hid}\">" ~ c.get() ~ "</span>"
                child = val.as<Html>()
                if child != none {
                    handlers = merge_handlers(handlers, (child ?? Html { skeleton: "", holes: [], ids: [], handlers: {}, regions: [] }).handlers, "s-")
                }
                children = val.as<List<Html>>()
                if children != none {
                    mut ci = 0
                    for c2 in children ?? [] {
                        handlers = merge_handlers(handlers, c2.handlers, "c${ci}-")
                        ci = ci + 1
                    }
                }
            }
        }
        i = i + 1
    }
    return Html { skeleton: skeleton, holes: exposed, ids: ids, handlers: handlers, regions: regions }
}

// A row's initial rendered value for the first-paint skeleton. `c` is a `Computed<string>` carried
// as `dyn` (so it can sit alongside the other holes); `.get()` dispatches at runtime.
fn computed_string(c: dyn): string {
    return "${c.get()}"
}

// The client runtime — the bundled `server.liveview_js()` shim, extended so a **markup** hole
// (`data-live-html`) patches via `innerHTML` while a **text** hole (`data-live`) patches via
// `textContent` (escaped). The wire protocol is unchanged (hole → string); the marker attribute
// alone decides text-vs-markup, so a reactive loop of `<li>` rows updates in place.
fn live_js(): string {
    return `(() => {
  "use strict";
  const path = window.NOETA_LIVE_PATH || "/ws";
  const state = {};
  let ws = null;
  const render = (name) => {
    const value = state[name];
    const text = typeof value === "string" ? value : JSON.stringify(value);
    document.querySelectorAll('[data-live="' + name + '"]').forEach((el) => { el.textContent = text; });
    document.querySelectorAll('[data-live-html="' + name + '"]').forEach((el) => { el.innerHTML = text; });
  };
  const apply = (values) => { for (const n of Object.keys(values)) { state[n] = values[n]; render(n); } };
  const anchor = (id) => id === "@end" ? null : document.querySelector('[data-live-html="' + id + '"]');
  const keyed = (frame) => {
    const end = document.querySelector('[data-live-keyed="' + frame.region + '"]');
    for (const op of frame.ops) {
      if (op.t === "rm") {
        const el = document.querySelector('[data-live-html="' + op.id + '"]');
        if (el) el.remove();
        continue;
      }
      const before = op.before === "@end" ? end : anchor(op.before);
      if (!before) continue;
      if (op.t === "ins") { before.insertAdjacentHTML("beforebegin", op.html); }
      else if (op.t === "mv") {
        const el = document.querySelector('[data-live-html="' + op.id + '"]');
        if (el) before.parentNode.insertBefore(el, before);
      }
    }
  };
  const handle = (frame) => {
    if (frame.type === "snapshot") apply(frame.values);
    else if (frame.type === "patch") apply(frame.changes);
    else if (frame.type === "keyed") keyed(frame);
    else if (frame.type === "reload") location.reload();
    else if (frame.type === "error") console.error("noeta live:", frame.message);
  };
  const connect = () => {
    const scheme = location.protocol === "https:" ? "wss://" : "ws://";
    ws = new WebSocket(scheme + location.host + path);
    ws.onmessage = (e) => handle(JSON.parse(e.data));
    ws.onclose = () => setTimeout(connect, 1000);
  };
  const send = (name, value) => { if (ws && ws.readyState === 1) ws.send(JSON.stringify({ type: "event", name, value: value || "" })); };
  document.addEventListener("click", (e) => {
    const el = e.target.closest("[data-live-click]");
    if (el) send(el.dataset.liveClick, "");
  });
  document.addEventListener("input", (e) => {
    const el = e.target.closest("[data-live-input]");
    if (el) send(el.dataset.liveInput, el.value);
  });
  document.addEventListener("submit", (e) => {
    const el = e.target.closest("[data-live-submit]");
    if (el) { e.preventDefault(); send(el.dataset.liveSubmit, new URLSearchParams(new FormData(el)).toString()); }
  });
  window.noetaLive = { state, send };
  connect();
})();
`
}

// Wrap a rendered template in a full HTML document with the bundled client shim.
fn document(title: string, page: Html): string {
    head = "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>${title}</title></head><body>\n"
    return "${head}${page.skeleton}\n<script src=\"/live.js\"></script></body></html>\n"
}

// One websocket session: a `view()` over the page's hole computeds, the full snapshot, then a loop —
// each client event looks up the element's inline handler in the page's `handlers` table, runs it
// (with the event payload), and pushes the minimal diff of the holes that changed.
async fn session(sock: Socket, render_page: () -> Html): bool {
    page = render_page()
    v = view()
    mut i = 0
    for c in page.holes {
        v.expose(page.ids[i], c)
        i = i + 1
    }
    // The dispatch table is mutable across the session: a keyed row that joins registers its inline
    // handlers, a row that leaves drops them (see `reconcile_region`).
    mut handlers = page.handlers
    sock.send(v.snapshot())
    mut going = true
    while going {
        msg = sock.recv().await
        if msg == none {
            going = false
        } else {
            evt = json.parse(msg ?? "{}")
            kind = evt["type"]
            if kind == "event" {
                raw_name = evt["name"]
                raw_value = evt["value"]
                name = "${raw_name}"
                value = "${raw_value}"
                if handlers.has(name) {
                    handler = handlers.get_or(name, fn(_: string) {})
                    handler(value)
                }
            }
            // Structural reconcile first — a keyed list may have gained, lost, or reordered rows;
            // push its minimal insert/remove/move ops, and unexpose/expose the affected row bindings
            // so the content diff that follows neither pushes a gone row nor re-pushes a fresh one.
            for reg in page.regions {
                res = reconcile_region(reg, v, handlers)
                handlers = res.handlers
                if res.frame != "" {
                    sock.send(res.frame)
                }
            }
            patch = v.diff() ?? ""
            if patch != "" {
                sock.send(patch)
            }
        }
    }
    return true
}

// Handle one request: the websocket upgrade (the diff-push session), the bundled client shim, or
// the server-rendered page. An app's `fn fetch(req)` delegates here, so it runs under `noeta serve`
// like any `std.http.server` app. `render_page` produces the reactive page (an `@html` value); its
// inline `on_*(…)` bindings carry their own handlers, so no separate event callback is needed.
pub fn handle(
    req: Request,
    title: string,
    render_page: () -> Html,
): Response {
    if req.path() == "/ws" {
        return server.websocket(fn(sock) => session(sock, render_page))
    }
    if req.path() == "/live.js" {
        return server.response(200, live_js(), {"content-type": "application/javascript"})
    }
    return server.response(200, document(title, render_page()), {"content-type": "text/html"})
}
