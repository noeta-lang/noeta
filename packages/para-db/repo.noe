// para.db.repo — the repository + unit-of-work layer (aether DB2), pure Noeta over the DB1 query
// builder (`para.db.query`) and the DB0 native driver (`para.db`).
//
// A `Repository` maps rows (a `Map<string, dyn>` per row) to and from typed model structs by
// reflection over JSON:
//   * row -> model:  `json.decode_typed(model_name, json.stringify(row))`, where the model derives
//                    `@derive(Deserialize<Json>)`.
//   * model -> row:  `json.parse(entity.to_json())` (a `Map<string, dyn>` whose keys are the
//                    columns), where the model derives `@derive(Serialize<Json>)`.
// Generics are erased, so the model's runtime type NAME is passed to the constructor as a string.
//
// The unit-of-work is the advanced feature: `add`/`save`/`remove` STAGE inserts/updates/deletes
// during a request; `flush` commits them as one batch inside a single transaction (BEGIN … COMMIT),
// then clears the pending lists. Reads (`find`/`all`/`where`) go straight to the connection.

namespace para.db.repo

use para.db.Connection
use para.db.query.{table, run, exec, Query}
use std.json

// A repository over one model + table. Construct it with the model's runtime type name, its table,
// and its primary-key column: `Repository.new("User", "users", "id")`.
pub class Repository {
    model: string // the model's runtime type name (generics are erased — pass the name)
    tbl: string // the backing table
    pk: string // the primary-key column
    mut pending_new: List<dyn> // staged inserts (whole entities)
    mut pending_dirty: List<dyn> // staged updates (whole entities)
    mut pending_remove: List<dyn> // staged deletes (primary-key values)

    fn new(model: string, tbl: string, pk: string): Repository {
        return Repository {
            model: model,
            tbl: tbl,
            pk: pk,
            pending_new: [],
            pending_dirty: [],
            pending_remove: [],
        }
    }

    // --- Reads -------------------------------------------------------------------------------

    // Map one query row (`column -> value`) to the model: round-trip the row through JSON into the
    // model by its runtime name. On a decode error the row is malformed — return it as-is (still a
    // `dyn`) rather than aborting the whole read.
    fn map_row(row: Map<string, dyn>): dyn {
        return match json.decode_typed(self.model, json.stringify(row)) {
            Ok(v) => v,
            Err(e) => row,
        }
    }

    // Find one row by primary key, mapped to the model; `none` if there is no such row.
    fn find(conn: Connection, id: dyn): ?dyn {
        q = table(self.tbl).filter(self.pk, "=", id).limit(1).select("*")
        rows = run(conn, q)
        if rows.len() == 0 {
            return none
        }
        return some(self.map_row(rows[0]))
    }

    // Every row in the table, mapped to the model.
    fn all(conn: Connection): List<dyn> {
        q = table(self.tbl).select("*")
        rows = run(conn, q)
        mut out: List<dyn> = []
        for r in rows {
            out = out ~ [self.map_row(r)]
        }
        return out
    }

    // Rows matching `col <op> value`, mapped to the model (reuses the DB1 builder's `filter`).
    fn where(conn: Connection, col: string, op: string, value: dyn): List<dyn> {
        q = table(self.tbl).filter(col, op, value).select("*")
        rows = run(conn, q)
        mut out: List<dyn> = []
        for r in rows {
            out = out ~ [self.map_row(r)]
        }
        return out
    }

    // --- Unit of work: stage changes now, flush them as one batch later. ---------------------

    // Stage an INSERT of `entity` (flushed on the next `flush`).
    fn add(entity: dyn): void {
        self.pending_new = self.pending_new ~ [entity]
    }

    // Stage an UPDATE of `entity` (matched by its primary key on flush).
    fn save(entity: dyn): void {
        self.pending_dirty = self.pending_dirty ~ [entity]
    }

    // Stage a DELETE of the row whose primary key is `id`.
    fn remove(id: dyn): void {
        self.pending_remove = self.pending_remove ~ [id]
    }

    // Build the INSERT statement for one staged-new entity: all its columns/values.
    fn build_insert(entity: dyn): Query {
        m = columns_of(entity)
        cols = m.keys()
        mut vals: List<dyn> = []
        for c in cols {
            vals = vals ~ [m[c]]
        }
        return table(self.tbl).insert(cols, vals)
    }

    // Build the UPDATE statement for one staged-dirty entity: SET every non-pk column WHERE pk = its
    // own primary-key value.
    fn build_update(entity: dyn): Query {
        m = columns_of(entity)
        pk_value = m[self.pk]
        mut cols: List<string> = []
        mut vals: List<dyn> = []
        for c in m.keys() {
            if c != self.pk {
                cols = cols ~ [c]
                vals = vals ~ [m[c]]
            }
        }
        return table(self.tbl).filter(self.pk, "=", pk_value).update(cols, vals)
    }

    // Commit every staged change as one batch inside a single transaction, then clear the pending
    // lists. Returns the number of statements executed (inserts + updates + deletes).
    //
    // Error handling is structured with `if`/early-return in statement position (match arms are
    // expression-only): the driver surfaces a failed statement as a native error, so the happy path
    // runs BEGIN … COMMIT; a partial batch is undone by the transaction if COMMIT is never reached.
    fn flush(conn: Connection): int {
        mut count = 0
        conn.execute("BEGIN", [])
        for entity in self.pending_new {
            q = self.build_insert(entity)
            exec(conn, q)
            count = count + 1
        }
        for entity in self.pending_dirty {
            q = self.build_update(entity)
            exec(conn, q)
            count = count + 1
        }
        for id in self.pending_remove {
            q = table(self.tbl).filter(self.pk, "=", id).delete()
            exec(conn, q)
            count = count + 1
        }
        conn.execute("COMMIT", [])
        self.pending_new = []
        self.pending_dirty = []
        self.pending_remove = []
        return count
    }

    // Roll back every staged change without touching the database (drop the pending lists).
    fn discard(): void {
        self.pending_new = []
        self.pending_dirty = []
        self.pending_remove = []
    }
}

// Construct a repository over a model (runtime type name), its table, and its primary-key column.
pub fn repository(model: string, tbl: string, pk: string): Repository {
    return Repository.new(model, tbl, pk)
}

// Decompose a model entity into its columns and row values by round-tripping it through JSON:
// `to_json` (from `@derive(Serialize<Json>)`) then `parse` — the keys are the columns.
fn columns_of(entity: dyn): Map<string, dyn> {
    return json.parse(entity.to_json()).as<Map<string, dyn>>() ?? {}
}
