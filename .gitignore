# Rust build artifacts
/target
# The in-tree first-party packages (`packages/*/native/`) are their own cargo projects, built by
# the composed toolchain into their own `target/` dirs — never track those.
/packages/**/target/
**/*.rs.bk

# insta pending snapshots (review then accept; never commit *.snap.new)
**/*.snap.new

# Editor / OS noise
.DS_Store
*.swp

# Claude Code local state (keep shared .claude/settings.json trackable if desired)
.claude/worktrees/
.claude/settings.local.json

# Scratch outputs written by fs/async corpus programs when run from the repo root
# (e.g. `noeta run tests/conformance/std/fs_lines.noe` on the real host).
/a.txt
/b.txt
/c.txt
/f.txt
/log.txt
/scratch.txt
/data.bin
/.env

# VS Code extension build artifacts
editors/vscode-noeta/*.vsix
editors/vscode-noeta/node_modules/
