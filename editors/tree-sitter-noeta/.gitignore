# Per-project text-tier overlay — emitted by `noeta grammar tree-sitter` into a working checkout.
# Kept out of the repo so the in-repo grammar keeps its static `doc`-only fallback.
project-tiers.json

# Generated parser artifacts — reproduce with `tree-sitter generate`.
src/parser.c
src/grammar.json
src/node-types.json
src/tree_sitter/

# Build output and deps.
build/
node_modules/
*.wasm
*.so
*.dylib

# Downloaded tree-sitter CLI binary (from tree-sitter-cli install).
/tree-sitter
