@doc {
  # Demo application

  A tiny layered request flow — a **handler** calls a **service** that reads a
  **store** — plus the app's own documented domain types. It exercises the whole
  editor: the **Project** docs corpus (this file's `@doc` prose), the **Architecture**
  view (the `@role` bearers and their call graph), and the **Dependencies** view
  (the `geometry` package browsed below).
}
use geometry.vec.{Vec2, add}

// ---- Domain types (documented struct / class / enum). ----

@doc {
  A labelled point on a 2-D canvas.

  A value type: copies are independent.
}
struct Marker {
    label: string = ""
    x: int = 0
    y: int = 0

    @doc { A marker at the origin with the given `label`. }
    fn at_origin(label: string): Marker { return Marker { label: label } }

    @doc { Move the marker by `(dx, dy)`, returning a new marker. }
    fn shifted(dx: int, dy: int): Marker {
        return Marker { label: self.label, x: self.x + dx, y: self.y + dy }
    }
}

@doc {
  A mutable click tally backed by a fixed-width integer.

  A reference type: all handles observe the same count.
}
class Tally {
    mut n: u64 = 0u64

    @doc { Increment the tally by `by`. }
    fn bump(by: int): void { self.n = self.n + by.to_u64() }

    @doc { The current count. }
    fn count(): u64 { return self.n }
}

@doc { A drawable figure carrying associated data. }
enum Figure {
    Circle(float);
    Rect(int, int);

    @doc { The area of the figure. }
    fn area(): float {
        return match self {
            Figure.Circle(r) => 3.14159 * r * r,
            Figure.Rect(w, h) => (w * h).to_float(),
        };
    }
}

// ---- The architectural role vocabulary (a `@semantic` enum makes an enum role-eligible). ----

@doc { The layers of the demo's request flow, used as architectural roles. }
@semantic
enum Layer { Handler; Service; Store; }

@doc { Marks an inbound request handler (the entry layer). }
@attribute(Function)
@role(Layer.Handler)
struct Handler { route: string }

@doc { Marks a service-layer function (business logic). }
@attribute(Function)
@role(Layer.Service)
struct Service { name: string }

@doc { Marks a store-layer function (data access). }
@attribute(Function)
@role(Layer.Store)
struct Store { table: string }

// ---- The flow: handler -> service -> store. ----

@doc { Entry point: handle a greeting request for `who`. }
#[Handler("/greet")]
fn handle_greet(who: string): string {
    return greeting_for(who)
}

@doc { Compose the greeting from stored data, exercising the domain shapes. }
#[Service("greeting")]
fn greeting_for(who: string): string {
    count = visit_count()
    return "hello, ${who}! (${badge()}, visit ${count})"
}

@doc { Build a badge string from the app's domain types (`Marker`, `Figure`, `Tally`). }
#[Service("badge")]
fn badge(): string {
    marker = Marker.at_origin("home").shifted(1, 2)
    figure = Figure.Circle(2.0)
    clicks = Tally {}
    clicks.bump(3)
    return "${marker.label}@(${marker.x},${marker.y}) area=${figure.area()} clicks=${clicks.count()}"
}

@doc { Read the visit count from the store, using the `geometry` dependency. }
#[Store("visits")]
fn visit_count(): int {
    a = Vec2 { x: 1, y: 2 }
    b = Vec2 { x: 3, y: 4 }
    return add(a, b).manhattan()
}

echo handle_greet("world")
