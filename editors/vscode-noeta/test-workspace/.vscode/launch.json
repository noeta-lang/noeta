{
  // Debug profiles for the sample workspace: each launches `noeta dap` (the Noeta debug adapter)
  // via the extension — breakpoints, stepping, and variable inspection over the production VM.
  // Pressing F5 with a .noe file focused also works with NO launch.json at all: the extension
  // synthesizes a configuration for the active file.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "noeta",
      "request": "launch",
      "name": "Debug app (main.noe)",
      "program": "${workspaceFolder}/app/main.noe",
      "stopOnEntry": false
    },
    {
      "type": "noeta",
      "request": "launch",
      "name": "Debug current .noe file",
      "program": "${file}",
      "stopOnEntry": false
    }
  ]
}
