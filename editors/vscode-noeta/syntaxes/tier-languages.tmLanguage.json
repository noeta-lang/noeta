{
  "$comment": "Auto-highlighting for EMBEDDED-LANGUAGE tier bodies (@sql/@html/@css/\u2026). Bundled in the Noeta VS Code extension as an INJECTION grammar (injectTo source.noeta) \u2014 it does NOT touch the core language grammar. Each rule matches a tier named after a well-known language (which, for first-party tiers, is exactly the tier's declared text: language) and injects that language's grammar into the @<name> { \u2026 } body; ${\u2026} holes (expression tiers) scope back to source.noeta. A tier whose name differs from its text: language still ships its own one-rule grammar (see the extension README, Text tiers).",
  "scopeName": "inline.noeta.tier-languages",
  "injectionSelector": "L:source.noeta",
  "patterns": [
    {
      "include": "#sql-tier"
    },
    {
      "include": "#html-tier"
    },
    {
      "include": "#css-tier"
    },
    {
      "include": "#json-tier"
    },
    {
      "include": "#yaml-tier"
    },
    {
      "include": "#xml-tier"
    },
    {
      "include": "#graphql-tier"
    },
    {
      "include": "#markdown-tier"
    },
    {
      "include": "#javascript-tier"
    },
    {
      "include": "#python-tier"
    },
    {
      "include": "#shell-tier"
    },
    {
      "include": "#toml-tier"
    },
    {
      "include": "#sparql-tier"
    }
  ],
  "repository": {
    "tier-escape": {
      "$comment": "Text-body escapes \\{ \\} \\\\ \\$ \u2014 matched first so an escaped closer/dollar never triggers a rule below.",
      "name": "constant.character.escape.noeta",
      "match": "\\\\[{}$\\\\]"
    },
    "tier-hole": {
      "$comment": "A ${ \u2026 } hole (expr tiers) is ordinary Noeta \u2014 scope it back to source.noeta so it highlights as code.",
      "begin": "(\\$\\{)",
      "end": "(\\})",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.noeta"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.end.noeta"
        }
      },
      "contentName": "meta.embedded.line.noeta",
      "patterns": [
        {
          "include": "source.noeta"
        }
      ]
    },
    "sql-tier": {
      "begin": "(@)(sql)\\b\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.decorator.noeta"
        },
        "2": {
          "name": "entity.name.function.decorator.noeta"
        },
        "3": {
          "name": "punctuation.section.tier.begin.noeta"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.tier.end.noeta"
        }
      },
      "contentName": "meta.embedded.block.sql",
      "patterns": [
        {
          "include": "#tier-escape"
        },
        {
          "include": "#tier-hole"
        },
        {
          "include": "#sql-brace"
        },
        {
          "include": "source.sql"
        }
      ]
    },
    "sql-brace": {
      "$comment": "A nested balanced brace pair \u2014 recursion counts depth so a { \u2026 } in the body does not close the block.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#tier-escape"
        },
        {
          "include": "#tier-hole"
        },
        {
          "include": "#sql-brace"
        },
        {
          "include": "source.sql"
        }
      ]
    },
