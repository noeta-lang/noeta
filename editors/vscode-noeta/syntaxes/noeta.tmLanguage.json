{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Noeta",
  "scopeName": "source.noeta",
  "patterns": [
    { "include": "#shebang" },
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#text-tier-blocks" },
    { "include": "#decorators" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#storage-types" },
    { "include": "#builtin-functions" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "shebang": {
      "name": "comment.line.shebang.noeta",
      "match": "\\A#!.*$"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.noeta",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.noeta" }
          }
        },
        {
          "name": "comment.block.noeta",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.noeta" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.noeta" }
          },
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },

    "attributes": {
      "comment": "Metadata attributes: #[Name(...)]. Distinct from the #{...} set literal.",
      "name": "meta.attribute.noeta",
      "begin": "(#)(\\[)",
      "end": "\\]",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.attribute.noeta" },
        "2": { "name": "punctuation.section.attribute.begin.noeta" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.attribute.end.noeta" }
      },
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\b",
          "name": "entity.name.tag.attribute.noeta"
        },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#punctuation" }
      ]
    },

    "text-tier-blocks": {
      "comment": "A text tier's `@<name> { … }` body is verbatim prose the compiler never lexes as code (text-tiers arc). std's `doc` is the built-in text tier (body language: markdown); it is matched here — before #decorators — so the body's apostrophes/backticks/quotes can never open string scopes that bleed past the block. Brace counting mirrors the compiler lexer's matching_brace exactly: braces nest (the recursive #text-tier-brace-pair), and \\{ / \\} are literal braces with \\\\ a literal backslash (the escape pattern consumes them before any brace rule sees them). A third-party declared text tier (`@tier(x, text: \"sql\")`) ships its own injection grammar with a rule of this same shape (injectionSelector `L:source.noeta`) — that is the extension mechanism; this grammar stays static.",
      "begin": "(@)(doc)\\b\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.decorator.noeta" },
        "2": { "name": "entity.name.function.decorator.noeta" },
        "3": { "name": "punctuation.section.tier.begin.noeta" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.tier.end.noeta" }
      },
      "contentName": "meta.embedded.block.markdown",
      "patterns": [
        { "include": "#text-tier-escape" },
        { "include": "#text-tier-brace-pair" },
        { "include": "text.html.markdown" }
      ]
    },
    "text-tier-escape": {
      "comment": "The three text-body escapes: \\{ \\} \\\\ — literal braces/backslash, never counted. Matched ahead of the brace rules so an escaped closer cannot end the block.",
      "name": "constant.character.escape.noeta",
      "match": "\\\\[{}\\\\]"
    },
    "text-tier-brace-pair": {
      "comment": "A nested balanced brace pair inside a text body — recursion is how TextMate counts depth, so a `{snippet}` in prose does not close the block.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#text-tier-escape" },
        { "include": "#text-tier-brace-pair" },
        { "include": "text.html.markdown" }
      ]
    },
    "decorators": {
      "comment": "Directives and tier blocks: @derive(...), @role(...), @test, @bench(...), @debug. The decorator set {derive, attribute, role, semantic, packed} is fixed; every other @name is a tier (open set). @doc is carved out above as the built-in text tier.",
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.decorator.noeta" },
        "2": { "name": "entity.name.function.decorator.noeta" }
      }
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.noeta",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.noeta" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.noeta" }
          },
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.noeta",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.noeta" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.noeta" }
          },
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" }
          ]
        },
        {
          "name": "string.quoted.template.noeta",
          "comment": "Backtick dedented-template string; supports the same ${...} holes.",
          "begin": "`",
          "end": "`",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.noeta" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.noeta" }
          },
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#interpolation" }
          ]
        }
      ]
    },

    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.interpolation.noeta",
          "comment": "An escaped interpolation opener: \\${ is a literal dollar-brace.",
          "match": "\\\\\\$\\{"
        },
        {
          "name": "constant.character.escape.noeta",
          "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{2}|.)"
        }
      ]
    },

    "interpolation": {
      "name": "meta.interpolation.noeta",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.noeta" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.noeta" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#keywords" },
        { "include": "#storage-types" },
        { "include": "#builtin-functions" },
        { "include": "#types" },
        { "include": "#function-call" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.noeta",
          "comment": "Float, optionally with an exponent and an f32 suffix.",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?(f32)?\\b"
        },
        {
          "name": "constant.numeric.float.noeta",
          "match": "\\b[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)(f32)?\\b"
        },
        {
          "name": "constant.numeric.float.noeta",
          "match": "\\b[0-9][0-9_]*f32\\b"
        },
        {
          "name": "constant.numeric.hex.noeta",
          "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*((i|u)(8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.octal.noeta",
          "match": "\\b0[oO][0-7][0-7_]*((i|u)(8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.binary.noeta",
          "match": "\\b0[bB][01][01_]*((i|u)(8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.integer.noeta",
          "match": "\\b[0-9][0-9_]*((i|u)(8|16|32|64))?\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.noeta",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.self.noeta",
          "match": "\\bself\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.noeta",
          "match": "\\b(if|then|else|for|while|break|continue|in|match|return|yield|await)\\b"
        },
        {
          "name": "keyword.control.concurrency.noeta",
          "match": "\\b(async|concurrent|spawn|isolate|channel)\\b"
        },
        {
          "name": "keyword.other.echo.noeta",
          "match": "\\b(echo)\\b"
        },
        {
          "name": "keyword.control.import.noeta",
          "match": "\\b(use|namespace|pub)\\b"
        },
        {
          "name": "keyword.operator.word.noeta",
          "match": "\\b(as|is)\\b"
        },
        {
          "name": "keyword.other.reflection.noeta",
          "match": "\\b(type_of|attributes_of|roles_of|from_bytes|invoke)\\b"
        }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "comment": "Function declaration: bind the name that follows `fn`.",
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.noeta keyword.declaration.function.noeta" },
            "2": { "name": "entity.name.function.noeta" }
          }
        },
        {
          "comment": "Type declaration: bind the name that follows a type-introducing keyword.",
          "match": "\\b(struct|class|enum|type|impl|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.noeta keyword.declaration.type.noeta" },
            "2": { "name": "entity.name.type.noeta" }
          }
        },
        {
          "name": "storage.type.noeta",
          "match": "\\b(fn|mut|struct|class|enum|type|impl|trait|destruct)\\b"
        }
      ]
    },

    "storage-types": {
      "comment": "Built-in primitive and standard container types.",
      "patterns": [
        {
          "name": "support.type.primitive.noeta",
          "match": "\\b(int|float|f32|bool|string|bytes|void|unit|dyn|i8|i16|i32|i64|u8|u16|u32|u64)\\b"
        },
        {
          "name": "support.type.builtin.noeta",
          "match": "\\b(List|Map|Set|Option|Result)\\b"
        }
      ]
    },

    "builtin-functions": {
      "name": "support.function.builtin.noeta",
      "match": "\\b(signal|computed|effect|assert|panic|len)\\s*(?=\\()"
    },

    "types": {
      "comment": "PascalCase identifiers are user-defined types (structs, classes, enums).",
      "match": "\\b([A-Z][A-Za-z0-9_]*)\\b",
      "name": "entity.name.type.noeta"
    },

    "function-call": {
      "comment": "An identifier immediately followed by a call paren.",
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "name": "entity.name.function.call.noeta"
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.noeta",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.noeta",
          "match": "(=>|->)"
        },
        {
          "name": "keyword.operator.identity.noeta",
          "match": "(===|!==)"
        },
        {
          "name": "keyword.operator.comparison.noeta",
          "match": "(==|!=|<=|>=|<(?![<])|>(?![>]))"
        },
        {
          "name": "keyword.operator.coalesce.noeta",
          "match": "(\\?\\?=|\\?\\?|\\?)"
        },
        {
          "name": "keyword.operator.assignment.compound.noeta",
          "match": "(\\+=|-=|\\*=|/=|%=|~=)"
        },
        {
          "name": "keyword.operator.assignment.noeta",
          "match": "="
        },
        {
          "name": "keyword.operator.logical.noeta",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.noeta",
          "match": "(<<|>>|&|\\^|\\|)"
        },
        {
          "name": "keyword.operator.spread.noeta",
          "comment": "Must precede the range operator so `...` is not tokenized as `..` + `.`.",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.noeta",
          "match": "(\\.\\.=|\\.\\.)"
        },
        {
          "name": "keyword.operator.arithmetic.noeta",
          "match": "(\\+|-|\\*|/|%|~)"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.namespace.noeta", "match": "::" },
        { "name": "punctuation.terminator.statement.noeta", "match": ";" },
        { "name": "punctuation.separator.comma.noeta", "match": "," },
        { "name": "punctuation.separator.colon.noeta", "match": ":" },
        { "name": "punctuation.accessor.noeta", "match": "\\." },
        { "name": "punctuation.section.braces.begin.noeta", "match": "\\{" },
        { "name": "punctuation.section.braces.end.noeta", "match": "\\}" },
        { "name": "punctuation.section.brackets.begin.noeta", "match": "\\[" },
        { "name": "punctuation.section.brackets.end.noeta", "match": "\\]" },
        { "name": "punctuation.section.parens.begin.noeta", "match": "\\(" },
        { "name": "punctuation.section.parens.end.noeta", "match": "\\)" }
      ]
    }
  }
}
