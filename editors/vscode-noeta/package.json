{
  "name": "noeta",
  "displayName": "Noeta",
  "description": "Language support for the Noeta programming language (.noe): syntax highlighting, the noeta lsp language server (diagnostics, hover, inlay type hints, go-to-definition, outline, completion, formatting with format-on-save/on-type), the noeta dap debugger (breakpoints, stepping, variables), and the noeta mcp server auto-registered for the editor's AI agents.",
  "version": "0.5.0",
  "publisher": "noeta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noeta-lang/noeta"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "noeta",
    "noe"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:noeta",
    "onDebugResolve:noeta",
    "onDebugDynamicConfigurations:noeta"
  ],
  "contributes": {
    "languages": [
      {
        "id": "noeta",
        "aliases": [
          "Noeta",
          "noeta"
        ],
        "extensions": [
          ".noe"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "noeta",
        "scopeName": "source.noeta",
        "path": "./syntaxes/noeta.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[noeta]": {
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "breakpoints": [
      {
        "language": "noeta"
      }
    ],
    "debuggers": [
      {
        "type": "noeta",
        "label": "Noeta",
        "languages": [
          "noeta"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .noe file to run.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause before the first instruction runs.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "noeta",
            "request": "launch",
            "name": "Debug Noeta file",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Noeta: Debug current file",
            "description": "Run the active .noe file under the Noeta debugger.",
            "body": {
              "type": "noeta",
              "request": "launch",
              "name": "Debug Noeta file",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "noeta.mcp",
        "label": "Noeta compiler tools"
      }
    ],
    "customEditors": [
      {
        "viewType": "noeta.profileView",
        "displayName": "Noeta Profile",
        "selector": [
          {
            "filenamePattern": "*.noeprof.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "noeta.restartServer",
        "title": "Noeta: Restart Language Server"
      },
      {
        "command": "noeta.profileFile",
        "title": "Profile File (Sampling)",
        "category": "Noeta",
        "icon": "$(flame)"
      },
      {
        "command": "noeta.profileFileInstrumented",
        "title": "Profile File (Instrumenting, exact counts)",
        "category": "Noeta"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "noeta.profileFile",
          "when": "resourceLangId == noeta",
          "group": "profile@1"
        },
        {
          "command": "noeta.profileFileInstrumented",
          "when": "resourceLangId == noeta",
          "group": "profile@2"
        }
      ],
      "commandPalette": [
        {
          "command": "noeta.profileFile",
          "when": "resourceLangId == noeta"
        },
        {
          "command": "noeta.profileFileInstrumented",
          "when": "resourceLangId == noeta"
        }
      ]
    },
    "configuration": {
      "title": "Noeta",
      "properties": {
        "noeta.server.path": {
          "type": "string",
          "default": "noeta",
          "markdownDescription": "Path to the `noeta` executable. The extension launches it as `noeta lsp` (language server) and `noeta dap` (debugger). Defaults to `noeta` on your `PATH`; set an absolute path to use a local build (e.g. `target/release/noeta`)."
        },
        "noeta.profile.hz": {
          "type": "number",
          "default": 1000,
          "description": "Sampling rate (Hz) for Noeta: Profile File (Sampling)."
        },
        "noeta.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the JSON-RPC traffic between VS Code and the Noeta language server, in the server's output channel."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.101.0"
  }
}
