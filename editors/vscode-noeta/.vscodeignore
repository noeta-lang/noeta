# This extension is not bundled — `src/extension.js` loads `vscode-languageclient` from
# `node_modules` at runtime, so production dependencies must ship in the .vsix. Package with
# `npm install --omit=dev` first (so only runtime deps are present), then `vsce package`.
.vscodeignore
**/*.vsix
.vscode-test/**
test-workspace/**
package-lock.json
test/**
node_modules/vscode-textmate/**
node_modules/vscode-oniguruma/**
