// K5 gate: bulk add in METHOD form (2048 elements × 3000 calls) — must match the module form
// (tests/bench/pm-native/v_add_row.noe): same shared dispatch, plus only the route resolution.
use std.{vec}

@packed struct V3 { x: f32; y: f32; z: f32 }
impl vec.Kernels for V3 {}

mut xs = [V3 { x: 1.5f32, y: 2.5f32, z: 3.5f32 }]
mut d = 0
while d < 11 {
    xs = xs ~ xs
    d = d + 1
}
ys = xs

mut total = 0
mut k = 0
while k < 3000 {
    r = xs.add_all(ys)
    total = total + r.len()
    k = k + 1
}
echo "total=${total}"
