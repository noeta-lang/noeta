// P-PAR S0a: one big corpus fanned to 8 real isolates. Today each `isolate score(corpus)`
// deep-copies the corpus through `Wire` (marshal + rebuild); after P-PAR-SHARE the graph is
// promoted into a `SharedRegion` once and borrowed by every worker. Compare against
// fanout_n{0,1,2,4}.noe — the per-worker slope is the copy cost.
struct Rec { name: string; a: int; b: int }

fn build(sz: int): List<Rec> {
    mut l: List<Rec> = []
    for i in 0..sz {
        l ~= [Rec { name: "record-${i}", a: i, b: i * 2 }]
    }
    return l
}

async fn score(corpus: List<Rec>): int {
    mut s = 0
    for r in corpus {
        s = s + r.a + r.b
    }
    return s
}

async fn run(): int {
    corpus = build(100000)
    mut total = 0
    concurrent {
        h1 = isolate score(corpus)
        h2 = isolate score(corpus)
        h3 = isolate score(corpus)
        h4 = isolate score(corpus)
        h5 = isolate score(corpus)
        h6 = isolate score(corpus)
        h7 = isolate score(corpus)
        h8 = isolate score(corpus)
        total = h1.await + h2.await + h3.await + h4.await
            + h5.await + h6.await + h7.await + h8.await
    }
    return total
}
echo run().await
