// `match` exhaustiveness is checked statically by the M1 type checker: a `match` on an enum
// that omits a variant (here `E.C`) with no `_` catch-all is a compile-time error (E0011),
// reported at the `match` expression. In M0 this surfaced at runtime (E0007); M1.7 promotes it.
// expect: error E0011 at 7:6
// expect: exit 1
enum E { A; B; C; }
echo match E.C { E.A => 1, E.B => 2 };
