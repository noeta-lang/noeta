// `Enum.try_from(v)` → `?Enum` and `Enum.from(v)` → `Enum` — the recoverable/aborting pair, matched
// by backing value first and then by case name. A **plain** enum has no backings, so the case name is
// what selects here (`enums/from_backing` covers the backed half). `try_from` yields `some(case)` on
// a hit and `none` on a miss; `from` yields the case (the `none`-coalesced fallback exercises the
// `?`/`??` plumbing). A payload-carrying variant is never selected — there is no payload to supply.
// Both backends agree.
// expect: stdout "some(Status.Paid)"
// expect: stdout "true"
// expect: stdout "Status.Pending"
// expect: stdout "fallback"
// expect: exit 0
enum Status {
    Pending;
    Paid;
    Failed(reason: string);
}

echo Status.try_from("Paid");
echo Status.try_from("Nope") == none;
echo Status.from("Pending");
// A payload variant name is not constructible (no payload to supply) -> none -> the `??` fallback.
m = Status.try_from("Failed");
// `some(s)` first: a bare `none` pattern is a *binding*, so it matches every value — putting it
// ahead of the `some` arm would swallow it (E0066).
echo match m {
    some(s) => "${s}",
    none => "fallback",
};
