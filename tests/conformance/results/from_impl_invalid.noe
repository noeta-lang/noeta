// `impl From` shape validation (all E0015): the impl names exactly one source type
// (`impl From<Source>`), its `from` parameter must agree with that declared source, and `from`
// is an ASSOCIATED conversion — it builds a new value from its argument, so a body referencing
// `self` has no receiver to refer to.
// expect: error E0015 at 12:10
// expect: error E0015 at 19:17
// expect: error E0015 at 27:12
// expect: exit 1
struct A { n: int }

struct NoArg {
    impl From {
        fn from(e: A): NoArg { return NoArg {} }
    }
}

struct WrongParam {
    impl From<A> {
        fn from(e: string): WrongParam { return WrongParam {} }
    }
}

struct SelfRef {
    m: int

    impl From<A> {
        fn from(e: A): SelfRef { return SelfRef { m: self.m + e.n } }
    }
}

echo "unreached"
