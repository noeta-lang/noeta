// `?`-boundary error conversion into an **enum** target. An `impl From<Source>` in an enum's body
// converts exactly as it does on a struct, at a `?` and at an explicit `AppError.from(e)` — resolved
// by the argument's type, not by the name alone, which is what keeps it distinct from the name-string
// builtin `Enum.from(s)`/`Enum.try_from(s)` every enum also carries. The `Status` half pins that an
// enum declaring no conversion keeps that builtin; `from_enum_backing_and_conversion` pins that an
// enum declaring one keeps it too.
// expect: stdout "Ok(42)"
// expect: stdout "Err(AppError.Wrapped(7))"
// expect: stdout "explicit: 1"
// expect: stdout "some(Status.Paid)"
// expect: stdout "Status.Pending"
// expect: exit 0
struct LowError { code: int }

enum AppError {
    Wrapped(code: int)
    Other

    impl From<LowError> {
        pub fn from(e: LowError): AppError {
            return AppError.Wrapped(code: e.code)
        }
    }
}

enum Status { Pending; Paid }

fn low(fail: bool): Result<int, LowError> {
    if fail { return Err(LowError { code: 7 }) }
    return Ok(40)
}

fn high(fail: bool): Result<int, AppError> {
    n = low(fail)?
    return Ok(n + 2)
}

echo high(false)
echo high(true)
echo "explicit: ${match AppError.from(LowError { code: 1 }) { AppError.Wrapped(c) => c, AppError.Other => -1 }}"
// An enum that declares no `From` impl still gets the name-string pair.
echo Status.try_from("Paid")
echo Status.from("Pending")
