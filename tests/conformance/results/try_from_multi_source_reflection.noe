// What a declared conversion looks like to a **by-name** lookup, which carries no source type.
//
// A conversion is named after the source it converts, so the bare `from` names none of them and a
// lookup for it misses — with a message that names what the type does declare and how to reach it,
// because the `impl From<…>` blocks are right there in the source. The conversion's own name reaches
// it. That holds whether the type declares one conversion or several: the answer never depends on
// how many SIBLING conversions a type happens to have, so adding a second one cannot change how the
// first is reached.
//
// Discovery and dispatch agree by construction — whatever `params_of` describes is what `invoke`
// calls — because both read the same name.
// expect: stdout "one bare: Err(type `One` declares a conversion from `A`; call `from<A>`)"
// expect: stdout "one named: Ok(One {m: \"from a\"})"
// expect: stdout "many bare: Err(type `Many` declares conversions from `A` and `B`; call `from<A>` or `from<B>`)"
// expect: stdout "many named: Ok(Many {m: \"from b\"})"
// expect: stdout "params one bare: 0"
// expect: stdout "params one named: 1"
// expect: stdout "params many bare: 0"
// expect: stdout "params many named: 1"
// expect: stdout "on a value: Err(type `One` declares a conversion from `A`; call `from<A>`)"
// expect: exit 0
struct A { n: int }
struct B { s: string }

struct One {
    m: string

    impl From<A> {
        pub fn from(e: A): One { return One { m: "from a" } }
    }
}

struct Many {
    m: string

    impl From<A> {
        pub fn from(e: A): Many { return Many { m: "from a" } }
    }

    impl From<B> {
        pub fn from(e: B): Many { return Many { m: "from b" } }
    }
}

echo "one bare: ${invoke(One, "from", [A { n: 1 }])}"
echo "one named: ${invoke(One, "from<A>", [A { n: 1 }])}"
echo "many bare: ${invoke(Many, "from", [A { n: 1 }])}"
echo "many named: ${invoke(Many, "from<B>", [B { s: "x" }])}"
echo "params one bare: ${params_of("One.from").len()}"
echo "params one named: ${params_of("One.from<A>").len()}"
echo "params many bare: ${params_of("Many.from").len()}"
echo "params many named: ${params_of("Many.from<A>").len()}"
// A VALUE receiver reaches the same rule through the instance path, and reports it identically.
value: dyn = One { m: "held" }
echo "on a value: ${invoke(value, "from", [A { n: 1 }])}"
