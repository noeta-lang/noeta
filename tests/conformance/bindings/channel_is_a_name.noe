// `channel` is a CONTEXTUAL keyword, not a reserved one: it is special ONLY as `channel::<T>(…)`
// (the bounded-channel constructor — see async/channel.noe), so it stays free as an ordinary field /
// variable / parameter name everywhere else. It is far too common a name to reserve.
// expect: stdout "news"
// expect: stdout "42"
// expect: exit 0
class Topic {
    channel: string

    pub fn new(channel: string): Topic {
        return Topic { channel: channel }
    }

    pub fn name(): string {
        return self.channel
    }
}

topic = Topic.new("news")
echo topic.name()

// A local binding named `channel` is equally fine (in its own fn: a top-level `channel` binding
// would be a visible global, which the method parameter above may not shadow — E0059).
fn as_local(): int {
    channel = 42
    return channel
}
echo "${as_local()}"
