// Track G.2 — `yield` runs at the top level and inside `if`/`while` (the state machine flattens
// them), but a `yield` inside a `for` loop still needs the iterator-driven loop state a later slice
// adds, so it is gated with E0039 (pointing at the offending `yield`). The straight-line `yield`
// above is fine — it is the one inside the `for` that is rejected.
// expect: error E0039 at 10:9
// expect: exit 1
fn nums(): Iterator<int> {
    yield 0
    for x in [1, 2, 3] {
        yield x
    }
}
echo "x"
