// A statement continues across a newline when the line ends on an operator, and for `~`/`&`/`^`/`<<`
// that trailing position is the ONLY one that works: a newline ends a statement unless the next
// line's first token continues it, and none of these four do (a leading `~` would start a new
// statement). `+` is the contrast — it may lead the next line as well, which is why
// `optional_semicolons.noe` writes it that way.
//
// This is also the corpus gate on the `noeta fmt` printer: it used to move every operator to the
// head of the broken line, so its output for `"a" ~⏎"b"` lexed as two statements and failed the
// formatter's own re-parse safety check (`crates/noeta-fmt/tests/corpus.rs` panics on any corpus
// file whose formatting trips that gate).
// expect: stdout "abc"
// expect: stdout "2"
// expect: stdout "5"
// expect: stdout "16"
// expect: stdout "one-two"
// expect: exit 0

// Trailing `~`: the concatenation continues on the next line.
joined = "a" ~
    "b" ~
    "c"
echo joined

// The bitwise trio behaves the same way.
echo 10 &
    6
echo 6 ^
    3
echo 1 <<
    4

// A trailing `~` inside an interpolated argument list, indented — the shape a real program writes.
label = "one" ~
    "-" ~
    "two"
echo label
