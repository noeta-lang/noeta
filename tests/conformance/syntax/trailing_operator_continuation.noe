// A statement continues across a newline when the line ends on an operator. Every infix operator
// supports this, and every one also supports the mirror spelling, where the operator leads the next
// line instead — see `leading_operator_continuation.noe`, which pins that half.
//
// This is also the corpus gate on the `noeta fmt` printer: it moves an operator to the head of the
// broken line, so a file written this way is re-emitted in the other spelling and must still mean
// the same program (`crates/noeta-fmt/tests/corpus.rs` panics on any corpus file whose formatting
// trips the formatter's own re-parse safety check).
// expect: stdout "abc"
// expect: stdout "2"
// expect: stdout "5"
// expect: stdout "16"
// expect: stdout "one-two"
// expect: exit 0

// Trailing `~`: the concatenation continues on the next line.
joined = "a" ~
    "b" ~
    "c"
echo joined

// The bitwise trio behaves the same way.
echo 10 &
    6
echo 6 ^
    3
echo 1 <<
    4

// A trailing `~` inside an interpolated argument list, indented — the shape a real program writes.
label = "one" ~
    "-" ~
    "two"
echo label
