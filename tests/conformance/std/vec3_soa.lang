// P-SIMD: the opt-in columnar (SoA) Vec3 batch. `vec.soa(list)` transposes a packed `List<Vec3>`
// into three contiguous `f32` columns (an opaque batch value), on which the bulk reductions
// `soa_dot`/`soa_length` autovectorize across elements (2.7×–4× over the AoS kernels). The batch is
// bit-identical to the AoS kernels — the columnar kernels live in `lang_stdlib::vec3`, so both
// backends agree and the differential pins it. `soa_add`/`soa_sub`/`soa_scale` return a new batch;
// `soa_list` transposes back to a packed `List<Vec3>`; `soa_count` reads the element count.
// expect: stdout "2"
// expect: stdout "[60.0, 15.0]"
// expect: stdout "[5.0, 13.0]"
// expect: stdout "[V3 {x: 11.0, y: 12.0, z: 13.0}, V3 {x: 5.0, y: 6.0, z: 7.0}]"
// expect: stdout "[V3 {x: -9.0, y: -8.0, z: -7.0}, V3 {x: 3.0, y: 4.0, z: 5.0}]"
// expect: stdout "[V3 {x: 2.0, y: 4.0, z: 6.0}, V3 {x: 8.0, y: 10.0, z: 12.0}]"
// expect: stdout "<soa Vec3 [2]>"
// expect: exit 0
use std.{vec}

@packed struct V3 { x: f32; y: f32; z: f32 }

xs = [V3 { x: 1.0f32, y: 2.0f32, z: 3.0f32 }, V3 { x: 4.0f32, y: 5.0f32, z: 6.0f32 }]
ys = [V3 { x: 10.0f32, y: 10.0f32, z: 10.0f32 }, V3 { x: 1.0f32, y: 1.0f32, z: 1.0f32 }]

sx = vec.soa(xs)
sy = vec.soa(ys)

// count + the two reductions (the autovectorized win) → `List<f32>`.
echo vec.soa_count(sx)
echo vec.soa_dot(sx, sy) // [1·10+2·10+3·10, 4·1+5·1+6·1] = [60, 15]
echo vec.soa_length(vec.soa([V3 { x: 3.0f32, y: 4.0f32, z: 0.0f32 }, V3 { x: 5.0f32, y: 12.0f32, z: 0.0f32 }]))

// element-wise ops return a batch; `soa_list` transposes back to a packed `List<Vec3>`.
echo vec.soa_list(vec.soa_add(sx, sy))
echo vec.soa_list(vec.soa_sub(sx, sy))
echo vec.soa_list(vec.soa_scale(sx, 2.0f32))

// a batch displays as an opaque count summary.
echo sx
