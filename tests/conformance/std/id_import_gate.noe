// `next_id` is a `use std.id` import, not a prelude name (prelude-redesign P2c). It stays the
// deterministic counter (1, 2, 3, …) — host-owned since the id-entropy arc, so both import forms
// read the SAME counter through one registry dispatch (see `id_uuid.noe` for the UUID surface).
// expect: stdout "1"
// expect: stdout "2"
// expect: stdout "3"
// expect: exit 0
use std.id.{next_id}
use std.{id}

echo next_id()
echo next_id()
echo id.next_id()
