// The geometry kernels declare their operands, so a wrong one is a compile-time diagnostic naming
// the concrete implementor rather than a runtime shape complaint. A component-wise operand is
// `Self` (`cross`, `clamp`'s bounds, `distance`, `reflect`'s normal); an interpolation parameter is
// a plain number, so a whole vector in `t`'s place is refused too.
// expect: error E0007 at 18:6
// expect: error E0007 at 19:6
// expect: error E0007 at 20:6
// expect: error E0007 at 21:6
// expect: error E0007 at 22:6
// expect: exit 1
use std.{vec}

@packed struct V3 { x: f32; y: f32; z: f32 }
impl vec.Kernels for V3 {}

a = V3 { x: 1.0f32, y: 2.0f32, z: 3.0f32 }

echo a.cross(5)            // an int where the same shape is required
echo a.distance(1.0)       // a float where the same shape is required
echo a.lerp(a, a)          // a vector where an interpolation parameter is required
echo a.clamp(a, 1.0)       // a float bound where the same shape is required
echo a.reflect("up")       // a string where the same shape is required
