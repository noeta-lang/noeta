// std.crypto digests (crypto arc C2): sha256/sha512 plus the interop-only sha1/md5, and the
// keyed HMAC pair. Every expectation is a published vector (NIST FIPS 180 "abc", RFC 4231 case 2)
// or an independently generated hashlib value. Inputs are `string|bytes` — a string hashes as its
// UTF-8 bytes; a digest (bytes) feeds straight back in (double-sha256), and bytes key an HMAC.
// expect: stdout "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
// expect: stdout "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
// expect: stdout "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"
// expect: stdout "a9993e364706816aba3e25717850c26c9cd0d89d"
// expect: stdout "900150983cd24fb0d6963f7d28e17f72"
// expect: stdout "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
// expect: stdout "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737"
// expect: stdout "4f8b42c22dd3729b519ba6f68d2da7cc5b2d606d05daed5ad5128cc03e6c6358"
// expect: stdout "7a00af5df689885642dd8b09bfacd025cd2dbf92770787ab0436d763b94607e0"
// expect: stdout "32"
// expect: stdout "true"
// expect: exit 0
use std.{crypto}

echo crypto.sha256("abc").to_hex()
echo crypto.sha256("").to_hex()
echo crypto.sha512("abc").to_hex()
echo crypto.sha1("abc").to_hex()
echo crypto.md5("abc").to_hex()
echo crypto.hmac_sha256("Jefe", "what do ya want for nothing?").to_hex()
echo crypto.hmac_sha512("Jefe", "what do ya want for nothing?").to_hex()

// bytes input: a digest is bytes, so digests compose (double-sha256).
echo crypto.sha256(crypto.sha256("abc")).to_hex()

// bytes as the HMAC key.
echo crypto.hmac_sha256(crypto.sha256("k"), "msg").to_hex()

d = crypto.sha256("abc")
echo d.len()
echo d is bytes
