// std.http sync surface (http arc H2/H6): get/post/head/delete/request return
// `Result<Response, HttpError>` — a *transport* failure is the `Err`, so `?` on a request means
// exactly "the network broke". An HTTP error **status** is an ordinary `Ok(Response)` (see the 404
// below, which is `ok() == false`, not an `Err`). Under the sandbox every request is answered by
// the deterministic httpbin-style responder, so the differential pins exact bytes; under
// `noeta run` these hit the real network.
// expect: stdout "200"
// expect: stdout "true"
// expect: stdout "{"body":"","method":"GET","path":"/echo"}"
// expect: stdout "some(application/json)"
// expect: stdout "true"
// expect: stdout "{"body":"hi","method":"POST","path":"/echo"}"
// expect: stdout "404"
// expect: stdout "false"
// expect: stdout "noeta sandbox: GET /v1/data"
// expect: stdout "204"
// expect: stdout "none"
// expect: exit 0
use std.http.client
use std.http.Response

r = client.get("https://svc.test/echo")?
echo r.status()
echo r.ok()
echo r.body()
echo r.header("content-type")
echo r is Response

p = client.post("https://svc.test/echo", "hi")?
echo p.body()

// A 404 is an answer, not a broken network: it arrives as `Ok`, and `ok()` reports the status.
nf = client.get("https://svc.test/status/404")?
echo nf.status()
echo nf.ok()

echo client.get("https://api.example.com/v1/data")?.body()

echo client.request("delete", "https://svc.test/status/204")?.status()
echo client.head("https://svc.test/echo")?.header("x-missing")
