// P-SIMD (`plans/perf/p-simd-column-layout.md`): `@packed(layout: column)` declares a column-major
// (SoA) storage layout. Layout is a pure *performance* attribute — **invisible to behaviour** — so a
// `layout: column` struct behaves identically to a `row` one (C1 parses/validates the directive; the
// storage change lands in C2). This pins that equivalence: the same program on a column-layout type
// produces the same output a row-layout type would.
// expect: stdout "V3 {x: 1.0, y: 2.0, z: 3.0}"
// expect: stdout "5.0"
// expect: stdout "[5.0, 13.0]"
// expect: stdout "3"
// expect: exit 0
use std.{vec}

@packed(layout: column) struct V3 { x: f32; y: f32; z: f32 }

ps = [
  V3 { x: 1.0f32, y: 2.0f32, z: 3.0f32 },
  V3 { x: 3.0f32, y: 4.0f32, z: 0.0f32 },
  V3 { x: 5.0f32, y: 12.0f32, z: 0.0f32 },
]

echo ps[0]                    // per-element access
echo ps[1].y + ps[1].x - 2.0f32
echo vec.length_all([V3 { x: 3.0f32, y: 4.0f32, z: 0.0f32 }, V3 { x: 5.0f32, y: 12.0f32, z: 0.0f32 }])
echo ps.len()
