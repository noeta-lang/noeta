// The Ring 2 `env` module (use std.{env}): host environment introspection over the sandbox's
// fixed, deterministic fixture, so both backends agree by construction. `get` reads a value;
// `keys` is sorted.
// expect: stdout "/home/sandbox"
// expect: stdout "noeta"
// expect: stdout "[\"HOME\", \"USER\"]"
// expect: exit 0
use std.{env};

echo env.get("HOME") ?? "<unset>";
echo env.get("USER") ?? "<unset>";
echo env.keys();
