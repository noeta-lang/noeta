// Array-ops arc: the integer/`Color` bundle constraints reject a mismatched target at the `impl`
// site (E0015), the compile-time twin of the runtime shape check. `IntKernels` wants a UNIFORM
// vector of ≥2 `i32` fields — an f32 vector (wrong kind) and a 1-field struct (too few) are both
// rejected; `ColorKernels` wants EXACTLY 4 `u8` fields — a 3×u8 (wrong arity) and a 4×i32 (wrong
// kind) are both rejected.
// expect: error E0015 at 18:25
// expect: error E0015 at 19:25
// expect: error E0015 at 20:27
// expect: error E0015 at 21:27
// expect: exit 1
use std.{vec}

@packed struct FVec3 { x: f32; y: f32; z: f32 }
@packed struct One { x: i32 }
@packed struct RGB { r: u8; g: u8; b: u8 }
@packed struct IColor { r: i32; g: i32; b: i32; a: i32 }

impl vec.IntKernels for FVec3 {}
impl vec.IntKernels for One {}
impl vec.ColorKernels for RGB {}
impl vec.ColorKernels for IColor {}
