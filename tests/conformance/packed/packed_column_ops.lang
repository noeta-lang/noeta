// P-SIMD C2: the full breadth of list operations over a `@packed(layout: column)` list. Column-major
// (SoA) storage is a pure *performance* attribute — invisible to `RunResult` — so every op (index,
// field read, iteration, `set`, `~`/concat, `slice`/`reverse`/`filter`/`map`, `to_bytes`/`from_bytes`,
// nested-struct decode) yields exactly what the default row layout would. The differential pins the VM
// (column buffer) against the eval reference (also column), and the leak oracle pins residency 0.
// expect: stdout "[P {r: 255, g: 0, b: 128, opaque: true}, P {r: 1, g: 2, b: 3, opaque: false}, P {r: 7, g: 8, b: 9, opaque: true}]"
// expect: stdout "P {r: 1, g: 2, b: 3, opaque: false}"
// expect: stdout "9"
// expect: stdout "true"
// expect: stdout "263"
// expect: stdout "[255, 1, 7]"
// expect: stdout "2"
// expect: stdout "[P {r: 1, g: 2, b: 3, opaque: false}, P {r: 7, g: 8, b: 9, opaque: true}]"
// expect: stdout "[P {r: 7, g: 8, b: 9, opaque: true}, P {r: 1, g: 2, b: 3, opaque: false}, P {r: 255, g: 0, b: 128, opaque: true}]"
// expect: stdout "[P {r: 255, g: 0, b: 128, opaque: true}, P {r: 9, g: 9, b: 9, opaque: false}, P {r: 7, g: 8, b: 9, opaque: true}]"
// expect: stdout "[P {r: 255, g: 0, b: 128, opaque: true}, P {r: 1, g: 2, b: 3, opaque: false}, P {r: 7, g: 8, b: 9, opaque: true}, P {r: 4, g: 5, b: 6, opaque: false}]"
// expect: stdout "true"
// expect: stdout "2"
// expect: stdout "5.0"
// expect: stdout "2.0"
// expect: stdout "V3 {x: 0.0, y: 0.0, z: 0.0}"
// expect: exit 0
@packed(layout: column) struct P { r: int; g: int; b: int; opaque: bool }
@packed(layout: column) struct V3 { x: f32; y: f32; z: f32 }
@packed(layout: column) struct Seg { start: V3; end: V3 }

// Mixed-kind columns (three 8-byte `int` columns + a 1-byte `bool` column) stress the per-field
// column-offset math (`field_offset`) with non-uniform widths.
ps = [P { r: 255, g: 0, b: 128, opaque: true }, P { r: 1, g: 2, b: 3, opaque: false }, P { r: 7, g: 8, b: 9, opaque: true }]
echo ps                        // whole-list materialize (gather every element from its columns)
echo ps[1]                     // per-element gather
echo ps[2].b                   // fused single-column field read
echo ps[0].opaque              // the 1-byte bool column

mut total = 0
for p in ps {
  total = total + p.r          // iteration materializes each element
}
echo total                     // 255 + 1 + 7

echo map(ps, fn(p) => p.r)     // demote-to-boxed producer
echo filter(ps, fn(p) => p.opaque).count()
echo ps.slice(1, 3)            // packed_select over columns
echo ps.reverse()              // packed_select over columns
echo ps.set(1, P { r: 9, g: 9, b: 9, opaque: false })
echo ps ~ [P { r: 4, g: 5, b: 6, opaque: false }]   // column concat (O(n) rebuild)

// `to_bytes`/`from_bytes` round-trip on a column buffer: the raw bytes are column-order, but the
// round-trip is self-consistent (schema carries the layout), so the reconstructed list equals the
// original element-for-element.
xs = [V3 { x: 1.0f32, y: 2.0f32, z: 3.0f32 }, V3 { x: 4.0f32, y: 5.0f32, z: 6.0f32 }]
ys = from_bytes::<V3>(xs.to_bytes())
echo ys == xs
echo ys.count()
echo ys[1].y

// A nested `@packed` field inside a column struct: the nested `V3` stays a contiguous per-element
// chunk (C2 keeps nested structs row-order; leaf-flattening is C5), decoded correctly through columns.
segs = [Seg { start: V3 { x: 0.0f32, y: 0.0f32, z: 0.0f32 }, end: V3 { x: 1.0f32, y: 2.0f32, z: 2.0f32 } }]
echo segs[0].end.z
echo segs[0].start
