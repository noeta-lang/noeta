// std.telemetry T2: the scoped `with_span(name, body)` form (Class-2 `ctx.call`) returns the body's
// value, and nests — a span opened inside a `with_span` body is implicitly parented on it. Parenting
// is observed through `current_context()` (the active span's W3C traceparent): the inner and outer
// spans share a trace id but have distinct span ids. Deterministic sandbox ids, so both backends
// print identically.
// expect: stdout "42"
// expect: stdout "true"
// expect: stdout "false"
// expect: stdout "done"
// expect: exit 0
use std.{telemetry}

// with_span returns whatever the body returns.
compute = fn(): int {
    return 21 + 21
}
echo telemetry.with_span("compute", compute)

// The inner body reports the active context (the inner span) from inside the nesting.
inner_body = fn(): string {
    return telemetry.current_context()
}

outer_body = fn(): int {
    outer = telemetry.current_context()
    inner = telemetry.with_span("inner", inner_body)
    op = outer.split("-")
    ip = inner.split("-")
    echo op[1] == ip[1]   // same trace id
    echo op[2] == ip[2]   // distinct span id
    return 0
}
telemetry.with_span("outer", outer_body)

echo "done"
