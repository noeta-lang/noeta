// A library module: an exported fn's dependencies must travel with it when imported. The consumer
// (main.noe) imports only `twice` and `origin`, but each references same-module declarations it
// needs — a NON-pub internal helper it calls, and a module-local type it returns — which the
// cross-module linker's reachability closure drags into the merged program.
namespace App.Lib;

// A non-pub internal helper: not importable directly, only reachable through `twice`.
fn scale(n: int): int {
    return n * 2;
}

pub fn twice(n: int): int {
    return scale(n);
}

// A module-local type an exported fn returns. `Point` is not `pub` — it is reachable only because
// `origin` references it, so it must still be merged (an intra-module reference is not gated by
// visibility). Its fields are `pub` so the consumer can read the returned value.
struct Point {
    pub x: int
    pub y: int
    pub total: int
}

// A second internal helper, referenced by `origin` — proving the closure runs to a fixpoint (the
// pulled `origin` references `build`, which references `Point`).
fn build(x: int, y: int): Point {
    return Point { x: x, y: y, total: x + y };
}

pub fn origin(): Point {
    return build(4, 5);
}
