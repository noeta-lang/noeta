// Qualified references REQUIRE an import: a spelled-out FQN with no `use` bringing the module (or
// item) in is a targeted error carrying the exact import to add — never a silent implicit import,
// so a file's dependency set stays fully readable from its `use` block.
// expect: error E0019 at 8:5
// expect: exit 1
namespace App.Main;

a = geometry.vec.Vec2 { x: 1, y: 2 };
echo a.x;
