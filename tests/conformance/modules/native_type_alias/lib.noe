// A library module that renames a native type it imports. The alias is the whole point: two
// packages can export the same short name, and `as` is how a file that needs both tells them apart.
namespace probe.lib

use std.http.Framing as F

pub fn sse(): F {
    return F.Sse
}

pub fn name(f: F): string {
    return match f {
        F.Sse => "sse",
        _ => "other",
    }
}

pub fn is_framing(v: dyn): bool {
    return v is F
}
