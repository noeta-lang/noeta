// A namespaced module's own types get qualified identities, but the native `Uuid` it imports stays
// bare and is resolved through the Phase-A extern path — the two identity models coexist within one
// module. `Record.id: Uuid` is a native field type; `Marker` gets its `==` from an inline
// `impl Equatable { fn eq … }` (a built-in trait's methods live in the type's own body), whose target
// is a namespaced type — qualified by the linker like any ref and carried cross-module with the type.
use std.id.Uuid;

pub struct Record {
    id: Uuid
    tag: int
}

pub struct Marker {
    n: int

    impl Equatable {
        fn eq(other: Marker): bool {
            return self.n == other.n
        }
    }
}
