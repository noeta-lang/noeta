// A bare fully-qualified reference is its own import: with ZERO `use` statements, anything under a
// loaded module's namespace is addressable by spelling out its FQN — literal heads, annotations,
// calls, enum construction/patterns, and first-class fn values. The linker's implicit-import pass
// merges each referenced `pub` declaration exactly as an explicit `use` would (same closure, same
// dedup), and the QMap's identity keys collapse the chains.
// expect: stdout "4,6"
// expect: stdout "7"
// expect: stdout "5,8"
// expect: exit 0
namespace App.Main;

a = geometry.vec.Vec2 { x: 1, y: 2 };
b: geometry.vec.Vec2 = geometry.vec.Vec2 { x: 3, y: 4 };
c = geometry.vec.add(a, b);
echo "${c.x},${c.y}";

s = geometry.vec.Shape.Circle(7);
r = match s {
    geometry.vec.Shape.Circle(radius) => radius,
    _ => 0,
};
echo r;

f = geometry.vec.add;
d = f(c, a);
echo "${d.x},${d.y}";
