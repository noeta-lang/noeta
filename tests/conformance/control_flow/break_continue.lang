// `break` exits the innermost loop; `continue` skips to its next iteration. Both work in `for` and
// `while`, including from inside a nested `if`. In a `for`, `continue` still advances the iterator;
// in a `while`, it re-tests the condition. Both backends agree (the VM patches the jump targets).
// expect: stdout "0 1 2 "
// expect: stdout "0 1 3 4 "
// expect: stdout "1 3 4 "
// expect: exit 0
mut a = "";
for i in 0..10 {
    if i == 3 { break; }
    a = a ~ i ~ " ";
}
echo a;

mut b = "";
for i in 0..5 {
    if i == 2 { continue; }
    b = b ~ i ~ " ";
}
echo b;

mut c = "";
mut n = 0;
while n < 100 {
    n += 1;
    if n == 2 { continue; }
    if n == 5 { break; }
    c = c ~ n ~ " ";
}
echo c;
