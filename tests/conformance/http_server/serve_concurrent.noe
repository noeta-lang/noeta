// server.serve concurrent dispatch (http-server S3b): an async handler suspends at its `await`, so
// every scripted connection is accepted and in flight — each prints "handling" — *before* any
// completes and prints "done". A serial server would print handling/done paired per request; here
// every handler starts before the first deadline elapses, then they resume in deadline order.
//
// Each handler takes the NEXT deadline, 100 ms after the one before it, so the order the eight
// resume in is a property of the program. Eight equal sleeps come due at the same poll on a real
// host, where the executor sleeps real time to the earliest deadline and wakes late, and the eight
// then resume in whatever order the scheduler holds them — which this header pins and cannot.
// expect: stdout "handling GET /"
// expect: stdout "handling GET /health"
// expect: stdout "handling POST /echo"
// expect: stdout "handling GET /users/42"
// expect: stdout "handling DELETE /users/42"
// expect: stdout "handling POST /form"
// expect: stdout "handling GET /ws"
// expect: stdout "handling GET /events"
// expect: stdout "done GET /"
// expect: stdout "done GET /health"
// expect: stdout "done POST /echo"
// expect: stdout "done GET /users/42"
// expect: stdout "done DELETE /users/42"
// expect: stdout "done POST /form"
// expect: stdout "done GET /ws"
// expect: stdout "done GET /events"
// expect: stdout "served"
// expect: exit 0
use std.http.server
use std.http.{Request, Response}
use std.task.{sleep}

// Handed out before each handler's first `await`, so the deadlines are assigned in the order the
// loop reaps the handlers rather than in the order they happen to finish.
mut next_ms = 0

async fn handle(req: Request) use (next_ms): Response {
    line = "${req.method()} ${req.path()}"
    next_ms = next_ms + 100
    ms = next_ms
    echo "handling ${line}"
    sleep(ms).await
    echo "done ${line}"
    return server.response(200, "ok")
}

server.serve(8080, handle)
echo "served"
