// `server.sse` (http-streaming arc) — the write side, and `server.websocket`'s exact twin: a
// `fetch` handler returns it, the connection leaves one-reply-and-close for a held-open
// `text/event-stream` response, and `handler(sink)` runs as the session. The stream closes when
// the session returns, and the serve loop reaps it like any other handler.
//
// The handler keeps ONE `(Request) -> Response` signature whether it answers with a body, a
// socket, or an event stream — which is the reason the upgrade is a `Response` value rather than a
// second handler shape.
//
// Unlike a websocket there is no handshake and no client opt-in: SSE is an ordinary HTTP response
// whose body never ends, so the scripted `GET /events` carries only an `accept` header, and a
// handler that ignores the path would serve it as a plain GET.
// expect: stdout "GET /"
// expect: stdout "GET /health"
// expect: stdout "POST /echo"
// expect: stdout "GET /users/42"
// expect: stdout "DELETE /users/42"
// expect: stdout "POST /form"
// expect: stdout "GET /ws"
// expect: stdout "sse session open"
// expect: stdout "sse sent 3 frames and a heartbeat"
// expect: stdout "served"
// expect: exit 0
use std.http.server
use std.http.{Request, Response, SseSink, Frame}

async fn events(sink: SseSink): bool {
    echo "sse session open"
    // A named frame, a bare-data frame, and one carrying the reconnection hint — the three shapes
    // a real event stream mixes.
    sink.send(Frame { event: "start", data: "go", id: "1", retry: none })
    sink.send(Frame { event: "", data: "tick", id: "", retry: none })
    // The keepalive: bytes on the wire that dispatch no event, so an idle stream is not reaped.
    sink.comment("keepalive")
    sink.send(Frame { event: "end", data: "done", id: "2", retry: some(1500) })
    echo "sse sent 3 frames and a heartbeat"
    return true
}

fn fetch(req: Request): Response {
    if req.path() == "/events" {
        return server.sse(events)
    }
    echo "${req.method()} ${req.path()}"
    return server.response(200, "ok")
}

server.serve(8080, fetch)
echo "served"
