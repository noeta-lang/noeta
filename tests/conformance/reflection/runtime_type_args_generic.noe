// Runtime type-argument reflection for **generic user types** (R2): a generic `struct`/`class`
// instance carries the checker-resolved type arguments as a runtime tag, so `type_of` recovers them
// even after the value's static type is laundered through `dyn`. A **direct** literal whose argument
// the checker infers concretely (`Box { value: 5 }` → `Box<int>`) recovers that argument; a value
// built through a **generic constructor** (`Holder.new(3)`) recovers the argument the CALL resolved,
// which is the one the constructor body could not see; a **non-generic** type reflects head-only
// (its shape name, no args). Both backends carry the tag identically, so `type_of` agrees.
//
// The constructor line used to read `Holder<dyn>`: inside `fn new` the literal's type is `Holder<T>`
// with `T` still a parameter, so nothing concrete was recorded and every instantiation reflected
// alike. The instantiation is known one frame up, so the call site stamps it — but only onto a
// value the checker proved that very call builds fresh (see `generics/`), and only when the call
// resolved every argument concretely. The last two `Holder` lines pin both limits, because both are
// the difference between a recovered fact and an invented one.
// expect: stdout "Box<int>"
// expect: stdout "Box<string>"
// expect: stdout "Box<list<int>>"
// expect: stdout "Holder<int>"
// expect: stdout "Holder<int>"
// expect: stdout "Holder<dyn>"
// expect: stdout "Holder<int>"
// expect: stdout "Point<>"
// expect: stdout "true"
// expect: exit 0

struct Box<T> { value: T }
class Holder<T> {
    pub item: T
    fn new(x: T): Holder<T> { return Holder { item: x }; }
    // NOT a fresh constructor: it hands back a value it was given. Its call sites must not stamp
    // their instantiation onto it — that object belongs to whoever built it.
    fn same(h: Holder<T>): Holder<T> { return h; }
}
struct Point { x: int }

fn label(t: Type): string {
    return match t {
        Type.Int => "int",
        Type.String => "string",
        Type.Dyn => "dyn",
        Type.List(inner) => "list<${label(inner)}>",
        Type.Struct(name, args) => "${name}<${arglabel(args)}>",
        Type.Class(name, args) => "${name}<${arglabel(args)}>",
        _ => "?",
    };
}

// Label the single type argument (every case here is a one-parameter generic), or empty for none.
fn arglabel(args: List<Type>): string {
    return if args.len() == 0 then "" else label(args[0]);
}

fn launder(v: dyn): dyn { return v; }

// A direct generic literal: the checker infers the concrete argument from the field value.
echo label(type_of(launder(Box { value: 5 })));        // Box<int>
echo label(type_of(launder(Box { value: "s" })));      // Box<string>
echo label(type_of(launder(Box { value: [1, 2] })));   // Box<list<int>> (nested)

// A direct class literal (argument annotated on the binding).
h: Holder<int> = Holder { item: 7 };
echo label(type_of(launder(h)));                       // Holder<int>

// Built through a generic constructor: the argument the CALL resolved reaches the object, which is
// exactly what the literal inside `new` could not know.
echo label(type_of(launder(Holder.new(3))));           // Holder<int>

// …but only a genuinely concrete one. `T` binding to `dyn` is not a type argument to record, so the
// value keeps the erased tag its literal carried rather than claiming a `dyn` instantiation.
open: dyn = 5;
echo label(type_of(launder(Holder.new(open))));        // Holder<dyn>

// …and only onto a value the call itself built. `same` returns its argument, so `h`'s own tag must
// survive being passed through it at a different (here `dyn`) instantiation — a stamp here would
// rewrite a fact about someone else's object.
passed: Holder<dyn> = Holder.same(h);
echo label(type_of(launder(passed)));                  // Holder<int>

// A non-generic type reflects head-only (shape name, no arguments).
echo label(type_of(launder(Point { x: 1 })));          // Point<>

// The tag is invisible to value semantics: two equal generic structs compare equal.
echo Box { value: 5 } == Box { value: 5 };             // true
