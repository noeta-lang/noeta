// Attributes — and therefore roles — are records only, so `@role(...)` on a class is a checker
// misplacement (E0054), the one code every misplaced directive reports.
// expect: error E0054 at 6:7
// expect: exit 1
@role(Semantic.EntryPoint)
class Service {
    name: string
    fn new(n: string): Service { return Service { name: n }; }
}
