// `type_of(value)` returns the prelude `Type` ADT — the runtime *head constructor* of a value,
// pattern-matchable like any enum. Generics are erased at runtime, so a list's element type is
// `Dyn` (fidelity B). Both backends build the `Type` value from the shared `TypeRepr` descriptor,
// so they agree by construction.
// expect: stdout "int"
// expect: stdout "string"
// expect: stdout "bool"
// expect: stdout "list"
// expect: stdout "Point"
// expect: stdout "option"
// expect: stdout "int"
// expect: exit 0
type Point = { x: int };

fn label(t: Type): string {
    return match t {
        Type.Int => "int",
        Type.String => "string",
        Type.Bool => "bool",
        Type.List(_) => "list",
        Type.Option(_) => "option",
        Type.Record(name, _) => name,
        Type.Enum(name, _) => name,
        Type.Class(name, _) => name,
        Type.Named(name, _) => name,
        _ => "other",
    };
}

echo label(type_of(5));
echo label(type_of("hi"));
echo label(type_of(true));
echo label(type_of([1, 2, 3]));
echo label(type_of(Point { x: 1 }));
echo label(type_of(some(7)));

// The list literal's element type is statically known, so it is recovered (fidelity A, P2.3):
// `type_of([1, 2, 3])` is `Type.List(Type.Int)`, not `List(Dyn)`. (The `dyn`-operand fallback to
// the erased `List(Dyn)` is exercised in `type_of_static_fidelity.lang`.)
elem = match type_of([1, 2, 3]) {
    Type.List(inner) => match inner { Type.Int => "int", _ => "?" },
    _ => "?",
};
echo elem;
