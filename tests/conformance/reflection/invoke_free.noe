// `invoke(name, args)` — the two-argument form of the by-name invocation primitive, dispatching a
// **top-level function**. The three-argument form takes a receiver and reaches a type's methods; a
// free function belongs to no type, so before this it could be reflected but not called:
// `params_of("greet")` already worked, `invoke(greet, "call", […])` did not. That asymmetry is what
// forced a reflection-driven framework to park every handler on a registered struct.
//
// The arities never collide: `invoke` is keyword-led and fixed-arity, so two-vs-three operands is a
// comma count decided at parse time, and no operand is a receiver in one reading and a name in the
// other.
//
// The namespace is the **top-level function namespace only** — the same string that keys
// `params_of` for a free fn, and the same binding a direct `greet(…)` call compiles to. It is not
// searched in any order against anything else: a local variable, a type name, and a qualified
// `Type.method` are all simply not top-level functions, so each is the same miss. That is what lets
// the two backends agree, since they index the top level with different structures (a scope map that
// holds types alongside functions vs. a global slot table that holds neither types nor locals).
//
// Every resolution failure is a `Result.Err`, never an abort — unknown name, non-string name,
// non-list args, and arity mismatch alike — exactly as the three-argument form behaves.
// expect: stdout "hi ada"
// expect: stdout "default=hi stranger"
// expect: stdout "sealed=7"
// expect: stdout "miss"
// expect: stdout "arity"
// expect: stdout "notstr"
// expect: stdout "notlist"
// expect: stdout "type-is-not-a-fn"
// expect: stdout "qualified-needs-a-receiver"
// expect: stdout "local-is-not-global"
// expect: exit 0

class Shape {
    w: int
    fn new(w: int): Shape { return Shape { w: w } }
    fn area(): int { return self.w }
}

fn greet(n: string = "stranger"): string { return "hi ${n}" }

fn helper(): int { return 7 }

// A free fn reached by name is called through the ordinary path, so it gets its usual SEALED child
// scope: it sees its parameters and top-level declarations (`helper` below), and nothing else. There
// is no separate "reflective" calling convention that could widen or narrow what a body can reach.
fn sealed_check(): int { return helper() }

// The basic dispatch: name in, `Ok(return value)` out.
echo match invoke("greet", ["ada"]) {
    Ok(v) => v,
    Err(e) => "err=${e}",
};

// A defaulted parameter may be omitted, exactly as at a direct call site — the arity window is
// `required..=total`, not a single number. This is the pair to `ParamInfo.optional`: reflection says
// the parameter may be skipped, and the reflective call is allowed to skip it.
echo match invoke("greet", []) {
    Ok(v) => "default=${v}",
    Err(e) => "err=${e}",
};

echo match invoke("sealed_check", []) {
    Ok(v) => "sealed=${v}",
    Err(e) => "err=${e}",
};

// An unbound name → Err.
echo match invoke("nope", []) {
    Ok(_) => "ok",
    Err(_) => "miss",
};

// Too many arguments → Err (`greet` tops out at one).
echo match invoke("greet", ["a", "b"]) {
    Ok(_) => "ok",
    Err(_) => "arity",
};

// A non-string name → Err; the name is resolved at run time, so its type is checked there.
echo match invoke(42, []) {
    Ok(_) => "ok",
    Err(_) => "notstr",
};

// Non-list args → Err.
echo match invoke("greet", 1) {
    Ok(_) => "ok",
    Err(_) => "notlist",
};

// A TYPE name is not a top-level function. Types and functions do not share this namespace, so no
// precedence rule is needed — `Shape` is simply not found, and the three-argument form remains the
// only way to reach a type.
echo match invoke("Shape", [1]) {
    Ok(_) => "ok",
    Err(_) => "type-is-not-a-fn",
};

// Nor is a qualified `Type.method` string: `params_of` accepts one, but dispatching it needs a
// receiver, so the two-argument form declines it rather than inventing one.
echo match invoke("Shape.area", []) {
    Ok(_) => "ok",
    Err(_) => "qualified-needs-a-receiver",
};

// A LOCAL binding holding a function is not reachable by name either — only top-level functions are.
// Pinned because the two backends could easily disagree here: the tree-walker's scope chain would
// find `local` on a naive lookup, while the VM's global slot table never would. A local function
// value needs no reflection anyway; it is already in hand, so `local()` calls it directly.
fn shadow_probe(): string {
    local = fn(): int => 1;
    return match invoke("local", []) {
        Ok(_) => "ok",
        Err(_) => "local-is-not-global",
    };
}
echo shadow_probe();
