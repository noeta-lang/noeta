// Reflecting over a **forwarded type parameter** answers with the instantiation, not with an error.
//
// These queries are keyed on a type NAME, and a type parameter has no name in the *body*: generics
// are erased, so one compiled body serves every instantiation. What the body does have is a
// per-instantiation channel — for a top-level generic `fn`, the hidden type-argument slot that
// already carries `json.try_parse::<T>`'s decode recipe (poly-values F2b), of which these surfaces
// read only the NAME. `type_name::<T>()` has read it since 0.3; these three had not, and rejected
// the spelling with E0058 while pointing the author at `field_specs_of(type_name::<T>())` — a
// composition that already worked, which is what proved the capability was there all along. The
// turbofish arm now takes that route itself: `field_specs_of::<T>()` IS
// `field_specs_of(type_name::<T>())`, lowered through the surface's own dynamic arm, no new opcode.
//
// All three are pinned together so they cannot drift apart, and each is called at two different
// instantiations from ONE body — answering differently per call is the whole point of the channel.
// expect: stdout "fields Todo: 2"
// expect: stdout "fields User: 1"
// expect: stdout "variants Color: 2"
// expect: stdout "variants Status: 3"
// expect: stdout "built: Todo {id: 7, title: \"write it\"}"
// expect: stdout "built: User {name: \"ada\"}"
// expect: stdout "agrees: true"
// expect: exit 0
struct Todo {
    id: int
    title: string
}
struct User {
    name: string
}
enum Color {
    Red
    Blue
}
enum Status {
    Draft
    Live
    Gone
}

fn count_of<T>(): int { return field_specs_of::<T>().len() }

fn cases_of<T>(): int { return variants_of::<T>().len() }

fn build_a<T>(fields: List<dyn>): Result<dyn, string> { return construct::<T>(fields) }

// The composition the old E0058 help prescribed. It still works, and it must answer *identically* —
// the turbofish arm lowers to exactly this, so a divergence here means the two arms have drifted.
fn count_by_name<T>(): int { return field_specs_of(type_name::<T>()).len() }

echo "fields Todo: ${count_of::<Todo>()}"
echo "fields User: ${count_of::<User>()}"
echo "variants Color: ${cases_of::<Color>()}"
echo "variants Status: ${cases_of::<Status>()}"

match build_a::<Todo>([7, "write it"]) {
    Ok(v) => { echo "built: ${v}" },
    Err(e) => { echo "err: ${e}" },
}
match build_a::<User>(["ada"]) {
    Ok(v) => { echo "built: ${v}" },
    Err(e) => { echo "err: ${e}" },
}

echo "agrees: ${count_of::<Todo>() == count_by_name::<Todo>()}"
