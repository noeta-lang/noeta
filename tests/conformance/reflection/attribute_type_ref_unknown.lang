// A bare name in attribute position is a type reference, so it must name a real type; an unknown
// name is a checker error (E0013) — `Enum.Variant` is the spelling for an enum value.
// expect: error E0013 at 8:10
// expect: exit 1
@attribute
type Encode = { codec: Type };

#[Encode(codec: Nonexistent)]
type Payload = { id: int };
