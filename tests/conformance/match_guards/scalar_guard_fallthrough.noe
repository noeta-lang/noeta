// A match arm may carry a guard: `pattern if cond => body`. The guard is evaluated only after
// the pattern structurally matches, with the pattern's bindings in scope; a false guard falls
// through to the next arm exactly as a failed pattern would.
// expect: stdout "neg"
// expect: stdout "zero"
// expect: stdout "small"
// expect: stdout "big"
// expect: exit 0
fn classify(n: int): string {
    return match n {
        k if k < 0 => "neg",
        0 => "zero",
        k if k < 100 => "small",
        _ => "big",
    };
}

echo classify(-5);
echo classify(0);
echo classify(3);
echo classify(250);
