// Generic records (`struct Pair<A, B>`) and generic enums (`enum Opt<T>`) parse, check, and run
// with their type parameters erased. Identical under both backends.
// expect: stdout "1"
// expect: stdout "x"
// expect: stdout "7"
// expect: stdout "empty"
// expect: exit 0
struct Pair<A, B> { first: A second: B }
enum Opt<T> { None; Some(value: T); }

p = Pair { first: 1, second: "x" };
echo p.first;
echo p.second;
echo match Opt.Some(7) { Opt.None => 0, Opt.Some(n) => n };
echo match Opt.None { Opt.None => "empty", Opt.Some(n) => "some" };
