// A generic container keeps its element type through the instance: `Box<int>` constructed by
// `Box.new(42)` knows `b.get()` is `int`, so passing it where an `int` is expected type-checks and
// runs — precise generic-container typing rather than `dyn` erasure. Identical on both backends.
// expect: stdout "42"
// expect: exit 0
class Box<T> {
    value: T
    fn new(v: T): Box<T> { return Box { value: v }; }
    fn get(): T { return self.value; }
}
fn need_int(n: int): int { return n; }
b = Box.new(42);
echo need_int(b.get());
