// The instantiation is genuinely unknowable here: `Repo.new("todos")` binds no `T` (no argument
// mentions it and the binding carries no annotation), so nothing records one on the object. The
// method's `type_name::<T>()` then **aborts** with a message naming the type and the parameter,
// rather than answering `"dyn"` or the empty string.
//
// The abort is the point. This surface exists to hand a NAME to something that keys on it — a
// table, a route, a decoder — so a plausible-looking wrong name would travel silently and fail
// somewhere else entirely. The construction site is where the fix belongs, and the message says so.
// The two backends share one message (`noeta_ast::reflect::missing_type_arg_message`), so they
// cannot word it differently.
// expect: error E0058 at 24:33
// expect: exit 1
struct Todo {
    id: int
}
class Repo<T> {
    pub tbl: string

    fn new(tbl: string): Repo<T> {
        return Repo { tbl: tbl };
    }

    fn model(): string {
        return self.tbl ~ ":" ~ type_name::<T>();
    }
}
r = Repo.new("todos");
echo r.model();
