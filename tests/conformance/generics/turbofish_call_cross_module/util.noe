// The declaring module. Both functions are `app.util.*` after qualification; `indirect` reaches
// `pick` through a turbofish call, so the linker's same-module reference graph only drags `pick`
// into the merged program if that callee name is visited by the qualification walk.
namespace app.util

pub struct Tag { pub id: int }

pub fn pick<T>(x: int): int { return x }

pub fn indirect(): int { return pick::<Tag>(9) }
