// P-PACK Phase 3 + P-NUM-SYM: `f32` is a distinct 32-bit float primitive, written with the `f32`
// literal suffix (`1.0f32`, `5f32`). It is a **strict fixed-width** type: arithmetic and comparison
// require both operands to be `f32` — no implicit widening with `int` or `float` (that is `E0044`,
// convert explicitly), exactly like the fixed-width integers. Its observable precision differs from
// `float` (f64), so `0.1f32 + 0.2f32` is `0.3` where `0.1 + 0.2` is `0.30000000000000004`. The two
// backends must agree (the differential pins eval against the VM); display is f32 formatting.
// expect: stdout "3.5"
// expect: stdout "3.0"
// expect: stdout "-0.5"
// expect: stdout "1.3333334"
// expect: stdout "1.5"
// expect: stdout "2.5"
// expect: stdout "3.0"
// expect: stdout "2.5"
// expect: stdout "0.3"
// expect: stdout "0.30000000000000004"
// expect: stdout "true"
// expect: stdout "true"
// expect: stdout "5.0"
// expect: stdout "6.0"
// expect: stdout "-2.0"
// expect: exit 0
x = 1.5f32
y = 2.0f32
echo x + y
echo x * y
echo x - y
echo y / x
echo x
// Mixing with `int`/`float` is strict — convert explicitly at the boundary.
echo x + 1.0f32
echo 2.0f32 * x
echo x.to_float() + 1.0
echo 0.1f32 + 0.2f32
echo 0.1 + 0.2
echo 1.0f32 == 1.0f32
echo 2.5f32 < 3.0f32
echo 5f32
mut s = 0.0f32
for i in 0..4 {
  s = s + 1.5f32
}
echo s
// Unary negation of an f32 stays an f32.
echo -y
