// The positions a `u64`'s signedness does NOT reach, pinned so they stay deliberate. Every one of
// them renders the erased i64 word — `18446744073709551615` read back as `-1` — and every one of
// them is a position where nothing the value or the program carries says which width it had.
//
// A `dyn` is the original of the rule: a value laundered through it has no static type at all, so
// there is nothing to take a signedness from. The rest are the same rule met through a generic:
//
//   * a `dyn` local inside a generic body, which erases the parameter it was assigned from;
//   * a generic type's method reached through an instance whose **tag** was written where the
//     instantiation was not known — a literal inside a plain generic `fn` types as `Holder<T>`,
//     and `T` is erased to `dyn` there, so the object records `Holder<dyn>` and its methods read
//     the argument back as nothing. (A construction site that DOES know the instantiation — a
//     written literal, or a fresh constructor called on the type — stamps it, and those methods
//     render the number: see `unsigned_through_type_param.noe`.)
//   * a generic function used as a **value** with nothing to pin its instantiation, where the
//     erased signature is the honest answer and the wrapper carries no width either.
//
// The last of those is what makes the whole channel safe to add: a call that cannot name its
// instantiation degrades to this reading rather than refusing the program.
// expect: stdout "-1"
// expect: stdout "-1"
// expect: stdout "-1"
// expect: stdout "-1"
// expect: stdout "-1"
// expect: exit 0
use std.json

class Holder<T> {
    pub v: T

    pub fn show(): string {
        return "${self.v}";
    }

    pub fn wrap(): string {
        return json.stringify(self.v);
    }
}

fn show<T>(v: T): string {
    return "${v}";
}

fn launder<T>(v: T): string {
    d: dyn = v;
    return "${d}";
}

fn hold<T>(v: T): Holder<T> {
    return Holder { v: v };
}

big: u64 = 18446744073709551615u64;

// A `dyn` at the door, and a `dyn` reached from inside a generic body.
d: dyn = big;
echo "${d}";
echo launder(big);

// A generic type's methods, on an instance built where the instantiation was a type parameter:
// the tag says `Holder<dyn>`, so the receiver channel has nothing to hand the door.
h: Holder<u64> = hold(big);
echo h.show();
echo h.wrap();

// The generic function as a bare value: nothing pins the instantiation, so the wrapper carries
// none. It is still callable — a render slot never refuses a program.
f = show;
echo f(big);
