// A fixed-width element type flows through a field-held collection inside a method. `self.words` is
// `List<u64>`, so `self.words[i]` is `u64` and a following `>> & |` chain stays `u64` (rather than
// collapsing to `int` — which happened before `self` was typed as its class, so `self.words` had
// erased to `List<dyn>`). This pins the checker's precise `self.field` typing against the fixed-width
// operator rules. Both backends agree.
// expect: stdout "5"
// expect: stdout "true"
// expect: stdout "3"
// expect: exit 0
struct Words {
    mut data: List<u64>
    // `self.data[i]` is u64; the whole expression is u64 arithmetic/bitwise, no explicit conversion.
    fn masked(i: int): u64 { return self.data[i] & 7u64; }
    fn bit(i: int, b: int): bool { return (self.data[i] >> b) & 1u64 == 1u64; }
    fn popcount(i: int): int { return self.data[i].count_ones(); }
}

w = Words { data: [13u64, 0u64] };   // 13 = 0b1101
echo w.masked(0);   // 13 & 7 = 5
echo w.bit(0, 2);   // bit 2 of 0b1101 is 1 -> true
echo w.popcount(0); // 13 = 0b1101 -> 3 set bits
