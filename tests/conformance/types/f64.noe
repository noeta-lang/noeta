// P-NUM-SYM: `f64` is the strict fixed-width 64-bit float — the float twin of `i64`. It is
// bit-identical to `float` at runtime (both IEEE f64), so it displays and computes identically; the
// only difference is coercion. It has two literal forms, mirroring `i64`: a bare float literal
// adapts into an `f64` context (`mut x: f64 = 1.5`), and an explicit `1.5f64` suffix works anywhere
// (expression position included). `to_f64()` also produces one. Arithmetic and comparison are strict
// (same-type-only), so mixing with `int`/`float`/`f32` is `E0044`. The differential pins eval vs VM.
// expect: stdout "3.5"
// expect: stdout "3.0"
// expect: stdout "-0.5"
// expect: stdout "0.75"
// expect: stdout "0.30000000000000004"
// expect: stdout "true"
// expect: stdout "false"
// expect: stdout "6.0"
// expect: stdout "-2.0"
// expect: exit 0
mut x: f64 = 1.5
mut y: f64 = 2.0
echo x + y
echo x * y
echo x - y
echo x / y
// The explicit `f64` suffix carries the type in expression position — f64 shares float's full
// 64-bit precision (unlike f32's rounded 0.3).
echo 0.1f64 + 0.2f64
echo x < y
echo x == y
// Interop with `int`/`float` is strict — convert explicitly.
echo x.to_float() + 4.5
mut s: f64 = 0.0
for i in 0..4 {
  s = s - 0.5f64
}
echo s
