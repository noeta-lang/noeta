// The abstract kinds are distinct: a record is not an enum, so passing a record value where an
// `Enum` is expected is a type error (E0007). (A class is likewise not a `Record`.)
// expect: error E0007 at 10:6
// expect: exit 1
type Point = { x: int };

fn take(e: Enum): int { return 1; }

x = Point { x: 1 };
echo take(x);
