// A method reaching a type through a STANDALONE `impl Trait for T { … }` is argument-checked like
// one written in the type's own body. It used not to be: the loader hoists standalone-impl methods
// onto the target so dispatch worked, but their signatures never reached the checker, so this call
// typed as a hole — it checked clean, ran, and printed `false` from comparing an `int` to a
// `string`. A wrong answer, not a diagnostic. `check` and `run` AGREE.
// expect: error E0007 at 22:6
// expect: exit 1
trait Keyed {
    fn same(other: int): bool
}

class Door {
    code: int
    fn new(c: int): Door { return Door { code: c } }
}

impl Keyed for Door {
    fn same(other: int): bool { return self.code == other }
}

d = Door.new(1)
echo d.same("nope")
