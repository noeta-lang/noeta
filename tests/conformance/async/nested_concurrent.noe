// Track A.7 — a nested `concurrent` block interleaves with the OUTER scope's siblings. `slow` is
// spawned in the outer scope, then an inner `concurrent { }` spawns `a`/`b`. The scheduler polls every
// open scope each round, so `slow` starts and its long sleep advances *while* the inner block runs —
// rather than the inner block completing atomically first. At t=0 all three start; the short sleepers
// finish first and the inner join returns; awaiting `s` then reaches `slow`'s deadline.
//
// Every deadline here is 100 ms from the next, which is what makes the ordering hold on a REAL host
// too (the linked `--native` differential): there the executor sleeps real time to the earliest
// deadline and wakes late, so sleeps a couple of milliseconds apart all come due at the same poll and
// resume in scheduler order. That applies to `a` against `b` as much as to either against `slow`. See
// `all.noe` for the long form.
// expect: stdout "slow start"
// expect: stdout "a start"
// expect: stdout "b start"
// expect: stdout "a end"
// expect: stdout "b end"
// expect: stdout "inner done"
// expect: stdout "slow end"
// expect: stdout "s=300"
// expect: stdout "outer done"
// expect: exit 0
use std.task.{sleep}
async fn slow(): int {
    echo "slow start"
    sleep(300).await
    echo "slow end"
    return 300
}
async fn quick(name: string, ms: int): int {
    echo name ~ " start"
    sleep(ms).await
    echo name ~ " end"
    return ms
}
concurrent {
    s = spawn slow()
    concurrent {
        a = spawn quick("a", 100)
        b = spawn quick("b", 200)
    }
    echo "inner done"
    echo "s=" ~ s.await
}
echo "outer done"
