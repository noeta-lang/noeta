// Track A.7 — a nested `concurrent` block interleaves with the OUTER scope's siblings. `slow` is
// spawned in the outer scope, then an inner `concurrent { }` spawns `a`/`b`. The scheduler polls every
// open scope each round, so `slow` starts and its long sleep advances *while* the inner block runs —
// rather than the inner block completing atomically first. At t=0 all three start; the short sleepers
// finish first and the inner join returns; awaiting `s` then reaches `slow`'s deadline.
//
// The 200 ms gap is what makes that ordering hold on a REAL host too (the linked `--native`
// differential): there the executor sleeps real time to the earliest deadline and wakes late, so
// sleeps a couple of milliseconds apart all come due at the same poll and `slow end` lands before the
// short sleepers' ends instead. See `all.noe` for the long form.
// expect: stdout "slow start"
// expect: stdout "a start"
// expect: stdout "b start"
// expect: stdout "a end"
// expect: stdout "b end"
// expect: stdout "inner done"
// expect: stdout "slow end"
// expect: stdout "s=300"
// expect: stdout "outer done"
// expect: exit 0
use std.task.{sleep}
async fn slow(): int {
    echo "slow start"
    sleep(300).await
    echo "slow end"
    return 300
}
async fn quick(name: string): int {
    echo name ~ " start"
    sleep(100).await
    echo name ~ " end"
    return 100
}
concurrent {
    s = spawn slow()
    concurrent {
        a = spawn quick("a")
        b = spawn quick("b")
    }
    echo "inner done"
    echo "s=" ~ s.await
}
echo "outer done"
