// Track A.6b-residual — a `match`-arm `.await` compiles to a real poll-state, not a drive-to-completion,
// so a task suspended at an arm-body await yields to its siblings. Two tasks race in a `concurrent`
// scope: `a` awaits `sleep(150)` inside a match arm, `b` awaits `sleep(50)` inside one. `a` suspends,
// `b` runs and finishes first (shorter sleep) — the interleave only a poll-state can produce.
//
// The 100 ms gap is what makes that interleave hold on a REAL host too (the linked `--native`
// differential): there the executor sleeps real time to the earliest deadline and wakes late, so
// sleeps a millisecond apart both come due at the same poll and the tasks complete in spawn order
// instead. See `all.noe` for the long form.
// expect: stdout "a start"
// expect: stdout "b start"
// expect: stdout "b end"
// expect: stdout "a end"
// expect: stdout "sum=200"
// expect: exit 0
use std.task.{sleep}
async fn napped(ms: int): int {
    sleep(ms).await
    return ms
}
async fn work(name: string, ms: int, go: bool): int {
    echo name ~ " start"
    r = match go {
        true => napped(ms).await,
        false => 0,
    }
    echo name ~ " end"
    return r
}
concurrent {
    a = spawn work("a", 150, true)
    b = spawn work("b", 50, true)
    echo "sum=" ~ (a.await + b.await)
}
