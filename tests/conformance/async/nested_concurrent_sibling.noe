// Track A.7 — a `concurrent { }` inside a spawned task's body is a genuine suspension point, so two
// sibling tasks that each open their own inner `concurrent` INTERLEAVE rather than one running to
// completion before the other starts. `group("A")` and `group("B")` are outer siblings; each spawns two
// leaves in its own inner scope. Because the inner join yields out of the task's poll (instead of
// driving the inner scope to completion in place), all four leaves start before any ends. The two inner
// scopes are open simultaneously (out of structured-stack order), exercising the stable-index tombstone
// scope model.
//
// The four leaves take four DISTINCT deadlines, 100 ms apart, so the end order is a property of the
// program rather than of the scheduler. Equal sleeps only order under the sandbox's logical clock: on a
// real host every deadline an overshoot crosses comes due at the same poll, and the four resume in
// whatever order the scheduler holds them — which the header here pins and cannot.
// expect: stdout "A1 start"
// expect: stdout "A2 start"
// expect: stdout "B1 start"
// expect: stdout "B2 start"
// expect: stdout "A1 end"
// expect: stdout "A2 end"
// expect: stdout "B1 end"
// expect: stdout "B2 end"
// expect: stdout "total=1000"
// expect: exit 0
use std.task.{sleep}
async fn leaf(name: string, ms: int): int {
    echo name ~ " start"
    sleep(ms).await
    echo name ~ " end"
    return ms
}
async fn group(tag: string, ms: int): int {
    mut s = 0
    concurrent {
        x = spawn leaf(tag ~ "1", ms)
        y = spawn leaf(tag ~ "2", ms + 100)
        s = x.await + y.await
    }
    return s
}
concurrent {
    a = spawn group("A", 100)
    b = spawn group("B", 300)
    echo "total=" ~ (a.await + b.await)
}
