// Track A.8 — user-facing cancellation. `h.cancel()` marks a task cancelled exactly as a `race`
// loser (cooperative — it never resumes past its last suspension), and `h.join()` observes the
// outcome as a typed `Result<T, Cancelled>`. Here `work` is spawned, allowed to reach its `sleep`
// suspension (via the scope-level `sleep(100).await`), then cancelled while suspended — so its "end"
// line never prints — and `join` reports the `Err(Cancelled)` arm. Both backends agree.
//
// The gate sleep is 100 ms because this case also runs on a REAL host (the linked `--native`
// differential), where the clock moves on its own: a one-millisecond gate can already be due at its
// first poll, and an `await` that returns without ever suspending never runs a scheduler round — so
// `work` would be cancelled before it was polled once and "work start" would go missing. A gate that
// dominates scheduler jitter is guaranteed to yield, exactly as the sandbox's logical clock is.
// expect: stdout "work start"
// expect: stdout "cancelled"
// expect: exit 0
use std.task.{sleep}
async fn work(): int {
    echo "work start"
    sleep(500).await
    echo "work end"
    return 5
}
concurrent {
    h = spawn work()
    sleep(100).await
    h.cancel()
    r = h.join()
    echo match r {
        Ok(v)  => "ok=" ~ v,
        Err(_) => "cancelled",
    }
}
