// Track A.7 + A.8 — a `race` inside a spawned task's own `concurrent` block. `nested()` is spawned in
// the outer scope; its inner `concurrent` races three workers. `y` (sleep 20) wins at t=20; `x`/`z` are
// cancelled cooperatively (their "end" never prints). Cancellation must work across the suspension point
// the inner join now is: the losers are marked cancelled and the inner scope closes by its captured index
// (a `race` loser is reclaimed at the scope close exactly as a normal join), then `nested()` completes and
// the outer await observes the winner. Deterministic (ties break by list order); both backends agree.
//
// The gaps are 100 ms apart because this asserts an ORDER between sleeps, and the margin has to
// survive a loaded machine: the real host sleeps real time to the earliest deadline and wakes late,
// so every deadline the overshoot crossed comes due at the same poll. At a 20 ms gap a loser's
// deadline landed in the winner's poll and printed its `end` before the cancellation took effect
// (measured: 2 failures in 200 runs of the real-host corpus gate at load 25). 100 ms is still far
// below the 20s case timeout, and the semantics are unchanged — `y` wins by construction either way.
// expect: stdout "x start"
// expect: stdout "y start"
// expect: stdout "z start"
// expect: stdout "y end"
// expect: stdout "winner=100"
// expect: exit 0
use std.task.{sleep, race}
async fn work(name: string, ms: int): int {
    echo name ~ " start"
    sleep(ms).await
    echo name ~ " end"
    return ms
}
async fn nested(): int {
    mut w = 0
    concurrent {
        rs = [spawn work("x", 300), spawn work("y", 100), spawn work("z", 200)]
        w = race(rs)
    }
    return w
}
concurrent {
    h = spawn nested()
    echo "winner=" ~ h.await
}
