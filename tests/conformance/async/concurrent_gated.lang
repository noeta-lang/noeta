// Track A.3b.1 — a well-formed `concurrent { }` parses and type-checks (spawn → `Future<int>`,
// `handle.await` → `int`), but the cooperative scheduler is A.3b.2, so it is gated as not-yet-executable
// (E0040). This proves the surface + typing without the runtime.
// expect: error E0040 at 6:1
// expect: exit 1
concurrent {
    a = spawn work(2)
    b = spawn work(3)
    echo a.await + b.await
}
async fn work(n: int): int {
    return n
}
