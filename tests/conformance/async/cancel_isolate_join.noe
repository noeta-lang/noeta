// isolate-cancel — cancelling an `isolate` handle is the same surface as cancelling a `spawn`ed
// task: `h.cancel()` requests the stop and `h.join()` reports the typed `Result<T, Cancelled>`
// outcome. What this case pins is that the *reported* outcome matches what actually happened: the
// worker ran far enough to print its first line, and its "end" line never printed because the
// cancel was honored at a suspension before it.
//
// The ordering is established by a **rendezvous with the worker**, not by a timing gate. The
// sibling `cancel_join.noe` gates a `spawn`ed task with `sleep(100)`, sized to dominate scheduler
// jitter — sound there, because a cooperative task only has to be *polled* inside the window. An
// isolate is a real OS thread on the CLI's parallel path, so the same window would also have to
// cover thread startup, and under load it does not: the `--cancel-poll` arm of the JIT differential
// (which arms a live `CancelSignal` and emits a loop-header poll in every compiled body) cancelled
// the worker before its first line and the case failed with "work start" missing. A handshake
// removes the assumption rather than widening it — `recv()` cannot return until `send()` ran, and
// `send()` cannot run until the echo did.
// expect: stdout "work start"
// expect: stdout "cancelled"
// expect: exit 0
use std.task.{sleep}
async fn work(started: Sender<int>): int {
    echo "work start"
    started.send(1).await
    sleep(500).await
    echo "work end"
    return 5
}
concurrent {
    (tx, rx) = channel::<int>(1)
    h = isolate work(tx)
    ready = rx.recv().await
    h.cancel()
    echo match h.join() {
        Ok(v)  => "ok=" ~ v,
        Err(_) => "cancelled",
    }
}
