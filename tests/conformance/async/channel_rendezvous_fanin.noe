// Isolates I.4c — a capacity-0 **rendezvous** channel with two producers and one consumer. Each send
// blocks until the single consumer takes it, so the two producers' six handoffs serialize through the
// one-slot rendezvous; the consumer sums them. Order-independent total (10+11) + (20+21+22) + 12 —
// i.e. 10+11+12 + 20+21+22 = 96 — a deterministic result both backends agree on regardless of the
// exact interleaving of the two producers.
// expect: stdout "96"
// expect: exit 0
async fn producer(tx: Sender<int>, base: int, n: int): void {
    for i in 0..n {
        tx.send(base + i).await
    }
}
async fn consumer(rx: Receiver<int>): int {
    mut total = 0
    mut running = true
    while running {
        r = rx.recv().await
        (v, keep) = match r { some(x) => (x, true), none => (0, false) }
        total = total + v
        running = keep
    }
    return total
}
async fn run(): int {
    (tx, rx) = channel::<int>(0)
    mut result = 0
    concurrent {
        h = spawn consumer(rx)
        concurrent {
            spawn producer(tx, 10, 3)
            spawn producer(tx, 20, 3)
        }
        tx.close()
        result = h.await
    }
    return result
}
echo run().await
