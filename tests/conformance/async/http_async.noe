// std.http async twins (http arc H3/H6): `client.*_async` return `Future<Result<Response,
// HttpError>>`, so `.await?` is the async door and yields exactly what the sync verb does. On the real host
// each drives a genuine reqwest future on the executor's runtime (RealBody::Async); under the
// sandbox they resolve deterministically at spawn via the same responder, so the differential
// pins them. No backend code changed — the descriptor is handed out by the Network capability's
// `net_spawn`. `all(...)` (from std.task) awaits a batch concurrently into a list, in order.
// expect: stdout "200"
// expect: stdout "{"body":"","method":"GET","path":"/echo"}"
// expect: stdout "true"
// expect: stdout "201,202,203"
// expect: stdout "{"body":"yo","method":"POST","path":"/echo"}"
// expect: stdout "{"body":"","method":"PATCH","path":"/echo"}"
// expect: exit 0
use std.http.client
use std.http.Response
use std.task.{all}

async fn run(): void {
    r = client.get_async("https://svc.test/echo").await?
    echo r.status()
    echo r.body()
    echo r is Response

    // Concurrent fan-out: three requests in flight together (real host), resolved deterministically
    // at spawn (sandbox); `all` awaits them into a list in input order.
    codes = all([
        client.get_async("https://svc.test/status/201"),
        client.get_async("https://svc.test/status/202"),
        client.get_async("https://svc.test/status/203"),
    ])
    echo [codes[0]?.status(), codes[1]?.status(), codes[2]?.status()].join(",")

    echo client.post_async("https://svc.test/echo", "yo").await?.body()
    echo client.request_async("PATCH", "https://svc.test/echo").await?.body()
}
run().await
