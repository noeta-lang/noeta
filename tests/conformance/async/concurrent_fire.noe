// Track A.3b — fire-and-join: tasks `spawn`ed for effect (handles discarded) are still joined at the
// closing `}` — the block cannot be exited until both finish, so nothing dangles. They interleave by
// deadline (b's shorter sleep completes first).
//
// The 100 ms gap is what makes that interleave hold on a REAL host too (the linked `--native`
// differential): there the executor sleeps real time to the earliest deadline and wakes late, so
// sleeps a millisecond apart both come due at the same poll and the tasks complete in spawn order
// instead. See `all.noe` for the long form.
// expect: stdout "a start"
// expect: stdout "b start"
// expect: stdout "b end"
// expect: stdout "a end"
// expect: stdout "all done"
// expect: exit 0
use std.task.{sleep}
async fn work(name: string, ms: int): void {
    echo name ~ " start"
    sleep(ms).await
    echo name ~ " end"
}
concurrent {
    spawn work("a", 150)
    spawn work("b", 50)
}
echo "all done"
