// Track A.3b — real structured concurrency. Two tasks run in a `concurrent { }` scope: `a` sleeps
// 150, `b` sleeps 50. `a` suspends at its `sleep`, `b` runs, `b` finishes first (shorter sleep), then
// `a` — the interleaving that only the async state machine's yield-to-sibling can produce. The
// handles are awaited for their results (`Future<int>` → `int`).
//
// The 100 ms gap is what makes that interleave hold on a REAL host too (the linked `--native`
// differential): there the executor sleeps real time to the earliest deadline and wakes late, so
// sleeps a millisecond apart both come due at the same poll and the tasks complete in spawn order
// instead. See `all.noe` for the long form.
// expect: stdout "a start"
// expect: stdout "b start"
// expect: stdout "b end"
// expect: stdout "a end"
// expect: stdout "sum=200"
// expect: stdout "done"
// expect: exit 0
use std.task.{sleep}
async fn work(name: string, ms: int): int {
    echo name ~ " start"
    sleep(ms).await
    echo name ~ " end"
    return ms
}
concurrent {
    a = spawn work("a", 150)
    b = spawn work("b", 50)
    echo "sum=" ~ (a.await + b.await)
}
echo "done"
