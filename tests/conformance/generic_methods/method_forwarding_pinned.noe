// A generic METHOD's own type parameter cannot FORWARD into a call-site-typed native position (the
// pinned D3 boundary): `json.try_parse::<T>` inside a method body has no hidden-slot channel to
// carry the per-instantiation decode recipe — method dispatch has no forwarding seam — so it is
// rejected with a clear `E0058`, not silently mis-decoded. Call-site-typed forwarding stays a
// top-level-generic-fn capability (poly-values F2b). Tracked in plans/backlog.md.
// expect: error E0058 at 13:16
// expect: exit 1
use std.json
use std.json.JsonError
struct Order { id: int }
class Loader {
    fn load<T>(text: string): Result<T, JsonError> {
        return json.try_parse::<T>(text)
    }
}
