// A nested `fn` imports and mutates an enclosing `mut` local via `use (…)` (a named fn is
// sealed — the capture clause is the explicit import; the view is live).
// expect: stdout "3"
// expect: exit 0
fn make_counter(): int {
    mut count = 0;
    fn bump() use (count): void {
        count = count + 1;
    }
    bump();
    bump();
    bump();
    return count;
}
echo make_counter();
