// Two mutually recursive nested `fn`s declared inside a **top-level block**: `even` calls `odd` and
// `odd` calls `even`. Both are genuine `main` locals (not globals), each captures the other's celled
// binding as an upvalue via the block's forward-capture hoist — the same model as mutual recursion
// inside an ordinary function, now available at top level too (previously a VM-only E0005).
// expect: stdout "true"
// expect: stdout "true"
// expect: exit 0
while true {
    fn even(n: int): bool {
        if n == 0 {
            return true;
        }
        return odd(n - 1);
    }
    fn odd(n: int): bool {
        if n == 0 {
            return false;
        }
        return even(n - 1);
    }
    echo even(10);
    echo odd(7);
    break;
}
