// NO shadowing (E0059), statics included: a parameter may not reuse a free `fn`'s name — inside
// the body, `make(5)` would silently stop meaning the function. (This reverses the earlier
// aether-F6 allowance: one name, one meaning, per scope stack. Rename the parameter.)
// expect: error E0059 at 7:8
// expect: exit 1
fn make(): int { return 7; }
fn run(make: (int) -> int): int {
    return make(5);
}
echo run(fn(x: int): int => x * 10);
echo make();
