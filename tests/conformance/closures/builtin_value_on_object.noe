// A user-type method handle (`Stack.len`) dispatches to the object's `len` method when called
// indirectly — the successor of the retired `len`-builtin-as-value, which dispatched through the
// `Length` trait (prelude-redesign P1.2). The trait itself lives on as a generic bound (see
// traits/length_protocol.noe).
// expect: stdout "2"
// expect: stdout "5"
// expect: exit 0
class Stack {
    items: list

    fn new(items: list): Stack {
        return Stack { items: items };
    }

    impl Length {
        fn len(): int {
            return items.len();
        }
    }
}

size = Stack.len;
echo size(Stack.new([10, 20]));
echo size(Stack.new([1, 2, 3, 4, 5]));
