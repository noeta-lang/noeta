// A closure may carry an optional return-type annotation `fn(params): Ret => body`, mirroring a
// named `fn` and matching the already-allowed parameter annotations. It is checked against the body
// and then runtime-erased, so both backends behave identically.
// expect: stdout "6"
// expect: stdout "[2, 4, 6]"
// expect: stdout "9"
// expect: exit 0
add1 = fn(v: int): int => v + 1
echo add1(5)
echo [1, 2, 3].map(fn(v): int => v * 2)
// The annotation is optional and composes with inference and captures.
base = 4
combine = fn(a: int, b: int): int => a + b + base
echo combine(2, 3)
