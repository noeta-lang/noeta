// Collection operations as first-class values via unbound method handles (prelude-redesign P1.2):
// `list.len` / `list.sum` / `list.filter` are callables taking the receiver as their first
// argument — the successor of the retired prelude builtins-as-values (`length = len`).
// expect: stdout "3"
// expect: stdout "6"
// expect: stdout "[1, 2]"
// expect: stdout "[3, 4]"
// expect: exit 0
length = list.len;
total = list.sum;
echo length([1, 2, 3]);
echo total([1, 2, 3]);

// A handle passed as the function argument of a collection method.
echo [["a"], ["b", "c"]].map(list.len);

// `filter` itself stored as a handle, applied with a closure predicate.
keep = list.filter;
echo keep([1, 2, 3, 4], fn(x) => x > 2);
