// Deeper recursion through the shared global scope: naive Fibonacci, exercising two
// recursive calls per frame and the `if` early return.
// expect: stdout "55"
// expect: stdout "120"
// expect: exit 0
fn fib(n) {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}
fn fact(n) {
    if n <= 1 { return 1; }
    return n * fact(n - 1);
}
echo fib(10);
echo fact(5);
