// Named arguments bind to the parameter they name, wherever it sits.
//
// The label used to be parsed and DISCARDED, so `sub(b: 1, a: 10)` bound positionally and computed
// `1 - 10 = -9`. The failure looked like a working feature — the worst kind, because nothing
// surfaced until a caller relied on it.
//
// Arguments evaluate in the order WRITTEN; only the binding is permuted. `trace` proves it: the
// side effects run b-then-a even though `a` is `sub`'s first parameter.
// expect: stdout "9"
// expect: stdout "9"
// expect: stdout "9"
// expect: stdout "b"
// expect: stdout "a"
// expect: stdout "9"
// expect: exit 0
fn sub(a: int, b: int): int { return a - b }

echo sub(10, 1)
echo sub(a: 10, b: 1)
echo sub(b: 1, a: 10)

fn trace(tag: string, v: int): int {
    echo tag
    return v
}
echo sub(b: trace("b", 1), a: trace("a", 10))
