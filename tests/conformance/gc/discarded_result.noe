// Phase 4.4 (spec §2): a destructor-bearing value produced and immediately discarded as a bare
// expression statement fires its destructor — the discarded result is the last (only) reference.
// `Leaf.new("x");` builds a Leaf no one binds; its `destruct` runs at the statement. Both backends
// route the discarded result through destructor-aware release (eval `destroy_value`, VM a
// `relevant` `Op::Drop` of the result register, where it was previously a no-op).
// expect: stdout "a"
// expect: stdout "drop x"
// expect: stdout "b"
// expect: exit 0
class Leaf {
    tag: string
    fn new(t: string): Leaf { return Leaf { tag: t }; }
    destruct { echo "drop ${self.tag}"; }
}

echo "a";
Leaf.new("x");
echo "b";
