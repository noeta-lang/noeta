// Integration demo: a BitSet backed by `List<u64>` 64-bit words — the capstone dogfood of the whole
// stack. It exercises the object model (self-mutating methods, index-assignment through a field
// `self.words[w] = ...`, live in-method field access) AND the fixed-width integer tier end-to-end:
// `u64` literals, the bitwise/shift operators (`<< >> & | !`) on `u64`, and the width-exact
// `count_ones()` intrinsic — all flowing through a `List<u64>` field read + index inside a method.
// `set`/`clear` mutate the shared instance in place (class = reference). Both backends agree.
// expect: stdout "true"
// expect: stdout "false"
// expect: stdout "true"
// expect: stdout "3"
// expect: stdout "false"
// expect: stdout "2"
// expect: stdout "true"
// expect: exit 0
class BitSet {
    mut words: List<u64>

    // A fixed-capacity 256-bit set (four 64-bit words); `.set` replaces a word, it does not grow.
    fn new(): BitSet { return BitSet { words: [0u64, 0u64, 0u64, 0u64] }; }

    fn set(i: int): void {
        // Index-assignment through a field: `self.words[w] = v` ⟶ `self.words = self.words.set(w, v)`,
        // mutating the instance's list in place. The value is a `u64` bitwise expression.
        self.words[i / 64] = self.words[i / 64] | (1u64 << (i % 64));
    }

    fn clear(i: int): void {
        self.words[i / 64] = self.words[i / 64] & (!(1u64 << (i % 64)));
    }

    fn test(i: int): bool {
        return (self.words[i / 64] >> (i % 64)) & 1u64 == 1u64;
    }

    fn count(): int {
        return self.words |> map(fn(w) => w.count_ones()) |> sum();
    }
}

mut bs = BitSet.new();
bs.set(5);
bs.set(64);   // second word
bs.set(70);
echo bs.test(5);    // true
echo bs.test(6);    // false
echo bs.test(70);   // true
echo bs.count();    // 3

bs.clear(70);
echo bs.test(70);   // false
echo bs.count();    // 2

bs.set(200);        // fourth word
echo bs.test(200);  // true
