// `mut` field assignment (`x.f = v`, object-model slice 2b): a `mut` field of a reference `class`
// instance is assigned **in place**, including compound forms (`+=`). Mutation has **reference
// semantics** — an aliased snapshot (`snap = p`) shares the same instance, so it observes the
// mutation (`snap.count` becomes 99). A function-local accumulator mutates its field each iteration.
// Both backends agree.
// expect: stdout "16"
// expect: stdout "a"
// expect: stdout "99"
// expect: stdout "99"
// expect: stdout "10"
// expect: exit 0
class Counter {
    mut count: int
    label: string
    fn new(label: string): Counter { return Counter { count: 0, label: label }; }
}
mut c = Counter.new("a");
c.count = 5;
c.count = c.count + 1;
c.count += 10;
echo c.count;
echo c.label;

mut p = Counter.new("p");
snap = p;
p.count = 99;
echo snap.count;
echo p.count;

fn build(n: int): int {
    mut acc = Counter.new("acc");
    for i in 0..n { acc.count = acc.count + i; }
    return acc.count;
}
echo build(5);
