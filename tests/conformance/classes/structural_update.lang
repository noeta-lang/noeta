// Structural update: `Money { amount: 300, ...a }` builds a new value with `amount`
// overridden and every other field (here `currency`) carried over from `a`. The
// original is unchanged (immutable), so the full-initialization guarantee still holds.
// expect: stdout "500 USD"
// expect: stdout "300 USD"
// expect: stdout "500 USD"
// expect: exit 0
class Money {
    amount: int
    currency: string

    fn new(amount: int, currency: string): Money {
        return Money { amount: amount, currency: currency };
    }

    fn show(): string {
        return "${amount} ${currency}";
    }
}

a = Money.new(500, "USD");
b = Money { amount: 300, ...a };
echo a.show();
echo b.show();
echo a.show();
