// Member access inside a method is fully EXPLICIT (prelude-redesign EX.1): a bare name is a
// local — never a field, for reads AND writes — and `self.f` is the one way to touch the instance.
// So: a bare name is an ordinary local (declared by its first write, invisible to the field); an
// explicit `self.f = v` mutates the live instance; a write through an alias mutates the shared
// instance (a `class` is shared by reference) and `self.f` observes it. Both backends agree.
// (The old bare-READ-falls-back-to-self model this file used to pin was removed — see
// diagnostics/bare_field_read.noe for the targeted E0005.)
// expect: stdout "99"
// expect: stdout "10"
// expect: stdout "5"
// expect: stdout "7"
// expect: exit 0
class Counter {
    pub mut n: int
    fn new(): Counter { return Counter { n: 10 }; }

    // A bare name is a local; the field is untouched and unread. NOTE: because this body never
    // references `self`, the classification derives it as an ASSOCIATED function (EX.2) — it is
    // called on the type, not on a value.
    fn shadow(): int {
        n = 99;
        return n;
    }

    // An explicit `self.n = v` mutates the live field; `self.n` reads it back.
    fn set_then_read(): int {
        self.n = 5;
        return self.n;
    }

    // A write through an alias mutates the shared instance (reference); `self.n` observes it.
    fn alias_then_read(): int {
        other = self;
        other.n = 7;
        return self.n;
    }
}

mut c = Counter.new();
echo Counter.shadow();    // 99 (the local; associated by derivation — no self use)
echo c.n;                 // 10 (field untouched by the bare write)
echo c.set_then_read();   // 5 (live field after self.n = 5)
echo c.alias_then_read(); // 7 (live field after the alias mutated the shared instance)
