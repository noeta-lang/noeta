// Object-model slice 2b — reference vs value mutation, side by side. A `class` is shared by
// reference: assigning a `mut` field through one binding mutates the single instance, so an alias
// taken beforehand observes the change. A `struct` is a value: the same `x.f = v` is copy-on-write,
// so an alias keeps the old value. Both backends agree.
// expect: stdout "20"
// expect: stdout "20"
// expect: stdout "1"
// expect: stdout "9"
// expect: exit 0
class Box {
    pub mut n: int
    pub fn new(n: int): Box { return Box { n: n }; }
}

struct Counter { mut n: int }

mut b = Box.new(10);
alias = b;       // shares the same instance
b.n = 20;        // in-place mutation of the shared class instance
echo alias.n;    // 20 — the alias sees it
echo b.n;        // 20

mut c = Counter { n: 1 };
snap = c;        // a value snapshot
c.n = 9;         // copy-on-write: builds a new value, rebinds `c`
echo snap.n;     // 1 — the snapshot keeps the old value
echo c.n;        // 9
