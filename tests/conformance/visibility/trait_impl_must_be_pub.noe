// A method that implements a `trait` must be declared `pub` (E0015). A trait is an outward
// contract — anyone holding a `dyn Speaks` calls the method — so the implementation is on the
// type's public surface by construction. Required EXPLICITLY rather than implied: a reader of an
// `impl` block should not have to know which names the trait declares to know what is callable, and
// under the implied rule adding a method to a trait would silently change the visibility of a
// method written somewhere else entirely.
//
// Both spellings are pinned — the in-body `impl Trait { … }` and the standalone
// `impl Trait for Type { … }` — because they are two ways of writing the same thing and a rule that
// held for only one of them would be a hole rather than a rule.
// expect: error E0015 at 21:12
// expect: error E0015 at 26:8
// expect: exit 1
trait Speaks { fn speak(): string }
trait Counts { fn count(): int }

class Dog {
    name: string
    pub fn new(): Dog { return Dog { name: "rex" }; }
    impl Speaks {
        fn speak(): string { return "woof"; }
    }
}

impl Counts for Dog {
    fn count(): int { return 1; }
}

echo Dog.new().speak();
