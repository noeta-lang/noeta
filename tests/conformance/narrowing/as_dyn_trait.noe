// `.as<dyn Trait>()` is checked narrowing to a trait object with the same precise membership test
// as `is dyn Trait`: `some(value)` iff the runtime value's nominal type has a registered
// `impl Trait`, `none` otherwise (it used to be permissively `some` for every value). The narrowed
// payload is usable at `dyn Trait` — its trait method dispatches.
// expect: stdout "woof"
// expect: stdout "silent"
// expect: stdout "silent"
// expect: exit 0
trait Speaks {
    fn speak(): string
}

struct Dog {
    name: string
}

impl Speaks for Dog {
    fn speak(): string {
        return "woof"
    }
}

struct Silent {
    name: string
}

fn voice(x: dyn): string {
    return match x.as<dyn Speaks>() {
        some(s) => s.speak(),
        none => "silent",
    }
}

echo voice(Dog { name: "Rex" })
echo voice(Silent { name: "Mute" })
echo voice(7)
