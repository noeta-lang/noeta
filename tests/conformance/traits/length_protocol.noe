// The `Length` trait is a capability BOUND (prelude-redesign P1.2 — the free `len(o)` builtin it
// used to light up is retired): `impl Length` promises a `len(): int` method, and a generic
// `<T: Length>` licenses `x.len()` on the parameter. Direct `.len()` calls need no trait.
// expect: stdout "3"
// expect: stdout "0"
// expect: exit 0
class Stack {
    items: list

    pub fn new(items: list): Stack {
        return Stack { items: items };
    }

    impl Length {
        pub fn len(): int {
            return self.items.len();
        }
    }
}

fn measure<T: Length>(x: T): int {
    return x.len();
}

echo measure(Stack.new([10, 20, 30]));
echo Stack.new([]).len();
