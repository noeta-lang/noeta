// The return type is REQUIRED, not merely matched when written: an omitted one leaves the same hole
// open. A trait method is an outward contract, which is why the same rule already asks it to be
// `pub`.
// expect: error E0015 at 9:12
// expect: error E0022 at 9:12
// expect: exit 1
struct Rev { n: int }
impl Comparable for Rev {
    pub fn compare(other: Rev) { return Ordering.Equal; }
}
echo Rev { n: 1 } < Rev { n: 2 };
