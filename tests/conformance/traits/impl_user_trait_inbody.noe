// An in-body `impl UserTrait { ... }` inside a struct (L1 user traits, UT2): the method is flattened
// onto the type by the parser and its user-trait conformance is checked. `r.area()` dispatches.
// expect: stdout "12"
// expect: exit 0
trait Area {
    fn area(): int
}

struct Rect {
    w: int
    h: int
    impl Area {
        pub fn area(): int { return self.w * self.h }
    }
}

r = Rect { w: 3, h: 4 }
echo r.area()
