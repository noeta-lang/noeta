// The turbofish call form obeys the same receiver discipline as the plain one — which it did not.
// `Checker::synth_typed_method` read the classification table with a single default for both
// directions while the two plain-call sites used opposite ones, so a method with no recorded
// classification (every standalone-impl method, before this) was accepted as `T.m(x)` and refused
// as `T.m::<int>(x)`. One spelling of a call cannot be more associated than another.
// expect: stdout "3"
// expect: stdout "3"
// expect: exit 0
trait Marker { fn tag(): string }

struct Box2 { id: int }
impl Marker for Box2 {
    fn tag(): string { return "t" }
    fn pick<T>(x: T): T { return x }
}

echo Box2.pick::<int>(3)
echo Box2 { id: 1 }.pick::<int>(3)
