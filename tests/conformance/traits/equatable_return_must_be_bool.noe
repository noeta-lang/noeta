// The `Equatable` half of the same rule: `a == b` is a `bool` because `==` is, and `!=` negates
// what `eq` answered — so a non-`bool` return leaks a value out of an expression the checker typed
// `bool`. (`echo a == b` printed `7`.)
// expect: error E0015 at 8:12
// expect: exit 1
struct Rev { n: int }
impl Equatable for Rev {
    pub fn eq(other: Rev): int { return 7; }
}
echo Rev { n: 1 } == Rev { n: 2 };
