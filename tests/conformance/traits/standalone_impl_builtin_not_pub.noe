// A method implementing a trait is on the type's outward surface, so it must say `pub` — the same
// requirement the in-body spelling states, at the same shared funnel.
// expect: error E0015 at 7:8
// expect: exit 1
struct Rev { n: int }
impl Comparable for Rev {
    fn compare(other: Rev): Ordering { return other.n.compare(self.n); }
}
echo Rev { n: 1 } < Rev { n: 2 };
