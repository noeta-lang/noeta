// `a < b` is a `bool` because of the OPERATOR, not because of the method behind it — so `compare`'s
// answer is read (as a direction) rather than passed on, and it has to be an `Ordering`. Without
// this rule `echo a < b` printed the `int` the body returned.
// expect: error E0015 at 8:12
// expect: exit 1
struct Rev { n: int }
impl Comparable for Rev {
    pub fn compare(other: Rev): int { return other.n - self.n; }
}
echo Rev { n: 1 } < Rev { n: 2 };
