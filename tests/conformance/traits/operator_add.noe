// Implementing the `Add` trait lights up the `+` operator: `a + b` dispatches to the class's
// `add` method. The overload runs identically under both backends (the differential oracle).
// expect: stdout "8"
// expect: stdout "USD"
// expect: exit 0
class Money {
    amount: int
    currency: string

    fn new(amount: int, currency: string): Money {
        return Money { amount: amount, currency: currency };
    }

    impl Add {
        fn add(other: Money): Money {
            return Money { amount: amount + other.amount, currency: currency };
        }
    }
}

a = Money.new(5, "USD");
b = Money.new(3, "USD");
total = a + b;
echo total.amount;
echo total.currency;
