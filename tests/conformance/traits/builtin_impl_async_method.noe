// No built-in trait declares an `async` method — the runtime invokes these protocols for a value,
// not for a future — so an `async` implementation of one is E0015. The same contract rule as the
// user-trait `async` mismatch: the caller's typing comes from the trait, never from the body, and
// `echo p` would otherwise render a `<future>` through a `Display` that promised a `string`.
// expect: error E0015 at 9:18
// expect: exit 1
struct Point {
    impl Display {
        async fn to_string(): string { return "p" }
    }
}

echo Point {}
