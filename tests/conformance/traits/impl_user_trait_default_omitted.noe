// A trait's DEFAULT method (one with a body) is optional for an implementor (L1, UT2): an `impl`
// may provide only the required methods and still check clean — and the omitted method falls back
// to the trait's default body (UT5). `shout` mentions no `self`, so it hoists as an associated fn.
// expect: stdout "hi Ada"
// expect: stdout "HELLO"
// expect: exit 0
trait Greeter {
    fn greet(who: string): string
    fn shout(): string { return "HELLO" }
}

class Casual {
    pub fn new(): Casual { return Casual {} }
}

impl Greeter for Casual {
    pub fn greet(who: string): string { return "hi " ~ who }
}

echo Casual.new().greet("Ada")
echo Casual.shout()
