// A `trait` that declares the same method name twice is rejected. It goes through the same
// duplicate-member rule a struct, class and enum use — one rule, one code — because a trait's
// members are spliced into by `@`-directive expansion exactly as a data type's are.
// expect: error E0080 at 8:8
// expect: exit 1
trait Baz {
    fn a(): int
    fn a(): string
}
