// A standalone `impl Trait for T {}` declares a capability for a type from *outside* its
// declaration — here marking a bodiless record as usable in annotation position. A marker
// (empty-body) impl has no runtime effect, so the program runs identically in both backends.
// expect: stdout "/users"
// expect: exit 0
type Route = { path: string };
impl Attribute for Route {}

r = Route { path: "/users" };
echo r.path;
