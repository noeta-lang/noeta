// **Every built-in trait that has a trait object agrees with itself in every position.**
//
// The `dyn Trait` coercion, the runtime `x is dyn Trait` membership test and trait-method dispatch
// all read the same registration data — an `impl Trait { … }` block here — so for each trait below
// a value widens into `dyn Trait` at a parameter, an annotated binding, a `List<dyn Trait>` element
// and a declared return, AND answers the runtime test `true` behind every one of them. A trait
// where those disagree is the failure this case exists to catch: a `dyn` target that tests `true`
// but can never be formed is not a trait object, it is a type nothing inhabits.
//
// Asserted per trait rather than for a sample, because the split was per trait: the coercion asked
// the user-trait table alone, so every built-in answered `false` while the runtime answered `true`.

// expect: stdout "Add true"
// expect: stdout "Sub true"
// expect: stdout "Mul true"
// expect: stdout "Div true"
// expect: stdout "Concat true"
// expect: stdout "Equatable true"
// expect: stdout "Comparable true"
// expect: stdout "Display true"
// expect: stdout "Error true"
// expect: stdout "Index true"
// expect: stdout "Length true"
// expect: stdout "Iterable true"
// expect: stdout "Callable true"
// expect: stdout "Members true"
// expect: stdout "DynamicCall true"
// expect: stdout "TryAdd true"
// expect: stdout "Validate true"
// expect: exit 0

struct AddBox { n: int
    impl Add { pub fn add(other: AddBox): AddBox { return AddBox { n: self.n + other.n } } }
}
fn take_add(x: dyn Add): bool { return x is dyn Add }
fn make_add(): dyn Add { return AddBox { n: 1 } }
bound_add: dyn Add = AddBox { n: 1 }
list_add: List<dyn Add> = [AddBox { n: 1 }]
echo "Add ${(AddBox { n: 1 } is dyn Add) && take_add(AddBox { n: 1 }) && take_add(bound_add) && take_add(list_add[0]) && take_add(make_add())}"

struct SubBox { n: int
    impl Sub { pub fn sub(other: SubBox): SubBox { return SubBox { n: self.n - other.n } } }
}
fn take_sub(x: dyn Sub): bool { return x is dyn Sub }
fn make_sub(): dyn Sub { return SubBox { n: 1 } }
bound_sub: dyn Sub = SubBox { n: 1 }
list_sub: List<dyn Sub> = [SubBox { n: 1 }]
echo "Sub ${(SubBox { n: 1 } is dyn Sub) && take_sub(SubBox { n: 1 }) && take_sub(bound_sub) && take_sub(list_sub[0]) && take_sub(make_sub())}"

