// The capability gate: a struct is usable as `#[Foo(...)]` only if it implements the marker trait
// `Attribute`. `Plain` is a struct but is never marked, so attaching it is rejected (E0029).
// expect: error E0029 at 6:3
// expect: exit 1
struct Plain { path: string }
#[Plain("/x")]
struct Users { id: int }
