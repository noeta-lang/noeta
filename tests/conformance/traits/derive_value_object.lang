// The flagship `#[derive(...)]` value object. `Equatable`/`Display`/`Clone` are M1's structural
// defaults (so deriving them is the explicit, checked spelling of behavior already present);
// `#[derive(Comparable)]` synthesizes field-wise ordering — `< <= > >=` compare `x` then `y` in
// declared order. Runs identically under both backends (the differential oracle).
// expect: stdout "true"
// expect: stdout "false"
// expect: stdout "true"
// expect: stdout "false"
// expect: stdout "true"
// expect: exit 0
#[derive(Equatable, Comparable, Display, Clone)]
class Point {
    x: int
    y: int

    fn new(x: int, y: int): Point {
        return Point { x: x, y: y };
    }
}

a = Point.new(1, 2);
b = Point.new(1, 2);
c = Point.new(1, 5);
echo a == b;
echo a == c;
echo a < c;
echo a > c;
echo a <= b;
