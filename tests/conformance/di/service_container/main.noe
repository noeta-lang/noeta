// Service injection by interface — the mechanism para.aether's `App` container runs, reproduced
// inline (conformance cannot import para.aether). Replaces the single-service stub `DynTrait(_) =>
// self.store` that handed ONE service to every `dyn` parameter: a container keyed by interface, so a
// `dyn T` parameter resolves to the service registered FOR T.
//
// Load-bearing facts this pins, empirically, so the container's design cannot silently drift:
//   1. A `dyn Trait` parameter reflects (`params_of`) with its trait name FULLY QUALIFIED — here
//      `di.main.Clock`, not `Clock` — so the container must normalize to the short name to meet
//      a registration written with the short spelling. (First echo pins the raw reflected name.)
//   2. TWO DISTINCT services registered under different interfaces each inject correctly — `dyn Clock`
//      gets the clock, `dyn Ledger` gets the ledger — which the single-service stub could not do.
//   3. An UNREGISTERED interface is an actionable error naming the interface and how to provide it —
//      NOT a panic, and NOT the wrong service silently injected.
// Both backends run the identical reflect -> resolve -> invoke loop, so the differential oracle holds
// the two evaluators to the same resolution.
// Its `noeta.toml` is what makes the case a package, and therefore what derives the entry's
// module path: delete the manifest and nothing qualifies, silently.
// expect: stdout "raw: di.main.Clock"
// expect: stdout "Clock -> TICK"
// expect: stdout "Ledger -> NOTE"
// expect: stdout "missing: no service for `dyn Absent` — register it with bind(\"Absent\", <instance>)"
// expect: exit 0

trait Clock {
    fn tick(): string
}

trait Ledger {
    fn note(): string
}

// Declared, registered nowhere — the unresolved-interface case.
trait Absent {
    fn nope(): string
}

class SysClock {
    fn new(): SysClock {
        return SysClock {}
    }

    impl Clock {
        fn tick(): string {
            return "TICK"
        }
    }
}

class MemLedger {
    fn new(): MemLedger {
        return MemLedger {}
    }

    impl Ledger {
        fn note(): string {
            return "NOTE"
        }
    }
}

// The handlers whose `dyn` parameters drive resolution — one per interface.
class Handlers {
    fn new(): Handlers {
        return Handlers {}
    }

    fn on_clock(c: dyn Clock): string {
        return c.tick()
    }

    fn on_ledger(l: dyn Ledger): string {
        return l.note()
    }

    fn on_absent(x: dyn Absent): string {
        return x.nope()
    }
}

// The container key for an interface: the reflected trait name is fully qualified, so key on the last
// dotted segment — the short name a registration is written with.
fn short_iface(name: string): string {
    parts = name.split(".")
    return if parts.len() > 0 then parts[parts.len() - 1] else name
}

// A registry of concrete instances keyed by interface short name — the shape of `App.services`.
class Container {
    mut services: Map<string, dyn>

    fn new(): Container {
        return Container { services: {} }
    }

    fn bind(name: string, service: dyn): void {
        self.services = self.services.set(name, service)
    }

    // Resolve a reflected `dyn Trait` name to its service, or an actionable error naming the interface.
    fn resolve(name: string): Result<dyn, string> {
        key = short_iface(name)
        if self.services.has(key) {
            return Ok(self.services[key])
        }
        return Err("no service for `dyn ${key}` — register it with bind(\"${key}\", <instance>)")
    }

    // Reflect a single-parameter handler's one `dyn` argument and resolve it through the container.
    fn arg_for(target: string): Result<dyn, string> {
        p = params_of(target)[0]
        return match p.type {
            DynTrait(n) => self.resolve(n),
            _ => Err("not a dyn parameter"),
        }
    }
}

c = Container.new()
c.bind("Clock", SysClock.new())
c.bind("Ledger", MemLedger.new())

handlers = Handlers.new()

// (1) Pin the raw reflected spelling: fully qualified, not the short name.
raw = match params_of("di.main.Handlers.on_clock")[0].type {
    DynTrait(n) => n,
    _ => "not-dyntrait",
}
echo "raw: ${raw}"

// (2) Two distinct services, each injected for its own interface.
echo match c.arg_for("di.main.Handlers.on_clock") {
    Ok(v) => "Clock -> " ~ (match invoke(handlers, "on_clock", [v]) {
        Ok(r) => r.as<string>() ?? "?",
        Err(e) => "invoke-err ${e}",
    }),
    Err(e) => "resolve-err ${e}",
}
echo match c.arg_for("di.main.Handlers.on_ledger") {
    Ok(v) => "Ledger -> " ~ (match invoke(handlers, "on_ledger", [v]) {
        Ok(r) => r.as<string>() ?? "?",
        Err(e) => "invoke-err ${e}",
    }),
    Err(e) => "resolve-err ${e}",
}

// (3) An unregistered interface: actionable error, no panic, no wrong service.
echo match c.arg_for("di.main.Handlers.on_absent") {
    Ok(v) => "WRONG: injected a service for an unregistered interface",
    Err(e) => "missing: ${e}",
}
