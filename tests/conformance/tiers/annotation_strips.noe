// The `@<tier> fn …` *annotation* form (object-model slice 6c) is grouping sugar for a one-item
// `@<tier> { … }` block: `@test fn t(): void { … }` is exactly `@test { fn t(): void { … } }`. So
// like the block, an annotated fn is stripped before lowering on a normal run (no tier active) — it
// is never compiled or run, the program's own output is unchanged, and both backends strip it
// identically (they lower the same program), so the differential agrees.
// expect: stdout "7"
// expect: stdout "done"
// expect: exit 0
fn add(a: int, b: int): int { return a + b; }

@test fn adds(): void { assert(add(1, 2) == 3); }
@test fn also_adds(): void { assert(add(3, 4) == 7); }

echo add(3, 4);
echo "done";
