// Set element-update reuse (`s = s.add(x)` / `s = s.remove(x)`): a function-local set accumulator
// binary-search-inserts/removes one element in its existing buffer (the reuse path; value semantics
// are invisible to the program). An aliased snapshot taken before an update keeps its own value; a
// duplicate `add` is a no-op; removing an absent element is a no-op. Both backends agree.
// expect: stdout "{0, 1, 2, 3, 4}"
// expect: stdout "{1, 3}"
// expect: stdout "{1, 2, 3}"
// expect: stdout "{1, 2, 3, 9}"
// expect: exit 0

fn built(n: int): Set<int> {
    mut acc = #{};
    for i in 0..n {
        acc = acc.add(i);
        acc = acc.add(i); // duplicate add — a no-op
    }
    return acc;
}
echo built(5);

mut s = #{1, 2, 3};
s = s.remove(2);
s = s.remove(8); // absent — a no-op
echo s;

mut t = #{1, 2, 3};
snap = t;
t = t.add(9);
echo snap; // the snapshot is unchanged by the later add
echo t;
