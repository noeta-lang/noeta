// list sorted/slice — deterministic (stable) ordering and bounds-checked sublists, identical
// in both backends.
// expect: stdout "[1, 2, 3, 5]"
// expect: stdout "[\"apple\", \"banana\", \"cherry\"]"
// expect: stdout "[2, 3]"
// expect: stdout "[]"
// expect: stdout "[10, 20, 30]"
// expect: exit 0
echo [3, 1, 5, 2].sorted();
echo ["cherry", "apple", "banana"].sorted();
echo [1, 2, 3, 4].slice(1, 3);
echo [1, 2, 3].slice(1, 1);
echo [10, 20, 30].slice(0, 3);
