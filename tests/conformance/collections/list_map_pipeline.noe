// List/map literals, methods, and the map/filter/sum pipeline.
// expect: stdout "[1, 2, 3]"
// expect: stdout "3"
// expect: stdout "2"
// expect: stdout "60"
// expect: stdout "0:a"
// expect: stdout "1:b"
// expect: exit 0
echo [1, 2, 3];
echo [1, 2, 3].len();
echo {"a": 1, "b": 2}.len();
echo [1, 2, 3, 4].filter(fn(n) => n % 2 == 0).map(fn(n) => n * 10).sum();
for (i, x) in ["a", "b"].enumerate() {
    echo i ~ ":" ~ x;
}
