---
source: crates/noeta-ir/tests/golden.rs
expression: "lower_dump(\"class Point {\\n  x: int\\n  y: int\\n  fn sum(): int { return x + y; }\\n}\\np = Point { x: 1, y: 2 };\\necho p.sum();\\n\")"
---
program (temps: 2)
  class Point {
    method sum() (temps: 1) {
      let %0 = x + y
      return %0
    }
  }
  let %0 = Point {x: 1, y: 2}
  p = %0
  let %1 = p.sum()
  echo %1
