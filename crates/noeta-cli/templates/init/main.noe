// The program's entry point. Top-level statements run top to bottom — there is no
// `main` function. Every other `.noe` file under `src/` is a module, and its import
// path is derived from where the file sits — there is no `namespace` to declare.
// `src/models.noe` is `<package>.models`, `src/deep/nested.noe` is
// `<package>.deep.nested`. Import one with `use <package>.models.{Thing}`.

@doc {
    Builds the greeting for `name`.

    The `@doc` block above a declaration is its documentation — extracted by
    `noeta doc`, shown on hover in the editor, and stripped from a normal build.
}
fn greet(name: string): string {
    @debug {
        echo "greet(${name})"
    }
    return "Hello, ${name}!"
}

echo greet("Noeta")

// Tests live beside the code they test. `noeta test src/main.noe` runs them;
// a normal `noeta run` strips the block entirely.
@test {
    fn greets(): void {
        assert(greet("world") == "Hello, world!")
    }

    fn greets_noeta(): void {
        assert(greet("Noeta") == "Hello, Noeta!")
    }
}

// Benchmarks work the same way: `noeta bench src/main.noe`.
@bench(iterations: 1000)
fn greet_speed(): void {
    greet("bench")
}
