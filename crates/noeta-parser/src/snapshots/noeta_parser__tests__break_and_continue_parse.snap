expression: "pretty(\"for i in 0..3 { if i == 1 { continue; } if i == 2 { break; } }\")"
---
(program @0..62
  (for [i] @0..62
    (range @9..13
      (int 0 @9..10)
      (int 3 @12..13))
    (if @16..39
      (binary "==" @19..25
        (ident i @19..20)
        (int 1 @24..25))
      (then
        (continue @28..37)))
    (if @40..60
      (binary "==" @43..49
        (ident i @43..44)
        (int 2 @48..49))
      (then
        (break @52..58)))))
