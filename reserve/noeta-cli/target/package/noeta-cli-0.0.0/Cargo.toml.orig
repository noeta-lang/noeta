# Independent workspace root so this placeholder publishes in isolation,
# without pulling in the main `lang-*` build graph one directory up.
[workspace]

[package]
name = "noeta-cli"
version = "0.0.0"
edition = "2021"
rust-version = "1.85"
description = "Command-line interface for the Noeta programming language (.noe). Name reservation placeholder — not yet released."
license = "MIT"
homepage = "https://noeta.dev"
repository = "https://github.com/nsrosenqvist/lang"
readme = "README.md"
keywords = ["language", "interpreter", "compiler", "scripting", "cli"]
categories = ["development-tools", "command-line-utilities"]

# Reserves the eventual `noeta` command; `cargo install noeta-cli` yields `noeta`.
[[bin]]
name = "noeta"
path = "src/main.rs"

[lints.rust]
unsafe_code = "forbid"
