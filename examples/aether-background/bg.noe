// The aether background-task scope + scheduler: a handler fires a background job and returns right
// away; a worker runs jobs off the request path; a scheduled task ticks — all alongside `serve` in
// one nursery (the serve loop drives the sibling tasks). No async-serve primitive needed.
use para.aether.{work, every, background}
use std.http.server
use std.http.{Request, Response}

(tx, rx) = channel::<() -> void>(16)

fn process(): void {
    echo "  [bg] processed a job"
}
fn heartbeat(): void {
    echo "  [scheduler] tick"
}

async fn handle(req: Request) use (tx): Response {
    echo "request ${req.path()} -> queued background work, replying now"
    background(tx, process).await
    return server.response(202, "accepted")
}

async fn main() use (rx, tx): void {
    concurrent {
        spawn work(rx)
        spawn every(2, heartbeat)
        server.serve(8080, handle)
        // Graceful shutdown: once the server stops, close the job queue so the worker drains and
        // exits (the scheduler's `every` loop is cancelled at the nursery close).
        tx.close()
    }
}
main().await
