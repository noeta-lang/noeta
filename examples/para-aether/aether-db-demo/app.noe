// noeta-aether + para.db, wired together in ONE app (aether DB3).
//
// This app depends on BOTH first-party `para` packages through a single scope dependency
// (`para = [ para-aether, para-db ]` in noeta.toml) — the multi-package-per-scope resolution that
// was the F7 blocker. It demonstrates the two database-facing framework features:
//
//   * ROUTE-MODEL BINDING — `GET /users/{id}` declares `fn show(user: User)`; aether loads the
//     `User` from the database by the route id and injects it (Laravel implicit binding).
//   * UNIT-OF-WORK — `POST /users` stages an insert during the request; aether commits it with one
//     `flush` AFTER the response is produced (a request's writes land as one batch).
//
// Crucially, aether NEVER imports `para.db`: it depends only on its own `Store` interface. This app
// backs that interface with a `para.db` repository. Swap the driver, keep the framework.

use para.aether.{App, Get, Post, Store}
use para.db
use para.db.Connection
use para.db.repo.Repository
use std.json

// The persisted model: derives both directions of JSON (row -> model on read, model -> columns on
// write). Route-model binding materializes one of these from a `{id}`.
@derive(Serialize<Json>, Deserialize<Json>)
struct User {
    id: int
    name: string
    age: int
}

// The create-request body — decoded from the POST body (not route-bound), so it is a NEW user.
@derive(Serialize<Json>, Deserialize<Json>)
struct CreateUser {
    id: int
    name: string
    age: int
}

// The app's data store: a `para.db` repository over the `users` table, adapting the native SQLite
// driver to aether's database-agnostic `Store` interface. This is the ONE place the framework and the
// database meet — everything above it is driver-agnostic.
class SqlStore {
    conn: Connection
    repo: Repository

    fn new(conn: Connection): SqlStore {
        return SqlStore { conn: conn, repo: Repository.new("User", "users", "id") }
    }

    impl Store {
        // Route-model binding: load a `User` by its route id. The path id is a string; `to_int`
        // returns `?int`, which binds faithfully — `some(n)` as the integer key, `none` as NULL (so a
        // non-numeric id simply matches nothing). No manual unwrap needed.
        fn load(model: string, id: string): dyn {
            return match self.repo.find(self.conn, id.to_int()) {
                some(u) => u,
                none => panic("404 no ${model} ${id}"),
            }
        }

        // Stage a write into the request's unit-of-work: decode the JSON into a `User`, enqueue it.
        fn stage(model: string, data: string): void {
            match json.decode_typed("User", data) {
                Ok(u) => self.repo.add(u),
                Err(e) => panic("400 ${e}"),
            }
        }

        // Commit the request's staged writes as one batch (BEGIN … COMMIT).
        fn flush(): void {
            self.repo.flush(self.conn)
        }
    }
}

// A SECOND service, distinct from the data `Store`, to show the container resolves each `dyn`
// parameter by its own interface — not the single-service stub that handed the `Store` to every
// `dyn`. `Clock` is an app-local interface (no `para` import), so it also exercises short-name keying
// on a bare, unqualified trait name alongside the imported, fully-qualified `Store`.
trait Clock {
    fn stamp(): string
}

// A fixed clock — deterministic output makes the injected service observable in the string path.
class FixedClock {
    fn new(): FixedClock {
        return FixedClock {}
    }

    impl Clock {
        fn stamp(): string {
            return "2026-07-22T00:00:00Z"
        }
    }
}

class UsersController {
    fn new(): UsersController {
        return UsersController {}
    }

    // Route-model binding: aether loads the `User` from the store by the `{id}` and injects it.
    #[Get("/users/{id}")]
    fn show(user: User): string {
        return "user ${user.id}: ${user.name} (${user.age})"
    }

    // Service injection by interface + unit-of-work: TWO distinct services inject into one handler —
    // `store: dyn Store` (the data store) and `clock: dyn Clock` (a separate service) — each resolved
    // to the instance registered for ITS interface, proving the container is not the single-service
    // stub. The handler stages an insert and returns immediately; aether flushes the write afterward.
    #[Post("/users")]
    fn create(body: CreateUser, store: dyn Store, clock: dyn Clock): string {
        store.stage("User", body.to_json())
        return "queued ${body.name} at ${clock.stamp()}"
    }
}

// --- Wire the app. -----------------------------------------------------------------------------

conn = db.connect("sqlite::memory:")
conn.execute("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)", [])
conn.execute("INSERT INTO users (id, name, age) VALUES (?, ?, ?)", [1, "Ada", 36])

app = App.new()
app.register("UsersController", UsersController.new())
app.set_store(SqlStore.new(conn))
// A second service, registered by its interface name — injected wherever a handler declares `dyn Clock`,
// independently of the data `Store`.
app.bind("Clock", FixedClock.new())
app.bind_model("User")
app.discover()

// 1. Route-model binding — GET /users/1 injects the User loaded from the database.
echo app.dispatch_request("GET", "/users/1", "")

// 2. Unit-of-work — POST /users stages an insert; aether flushes it after the response.
echo app.dispatch_request("POST", "/users", "{\"id\":2,\"name\":\"Bob\",\"age\":41}")

// 3. Confirm the staged insert was committed by the end-of-request flush.
echo app.dispatch_request("GET", "/users/2", "")

conn.close()
