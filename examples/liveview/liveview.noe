// The `liveview` package — server-side reactive HTML templating, LiveWire/LiveView-style, in pure
// Noeta. It composes three language substrates:
//
//   * expression tiers (expr-tiers arc)      — `@html { … ${expr} … }` is a typed template value;
//   * fine-grained reactivity (std.reactive) — each hole becomes a `computed`, so a signal change
//     recomputes exactly the affected holes;
//   * the reactive-view diff-push transport (std.reactive.view + std.http.server websockets) —
//     which serializes only the holes that changed and pushes a minimal patch to the browser.
//
// A consumer depends on this package, imports `render` (which brings the `@html` tier declaration
// into scope) and `handle`, and writes ordinary HTML with `${…}` holes over signals. See
// `examples/liveview-counter/`.
namespace liveview;

use std.reactive.{signal, computed, view}
use std.http.server
use std.http.{Request, Response, Socket}
use std.json

// A compiled `@html` template: the static HTML skeleton (holes rendered as `<span data-live="hN">`
// markers, filled with their initial values for a no-flash first paint) plus the per-hole
// `computed`s the websocket session exposes and diffs. Holes are held as `dyn` — they *are*
// `Computed<string>`s, but `view.expose` accepts `dyn` and this keeps the field a built-in.
pub struct Html {
    skeleton: string
    holes: List<dyn>
}

// Minimal HTML-text escaping for the server-rendered initial values; the client shim writes updates
// via `textContent`, which escapes on its own, so this only guards the first paint.
fn escape(s: string): string {
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
}

// The `@html` handler. Holes are `() -> dyn` — a template renders *any* value (like JSX `{x}`),
// stringified through interpolation — so `${count.get()}` needs no `.to_string()`. Each hole is
// wrapped in a `computed` so it tracks exactly the signals it reads and recomputes only when they
// change; the diff transport then pushes only the holes whose rendered value differs.
@tier(html, text: "html", expr: Html)
pub fn render(statics: List<string>, holes: List<() -> dyn>): Html {
    computeds = holes.map(fn(h) => computed(fn() => "${h()}"))
    mut skeleton = ""
    mut i = 0
    for s in statics {
        skeleton = skeleton ~ s
        if i < computeds.len() {
            c = computeds[i]
            skeleton = skeleton ~ "<span data-live=\"h${i}\">" ~ escape(c.get()) ~ "</span>"
        }
        i = i + 1
    }
    return Html { skeleton: skeleton, holes: computeds }
}

// Wrap a rendered template in a full HTML document with the bundled client shim.
fn document(title: string, page: Html): string {
    head = "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>${title}</title></head><body>\n"
    return "${head}${page.skeleton}\n<script src=\"/live.js\"></script></body></html>\n"
}

// One websocket session: a `view()` over the page's hole computeds, the full snapshot, then a loop —
// each client event runs the app's handler and pushes the minimal diff of the holes that changed.
async fn session(sock: Socket, render_page: () -> Html, on_event: (string) -> void): bool {
    page = render_page()
    v = view()
    mut i = 0
    for c in page.holes {
        v.expose("h${i}", c)
        i = i + 1
    }
    sock.send(v.snapshot())
    mut going = true
    while going {
        msg = sock.recv().await
        if msg == none {
            going = false
        } else {
            evt = json.parse(msg ?? "{}")
            kind = evt["type"]
            if kind == "event" {
                name = evt["name"]
                on_event("${name}")
            }
            patch = v.diff() ?? ""
            if patch != "" {
                sock.send(patch)
            }
        }
    }
    return true
}

// Handle one request: the websocket upgrade (the diff-push session), the bundled client shim, or
// the server-rendered page. An app's `fn fetch(req)` delegates here, so it runs under `noeta serve`
// like any `std.http.server` app. `render_page` produces the reactive page (an `@html` value);
// `on_event` handles a client event by name (a `data-live-click="name"`).
pub fn handle(
    req: Request,
    title: string,
    render_page: () -> Html,
    on_event: (string) -> void,
): Response {
    if req.path() == "/ws" {
        return server.websocket(fn(sock) => session(sock, render_page, on_event))
    }
    if req.path() == "/live.js" {
        return server.response(200, server.liveview_js(), {"content-type": "application/javascript"})
    }
    return server.response(200, document(title, render_page()), {"content-type": "text/html"})
}
