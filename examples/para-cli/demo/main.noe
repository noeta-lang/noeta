// A multi-command CLI built on `para.cli`. The whole spec is the three function signatures below —
// the framework reads them by reflection and derives argv parsing, coercion, dispatch, and `--help`.
//
//   noeta run main.noe -- add 2 3        # exits 5
//   noeta run main.noe -- greet Ada -l    # prints HELLO Ada, exits 0
//   noeta run main.noe -- --help          # top-level help
//
// The tests exploit that a command's `int` return becomes the exit code, so the arithmetic commands
// are self-verifying with no output to capture: `dispatch(["add","2","3"])` is literally `2 + 3`.
use para.cli.{Command, Arg, run, dispatch}
use std.io
use std.os
use std.env

#[Command(about: "Add two integers")]
fn add(a: int, b: int): int {
    return a + b
}

#[Command(about: "Greet someone")]
fn greet(name: string, #[Arg(short: "l", help: "shout the greeting")] loud: bool = false): int {
    io.outln(if loud then "HELLO ${name}" else "hello ${name}")
    return 0
}

// Exercises float coercion: a bad float token is a usage error (exit 2); a good one binds and the
// command returns 0.
#[Command(about: "Report a rectangle's area (rounded down)")]
fn area(w: float, h: float): int {
    io.outln("area ~= ${w} x ${h}")
    return 0
}

// F1 — env-var fallback. `port` is sourced from argv first, else from `$PARA_CLI_PORT` when set,
// else its default. The command returns the resolved port as its exit code, so a test can see which
// source won without capturing any output.
#[Command(about: "Bind a server port")]
fn serve(#[Arg(env: "PARA_CLI_PORT", help: "port to bind")] port: int = 8080): int {
    io.outln("serving on ${port}")
    return port
}

// F3 — nested subcommands. `#[Command(name: "...")]` gives an explicit, possibly multi-token command
// path; selection matches the LONGEST token-prefix of argv, so `remote add` wins over a bare
// `remote`. The `remote` group has a root command; the `config` group deliberately has none, so a
// bare `config` is a partial path (a helpful selection error, exit 2).
#[Command(about: "List remotes", name: "remote")]
fn remote_list(): int {
    io.outln("(no remotes)")
    return 0
}

#[Command(about: "Add a remote", name: "remote add")]
fn remote_add(name: string, url: string): int {
    io.outln("added ${name} -> ${url}")
    return 0
}

#[Command(about: "Remove a remote", name: "remote remove")]
fn remote_remove(name: string): int {
    io.outln("removed ${name}")
    return 0
}

#[Command(about: "Set a config value", name: "config set")]
fn config_set(key: string, value: string): int {
    io.outln("${key}=${value}")
    return 0
}

#[Command(about: "Get a config value", name: "config get")]
fn config_get(key: string): int {
    io.outln(key)
    return 0
}

// Real entry point: parse the actual argv, dispatch, and make the command's return the process exit
// code. `noeta test` does not execute top-level statements, so this line runs only under `noeta run`
// and never interferes with the `@test` blocks below.
os.exit(run())

@test {
    // Positional binding + int coercion: two bare tokens fill `a`, `b`; the sum is the exit code.
    fn positional_and_int_coercion(): void {
        assert(dispatch(["add", "2", "3"]) == 5)
    }

    // Named binding in both spellings: `--a=10` and `--b 4`.
    fn named_long_forms(): void {
        assert(dispatch(["add", "--a=10", "--b", "4"]) == 14)
    }

    // Named can be given out of declaration order.
    fn named_out_of_order(): void {
        assert(dispatch(["add", "--b", "40", "--a", "2"]) == 42)
    }

    // A bool flag via its short spelling (`#[Arg(short: "l")]`), present -> true; greet returns 0.
    fn bool_short_flag(): void {
        assert(dispatch(["greet", "Ada", "-l"]) == 0)
    }

    // A bool flag via its long spelling (defaults to the parameter name).
    fn bool_long_flag(): void {
        assert(dispatch(["greet", "Ada", "--loud"]) == 0)
    }

    // `--no-<flag>` negates a bool.
    fn bool_negation(): void {
        assert(dispatch(["greet", "Ada", "--no-loud"]) == 0)
    }

    // `--flag=false` explicit bool value.
    fn bool_explicit_value(): void {
        assert(dispatch(["greet", "Ada", "--loud=false"]) == 0)
    }

    // A missing required argument is a usage error (exit 2), NOT a runtime error.
    fn missing_required_is_usage_error(): void {
        assert(dispatch(["add", "2"]) == 2)
    }

    // An unknown subcommand is a usage error (exit 2).
    fn unknown_subcommand(): void {
        assert(dispatch(["nope"]) == 2)
    }

    // A token that will not coerce to the declared type is a usage error (exit 2).
    fn bad_int_is_error(): void {
        assert(dispatch(["add", "x", "3"]) == 2)
    }

    // Float coercion: good tokens bind and the command runs (0); a bad float is a usage error (2).
    fn float_coercion_ok(): void {
        assert(dispatch(["area", "2.5", "4.0"]) == 0)
    }
    fn float_coercion_bad(): void {
        assert(dispatch(["area", "wide", "4.0"]) == 2)
    }

    // An unknown option is a usage error (exit 2).
    fn unknown_option(): void {
        assert(dispatch(["add", "2", "3", "--zzz"]) == 2)
    }

    // Too many positionals is a usage error (exit 2).
    fn too_many_positionals(): void {
        assert(dispatch(["add", "1", "2", "3"]) == 2)
    }

    // Top-level `--help` is a clean exit (0).
    fn top_help_is_clean_exit(): void {
        assert(dispatch(["--help"]) == 0)
    }

    // Empty argv in multi-command mode prints top-level help (0).
    fn empty_argv_is_help(): void {
        assert(dispatch([]) == 0)
    }

    // Per-command `--help` is a clean exit (0).
    fn command_help_is_clean_exit(): void {
        assert(dispatch(["greet", "--help"]) == 0)
    }

    // An omitted optional parameter is left off the argument list so the callee's default fills it.
    fn optional_defaulted_omitted(): void {
        assert(dispatch(["greet", "Ada"]) == 0)
    }

    // The `--` terminator forces the rest to be positionals: here `-l` becomes greet's `name`.
    fn double_dash_terminator(): void {
        assert(dispatch(["greet", "--", "-l"]) == 0)
    }

    // ---- F1: env-var fallback ------------------------------------------------
    // Each test's environment is isolated, so a var set in one is unset in the others.

    // No argv value: the `#[Arg(env: "PARA_CLI_PORT")]` fallback supplies the port. `serve` returns
    // the resolved port as its exit code, so this asserts the env value (70) actually bound.
    fn env_fallback_used(): void {
        env.set("PARA_CLI_PORT", "70")
        assert(dispatch(["serve"]) == 70)
    }

    // An explicit argv value outranks the env fallback: `--port 55` wins over `$PARA_CLI_PORT`.
    fn env_overridden_by_argv(): void {
        env.set("PARA_CLI_PORT", "70")
        assert(dispatch(["serve", "--port", "55"]) == 55)
    }

    // Env unset and no argv value: the parameter's own default (8080) fills in.
    fn env_absent_uses_default(): void {
        assert(dispatch(["serve"]) == 8080)
    }

    // ---- F2: colored help ----------------------------------------------------
    // Under `noeta test` stdout is not a terminal (sandbox `is_tty()` is false), so help is emitted
    // plain and color cannot be observed here; these assert the help paths still run cleanly (0).
    // The tty path is exercised by eye via `noeta run demo/main.noe -- --help` in a real terminal.
    fn top_help_plain_is_clean(): void {
        assert(dispatch(["--help"]) == 0)
    }
    fn command_help_plain_is_clean(): void {
        assert(dispatch(["serve", "--help"]) == 0)
    }

    // ---- F3: nested subcommands ---------------------------------------------

    // Longest token-prefix wins: `remote add` (2 tokens) is selected over the bare `remote`.
    fn nested_longest_prefix(): void {
        assert(dispatch(["remote", "add", "origin", "http://x"]) == 0)
    }
    fn nested_remove(): void {
        assert(dispatch(["remote", "remove", "origin"]) == 0)
    }

    // The bare group root is a valid one-token command when it exists.
    fn nested_group_root(): void {
        assert(dispatch(["remote"]) == 0)
    }

    // A group with no root command: a bare `config` is an incomplete path -> selection error (2).
    fn nested_partial_path_errors(): void {
        assert(dispatch(["config"]) == 2)
    }

    // A fully-qualified nested command binds its own arguments.
    fn nested_config_set(): void {
        assert(dispatch(["config", "set", "key", "val"]) == 0)
    }

    // A first token that begins no command name at all is still a plain unknown-command error (2).
    fn nested_unknown_first_token(): void {
        assert(dispatch(["bogus", "x"]) == 2)
    }

    // ---- F4: shell completions ----------------------------------------------
    // `--completions <shell>` prints a script and exits 0; an unknown or missing shell is a usage
    // error (2). It is a framework flag, so it never collides with a user command name.
    fn completions_bash(): void {
        assert(dispatch(["--completions", "bash"]) == 0)
    }
    fn completions_zsh(): void {
        assert(dispatch(["--completions", "zsh"]) == 0)
    }
    fn completions_fish(): void {
        assert(dispatch(["--completions", "fish"]) == 0)
    }
    fn completions_bad_shell(): void {
        assert(dispatch(["--completions", "tcsh"]) == 2)
    }
    fn completions_missing_shell(): void {
        assert(dispatch(["--completions"]) == 2)
    }
}
