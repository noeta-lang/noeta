// Single-command mode: a program with exactly one `#[Command]` has no subcommand token — every argv
// token is that command's argument. `para.cli` detects the arity and dispatches straight to it.
use para.cli.{Command, Arg, run, dispatch}
use std.io
use std.os

#[Command(about: "Print a message a number of times")]
fn say(msg: string, #[Arg(short: "n", help: "how many times")] times: int = 1): int {
    mut i = 0
    while i < times {
        io.outln(msg)
        i = i + 1
    }
    return 0
}

// Real entry: dispatch the actual argv and exit with the command's code. `noeta test` skips
// top-level statements, so this runs only under `noeta run`.
os.exit(run())

@test {
    // No subcommand token: the first bare token is the command's own first positional.
    fn single_positional(): void {
        assert(dispatch(["hello"]) == 0)
    }

    // Named binding in single-command mode.
    fn single_named_long(): void {
        assert(dispatch(["hello", "--times=3"]) == 0)
    }

    // The short spelling works in single-command mode too.
    fn single_short(): void {
        assert(dispatch(["hello", "-n", "2"]) == 0)
    }

    // A missing required argument is still a usage error (exit 2).
    fn single_missing_required(): void {
        assert(dispatch(["--times", "2"]) == 2)
    }

    // A bad coercion is still a usage error (exit 2).
    fn single_bad_int(): void {
        assert(dispatch(["hi", "--times", "x"]) == 2)
    }

    // `--help` prints usage and exits cleanly (0).
    fn single_help(): void {
        assert(dispatch(["--help"]) == 0)
    }
}
